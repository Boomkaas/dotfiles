#!/usr/bin/env bash
# ==============================================================================
# share - Terminal Share & Network Connection Manager (CLI & fzf TUI)
# Manage LogMeIn Hamachi VPN, Samba folder sharing, and CIFS mounts via terminal.
# All administrative actions run with sudo for reliable privilege elevation.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

# ------------------------------------------------------------------------------
# Privilege Elevation & Daemon Permission Helpers
# ------------------------------------------------------------------------------

ensure_sudo() {
    if ! sudo -n true 2>/dev/null; then
        echo -e "${YELLOW}${BOLD}[sudo]${RESET} Privilege required for network/service operations."
        if [ -c /dev/tty ]; then
            sudo -v < /dev/tty || return 1
        else
            sudo -v || return 1
        fi
    fi
    return 0
}

ensure_hamachi_ipc_user() {
    local cfg="/var/lib/logmein-hamachi/h2-engine-override.cfg"
    if [ ! -f "$cfg" ] || ! grep -q "Ipc.User.*peng" "$cfg" 2>/dev/null; then
        echo -e "${YELLOW}Configuring Hamachi IPC permissions for user 'peng'...${RESET}"
        ensure_sudo || return 1
        sudo mkdir -p /var/lib/logmein-hamachi
        echo "Ipc.User peng" | sudo tee "$cfg" >/dev/null
        sudo chmod 0644 "$cfg"
        echo -e "${YELLOW}Restarting LogMeIn Hamachi daemon to apply permissions...${RESET}"
        sudo systemctl restart logmein-hamachi
        sleep 1.5
        echo -e "${GREEN}✓ Hamachi IPC permissions granted to user 'peng'.${RESET}"
    fi
    return 0
}

# ------------------------------------------------------------------------------
# State Getters
# ------------------------------------------------------------------------------

get_hamachi_svc() {
    local st
    st=$(systemctl is-active logmein-hamachi 2>/dev/null) || st="inactive"
    echo "$st"
}

get_hamachi_ip() {
    ip -4 addr show dev ham0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1 || echo ""
}

get_hamachi_nick() {
    grep -oP '^Nickname\s+\K.*' /var/lib/logmein-hamachi/h2-engine.ini 2>/dev/null || echo "peng"
}

get_hamachi_net() {
    grep -oP '^NetState\s+\K[^,]+' /var/lib/logmein-hamachi/h2-engine.ini 2>/dev/null || echo ""
}

get_samba_svc() {
    local st
    st=$(systemctl is-active samba-smbd 2>/dev/null) || st="inactive"
    echo "$st"
}

get_samba_clients() {
    ss -tnH '( sport = :445 or dport = :445 )' 2>/dev/null | wc -l || echo "0"
}

get_cifs_mount() {
    findmnt -t cifs -o TARGET,SOURCE --noheadings 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Preview Function (for fzf side panel)
# ------------------------------------------------------------------------------

cmd_preview() {
    local target="${1:-}"
    local ham_svc ham_ip smb_svc smb_clients mounts
    ham_svc=$(get_hamachi_svc)
    ham_ip=$(get_hamachi_ip)
    smb_svc=$(get_samba_svc)
    smb_clients=$(get_samba_clients)
    mounts=$(get_cifs_mount)

    case "$target" in
        hamachi*|vpn)
            echo -e "${BOLD}${CYAN}=== LogMeIn Hamachi VPN ===${RESET}"
            echo -e "  ${BOLD}Service:${RESET}     $([ "$ham_svc" = "active" ] && echo -e "${GREEN}Active (Running)${RESET}" || echo -e "${RED}Inactive (Stopped)${RESET}")"
            echo -e "  ${BOLD}Interface:${RESET}   ham0"
            echo -e "  ${BOLD}Virtual IP:${RESET}  ${CYAN}${ham_ip:-(no IP assigned)}${RESET}"
            local hnick hnet
            hnick=$(get_hamachi_nick)
            hnet=$(get_hamachi_net)
            [ -n "$hnick" ] && echo -e "  ${BOLD}Nickname:${RESET}    $hnick"
            [ -n "$hnet" ] && echo -e "  ${BOLD}Network:${RESET}     $hnet"
            echo ""
            echo -e "  ${BOLD}Quick Actions:${RESET}"
            echo -e "   • Login / Connect:  ${DIM}sudo hamachi login${RESET}"
            echo -e "   • Logout:           ${DIM}sudo hamachi logout${RESET}"
            echo -e "   • Status & Peers:   ${DIM}sudo hamachi${RESET}"
            echo -e "   • Service toggle:   ${DIM}sudo systemctl start|stop logmein-hamachi${RESET}"
            echo ""
            if [ "$ham_svc" = "active" ]; then
                echo -e "${BOLD}Daemon Status:${RESET}"
                local daemon_out=""
                if [ -f /var/lib/logmein-hamachi/h2-engine-override.cfg ] && grep -q "Ipc.User.*peng" /var/lib/logmein-hamachi/h2-engine-override.cfg 2>/dev/null; then
                    daemon_out=$(hamachi 2>&1 | head -n 8) || true
                elif sudo -n true 2>/dev/null; then
                    daemon_out=$(sudo -n hamachi 2>&1 | head -n 8) || true
                fi

                if [ -n "$daemon_out" ] && ! echo "$daemon_out" | grep -qi "permission to control"; then
                    echo "$daemon_out" | sed 's/^/   /'
                elif [ -n "$ham_ip" ]; then
                    echo -e "   Status:   ${GREEN}Online (${ham_ip})${RESET}"
                    echo -e "   ${DIM}(Select 'Show Hamachi Status & Peers' to view full peer list)${RESET}"
                else
                    echo -e "   Status:   ${YELLOW}Daemon running${RESET}"
                    echo -e "   ${DIM}(Select 'Log in to Hamachi' to authenticate & connect)${RESET}"
                fi
            fi
            ;;
        samba_shared|shared_share)
            echo -e "${BOLD}${CYAN}=== Samba Share: [Shared] ===${RESET}"
            echo -e "  ${BOLD}Directory:${RESET}   ${BOLD}/home/peng/Shared${RESET}"
            echo -e "  ${BOLD}Samba Daemon:${RESET}$([ "$smb_svc" = "active" ] && echo -e "${GREEN}Active (Sharing)${RESET}" || echo -e "${RED}Stopped${RESET}")"
            echo -e "  ${BOLD}Valid Users:${RESET}  peng (password required)"
            echo -e "  ${BOLD}Active Clients:${RESET}$smb_clients"
            echo ""
            echo -e "${BOLD}Network Paths:${RESET}"
            echo -e "  ${BOLD}Windows:${RESET}     ${GREEN}\\\\\\\\${ham_ip:-25.6.89.170}\\\\Shared${RESET}"
            echo -e "  ${BOLD}Linux / Mac:${RESET} ${GREEN}smb://${ham_ip:-25.6.89.170}/Shared${RESET}"
            echo ""
            echo -e "${BOLD}Mount Command (Linux):${RESET}"
            echo -e "  ${DIM}sudo mount -t cifs //${ham_ip:-25.6.89.170}/Shared /mnt -o username=peng,uid=\$(id -u),gid=\$(id -g)${RESET}"
            ;;
        samba*|sharing)
            echo -e "${BOLD}${CYAN}=== Samba File Sharing ===${RESET}"
            echo -e "  ${BOLD}Service:${RESET}     $([ "$smb_svc" = "active" ] && echo -e "${GREEN}Active (Running)${RESET}" || echo -e "${RED}Inactive (Stopped)${RESET}")"
            echo -e "  ${BOLD}Active Clients:${RESET}$smb_clients"
            echo -e "  ${BOLD}Shares:${RESET}      Shared (~/Shared)"
            echo -e "  ${BOLD}Firewall:${RESET}    Ports 139, 445 (TCP) & 137, 138 (UDP) open"
            echo -e "  ${BOLD}Trusted IF:${RESET}  ham0, hamachi0"
            echo ""
            echo -e "${BOLD}Active Connections (ss:445):${RESET}"
            ss -tnH '( sport = :445 or dport = :445 )' 2>/dev/null | head -n 6 | sed 's/^/   /' || echo "   (None)"
            ;;
        cifs*|mount*)
            echo -e "${BOLD}${CYAN}=== Remote CIFS Mounts ===${RESET}"
            if [ -n "$mounts" ]; then
                echo -e "  ${BOLD}Active Mount(s):${RESET}"
                echo -e "${GREEN}$mounts${RESET}" | sed 's/^/   /'
                echo ""
                echo -e "  ${BOLD}Unmount Command:${RESET}"
                echo -e "   ${DIM}sudo umount /mnt${RESET}"
            else
                echo -e "  ${DIM}No CIFS shares currently mounted.${RESET}"
                echo ""
                echo -e "  ${BOLD}Mount Command Syntax:${RESET}"
                echo -e "   ${DIM}sudo mount -t cifs //IP/Share /mnt -o username=peng,uid=\$(id -u),gid=\$(id -g)${RESET}"
            fi
            ;;
        *)
            echo -e "${BOLD}${CYAN}=== Share & Network Overview ===${RESET}"
            echo -e "  ${BOLD}Hamachi VPN:${RESET}   $([ "$ham_svc" = "active" ] && echo -e "${GREEN}Active ($ham_ip)${RESET}" || echo -e "${RED}Stopped${RESET}")"
            echo -e "  ${BOLD}Samba Sharing:${RESET} $([ "$smb_svc" = "active" ] && echo -e "${GREEN}Active ($smb_clients clients)${RESET}" || echo -e "${RED}Stopped${RESET}")"
            echo -e "  ${BOLD}CIFS Mounts:${RESET}   ${mounts:-None}"
            echo ""
            echo -e "Select an item and press ${BOLD}[Enter]${RESET} to perform actions."
            ;;
    esac
}

# ------------------------------------------------------------------------------
# CLI Commands
# ------------------------------------------------------------------------------

cmd_status() {
    local ham_svc ham_ip smb_svc smb_clients mounts
    ham_svc=$(get_hamachi_svc)
    ham_ip=$(get_hamachi_ip)
    smb_svc=$(get_samba_svc)
    smb_clients=$(get_samba_clients)
    mounts=$(get_cifs_mount)

    echo -e "${BOLD}${CYAN}=== Connection & Share Status ===${RESET}"
    echo -e "  ${BOLD}Hamachi Service:${RESET} $([ "$ham_svc" = "active" ] && echo -e "${GREEN}Active (ON)${RESET}" || echo -e "${RED}Inactive (OFF)${RESET}")"
    echo -e "  ${BOLD}Hamachi IP:${RESET}      ${CYAN}${ham_ip:-(none)}${RESET} (interface: ham0)"
    echo -e "  ${BOLD}Samba Service:${RESET}   $([ "$smb_svc" = "active" ] && echo -e "${GREEN}Active (ON)${RESET}" || echo -e "${RED}Inactive (OFF)${RESET}")"
    echo -e "  ${BOLD}Active Clients:${RESET}  $smb_clients connection(s)"
    echo -e "  ${BOLD}Exported Shares:${RESET} Shared (/home/peng/Shared)"
    echo -e "  ${BOLD}Remote Mounts:${RESET}   ${mounts:-None}"
}

cmd_hamachi() {
    local action="${1:-status}"
    shift || true
    case "$action" in
        on|start)
            echo -e "${YELLOW}Starting LogMeIn Hamachi daemon...${RESET}"
            ensure_sudo || return 1
            ensure_hamachi_ipc_user || true
            sudo systemctl start logmein-hamachi
            sleep 1
            echo -e "${GREEN}Hamachi daemon started.${RESET}"
            ;;
        off|stop)
            echo -e "${YELLOW}Stopping LogMeIn Hamachi daemon...${RESET}"
            ensure_sudo || return 1
            sudo hamachi logout 2>/dev/null || true
            sudo systemctl stop logmein-hamachi
            sleep 1
            echo -e "${GREEN}Hamachi daemon stopped.${RESET}"
            ;;
        restart)
            echo -e "${YELLOW}Restarting LogMeIn Hamachi daemon...${RESET}"
            ensure_sudo || return 1
            ensure_hamachi_ipc_user || true
            sudo systemctl restart logmein-hamachi
            sleep 1.5
            echo -e "${GREEN}Hamachi daemon restarted.${RESET}"
            ;;
        login|connect)
            ensure_sudo || return 1
            ensure_hamachi_ipc_user || true
            if [ "$(get_hamachi_svc)" != "active" ]; then
                echo -e "${YELLOW}Starting Hamachi daemon first...${RESET}"
                sudo systemctl start logmein-hamachi
                sleep 1.5
            fi
            echo -e "${YELLOW}Logging into Hamachi network (sudo)...${RESET}"
            sudo hamachi login
            sleep 1
            local new_ip
            new_ip=$(get_hamachi_ip)
            if [ -n "$new_ip" ]; then
                echo -e "${GREEN}✓ Logged in successfully! IP: ${BOLD}${CYAN}${new_ip}${RESET}"
            else
                echo -e "${YELLOW}Login dispatched. Hamachi status:${RESET}"
                sudo hamachi 2>&1 || true
            fi
            ;;
        logout|disconnect)
            echo -e "${YELLOW}Logging out of Hamachi (sudo)...${RESET}"
            ensure_sudo || return 1
            sudo hamachi logout
            echo -e "${GREEN}Logged out.${RESET}"
            ;;
        fix-ipc|permissions)
            ensure_hamachi_ipc_user
            ;;
        status|info)
            ensure_sudo || return 1
            echo -e "${BOLD}${CYAN}=== Hamachi Status ===${RESET}"
            sudo hamachi
            ;;
        list|peers)
            ensure_sudo || return 1
            echo -e "${BOLD}${CYAN}=== Hamachi Peers & Networks ===${RESET}"
            sudo hamachi list
            ;;
        join)
            ensure_sudo || return 1
            local net_id="${1:-}"
            local net_pwd="${2:-}"
            if [ -z "$net_id" ]; then
                read -rp "Hamachi Network ID: " net_id < /dev/tty || net_id=""
            fi
            if [ -z "$net_pwd" ]; then
                read -rsp "Hamachi Network Password (optional, press Enter if none): " net_pwd < /dev/tty || net_pwd=""
                echo ""
            fi
            if [ -n "$net_id" ]; then
                echo -e "${YELLOW}Joining network $net_id...${RESET}"
                if [ -n "$net_pwd" ]; then
                    sudo hamachi join "$net_id" "$net_pwd"
                else
                    sudo hamachi join "$net_id"
                fi
            else
                echo -e "${RED}Network ID cannot be empty.${RESET}"
            fi
            ;;
        leave)
            ensure_sudo || return 1
            local net_id="${1:-}"
            if [ -z "$net_id" ]; then
                read -rp "Hamachi Network ID to leave: " net_id < /dev/tty || net_id=""
            fi
            if [ -n "$net_id" ]; then
                echo -e "${YELLOW}Leaving network $net_id...${RESET}"
                sudo hamachi leave "$net_id"
            fi
            ;;
        nick|set-nick)
            ensure_sudo || return 1
            local nick="${1:-}"
            if [ -z "$nick" ]; then
                read -rp "New Hamachi Nickname: " nick < /dev/tty || nick=""
            fi
            if [ -n "$nick" ]; then
                echo -e "${YELLOW}Setting Hamachi nickname to '$nick'...${RESET}"
                sudo hamachi set-nick "$nick"
            fi
            ;;
        attach)
            ensure_sudo || return 1
            local email="${1:-}"
            if [ -z "$email" ]; then
                read -rp "LogMeIn Account Email: " email < /dev/tty || email=""
            fi
            if [ -n "$email" ]; then
                echo -e "${YELLOW}Attaching to LogMeIn account $email...${RESET}"
                sudo hamachi attach "$email"
            fi
            ;;
        *)
            echo -e "${RED}Usage: share hamachi [on|off|restart|login|logout|status|list|join|leave|nick|attach|fix-ipc]${RESET}"
            ;;
    esac
}

cmd_samba() {
    local action="${1:-status}"
    case "$action" in
        on|start)
            echo -e "${YELLOW}Starting Samba file sharing...${RESET}"
            ensure_sudo || return 1
            sudo systemctl start samba-smbd samba-wsdd
            sleep 1
            echo -e "${GREEN}Samba started.${RESET}"
            ;;
        off|stop)
            echo -e "${YELLOW}Stopping Samba file sharing...${RESET}"
            ensure_sudo || return 1
            sudo systemctl stop samba-smbd samba-wsdd
            sleep 1
            echo -e "${GREEN}Samba stopped.${RESET}"
            ;;
        restart|reload)
            echo -e "${YELLOW}Restarting Samba...${RESET}"
            ensure_sudo || return 1
            sudo systemctl restart samba-smbd samba-wsdd
            sleep 1
            echo -e "${GREEN}Samba restarted.${RESET}"
            ;;
        status|info)
            ensure_sudo || return 1
            echo -e "${BOLD}${CYAN}=== Samba Service Status ===${RESET}"
            sudo systemctl status samba-smbd --no-pager
            ;;
        passwd|password)
            ensure_sudo || return 1
            echo -e "${YELLOW}Updating Samba password for user 'peng':${RESET}"
            sudo smbpasswd -a peng
            ;;
        *)
            echo -e "${RED}Usage: share samba [on|off|restart|passwd|status]${RESET}"
            ;;
    esac
}

cmd_mount() {
    local target_ip="${1:-}"
    local share_name="${2:-Shared}"
    local smb_user="${3:-peng}"

    if [ -z "$target_ip" ]; then
        target_ip=$(get_hamachi_ip)
        [ -z "$target_ip" ] && target_ip="25.6.89.170"
    fi

    ensure_sudo || return 1
    sudo mkdir -p /mnt
    echo -e "${CYAN}Mounting //${target_ip}/${share_name} to /mnt...${RESET}"
    sudo mount -t cifs "//${target_ip}/${share_name}" /mnt \
        -o "username=${smb_user},uid=$(id -u),gid=$(id -g)"
    echo -e "${GREEN}Mounted successfully to /mnt.${RESET}"
}

cmd_umount() {
    ensure_sudo || return 1
    echo -e "${YELLOW}Unmounting /mnt...${RESET}"
    if sudo umount /mnt 2>/dev/null || sudo umount -l /mnt 2>/dev/null; then
        echo -e "${GREEN}/mnt unmounted.${RESET}"
    else
        echo -e "${YELLOW}/mnt is not mounted.${RESET}"
    fi
}

cmd_help() {
    cat << EOF
${BOLD}share${RESET} - Terminal Share & Network Connection Manager (Hamachi & Samba)

${BOLD}USAGE:${RESET}
    share                                       Launch interactive fzf menu
    share status | s                            Display current connection & share status
    share hamachi [on|off|restart|login|logout|status|list|join|nick|fix-ipc]  Manage Hamachi VPN (sudo)
    share samba [on|off|restart|passwd|status]  Manage Samba folder sharing (sudo)
    share mount [IP] [share] [user]             Mount remote CIFS share to /mnt (sudo)
    share umount                                Unmount /mnt (sudo)
    share preview <target>                      Internal preview generator for fzf
    share help | -h                             Show this help message

EOF
}

# ------------------------------------------------------------------------------
# Interactive TUI Menu (fzf)
# ------------------------------------------------------------------------------

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        cmd_status
        echo ""
        cmd_help
        return 0
    fi

    local self_bin="$0"
    [ -x "$self_bin" ] || self_bin="share"

    while true; do
        clear 2>/dev/null || true
        local ham_svc ham_ip smb_svc smb_clients mounts
        ham_svc=$(get_hamachi_svc)
        ham_ip=$(get_hamachi_ip)
        smb_svc=$(get_samba_svc)
        smb_clients=$(get_samba_clients)
        mounts=$(get_cifs_mount)

        local ham_label="OFF"
        if [ "$ham_svc" = "active" ]; then
            if [ -n "$ham_ip" ]; then
                ham_label="ONLINE (${ham_ip})"
            else
                ham_label="LOGGED OUT"
            fi
        fi

        local smb_label="OFF"
        [ "$smb_svc" = "active" ] && smb_label="ACTIVE (${smb_clients} clients)"

        local mnt_label="None"
        [ -n "$mounts" ] && mnt_label="Active"

        local header_info="Hamachi: $ham_label | Samba: $smb_label | Mounts: $mnt_label"

        local menu=()

        # Section: Hamachi VPN
        if [ "$ham_svc" = "active" ]; then
            if [ -n "$ham_ip" ]; then
                menu+=("$(printf "✓ 󰌘  Hamachi: ONLINE (%s)\thamachi_info" "$ham_ip")")
            else
                menu+=("$(printf "○ 󰌙  Hamachi: LOGGED OUT (Daemon running)\thamachi_info")")
            fi
            menu+=("$(printf "  󰒍  Log in to Hamachi\thamachi_login")")
            menu+=("$(printf "  󰒎  Log Out of Hamachi Network\thamachi_logout")")
            menu+=("$(printf "  󰌘  Join a Hamachi Network\thamachi_join")")
            menu+=("$(printf "  󰒍  Set Hamachi Nickname\thamachi_nick")")
            menu+=("$(printf "  󰑓  Restart Hamachi Daemon\thamachi_restart")")
            menu+=("$(printf "  󰌙  Turn Hamachi OFF (Stop Service)\thamachi_off")")
        else
            menu+=("$(printf "○ 󰌙  Hamachi: STOPPED (Service inactive)\thamachi_info")")
            menu+=("$(printf "  󰒍  Log in to Hamachi (Start & Connect)\thamachi_login")")
            menu+=("$(printf "  󰌘  Turn Hamachi ON (Start Service)\thamachi_on")")
        fi

        # Check if IPC permission override is present
        if [ ! -f /var/lib/logmein-hamachi/h2-engine-override.cfg ] || ! grep -q "Ipc.User.*peng" /var/lib/logmein-hamachi/h2-engine-override.cfg 2>/dev/null; then
            menu+=("$(printf "  󰌆  Fix Daemon Permissions (grant user access)\thamachi_fix_ipc")")
        fi

        menu+=("$(printf "  󰍹  Show Hamachi Status & Peers\thamachi_info")")
        menu+=("$(printf "    Launch Haguichi GUI\thamachi_haguichi")")

        menu+=("$(printf "─────────────────────────────────────────\tsep1")")

        # Section: Samba Sharing
        if [ "$smb_svc" = "active" ]; then
            menu+=("$(printf "✓ 󰉋  Samba Sharing: ACTIVE (%s clients)\tsamba_info" "$smb_clients")")
            menu+=("$(printf "  📂  Share: Shared (~/Shared)\tsamba_shared")")
            menu+=("$(printf "  󰉌  Stop Samba Sharing (Disconnect all)\tsamba_stop")")
            menu+=("$(printf "  󰑓  Restart Samba Service\tsamba_restart")")
        else
            menu+=("$(printf "○ 󰉌  Samba Sharing: STOPPED\tsamba_info")")
            menu+=("$(printf "  󰉋  Start Samba Sharing\tsamba_start")")
            menu+=("$(printf "  📂  Share: Shared (~/Shared)\tsamba_shared")")
        fi
        menu+=("$(printf "  󰌆  Set / Change Samba Password (peng)\tsamba_passwd")")
        menu+=("$(printf "  󰝰  Open ~/Shared in File Manager\tsamba_open")")

        menu+=("$(printf "─────────────────────────────────────────\tsep2")")

        # Section: Remote Mounts
        if [ -n "$mounts" ]; then
            menu+=("$(printf "✓ 💾  Remote Mounts: ACTIVE (/mnt)\tcifs_mounts")")
            menu+=("$(printf "  󰁦  Unmount /mnt\tcifs_umount")")
        else
            menu+=("$(printf "○ 💾  Mount Remote Share (to /mnt)\tcifs_mount")")
        fi

        local choice
        choice=$(printf "%s\n" "${menu[@]}" | fzf \
            --prompt="Share > " \
            --header="[$header_info] (Enter to select, Esc to exit)" \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:48%:wrap \
            --reverse \
            --height=65% \
            --border=rounded \
            --cycle) || break

        [ -z "$choice" ] && break

        local action_key
        action_key=$(echo "$choice" | cut -f2)

        case "$action_key" in
            hamachi_on)
                cmd_hamachi on
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_off)
                cmd_hamachi off
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_restart)
                cmd_hamachi restart
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_login)
                cmd_hamachi login
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_logout)
                cmd_hamachi logout
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_fix_ipc)
                clear 2>/dev/null || true
                ensure_hamachi_ipc_user
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_info)
                clear 2>/dev/null || true
                cmd_hamachi status
                echo ""
                cmd_hamachi list
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_join)
                clear 2>/dev/null || true
                cmd_hamachi join
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_nick)
                clear 2>/dev/null || true
                cmd_hamachi set-nick
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            hamachi_haguichi)
                if command -v haguichi >/dev/null 2>&1; then
                    ( haguichi >/dev/null 2>&1 & )
                    echo -e "${GREEN}Launched Haguichi GUI.${RESET}"
                else
                    echo -e "${RED}Haguichi is not installed. Run 'nixreb' to install it.${RESET}"
                fi
                sleep 0.8
                ;;
            samba_start)
                cmd_samba on
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            samba_stop)
                cmd_samba off
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            samba_restart)
                cmd_samba restart
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            samba_info)
                clear 2>/dev/null || true
                cmd_samba status
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            samba_passwd)
                cmd_samba passwd
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            samba_open)
                mkdir -p "$HOME/Shared"
                if command -v thunar >/dev/null 2>&1; then
                    ( thunar "$HOME/Shared" >/dev/null 2>&1 & )
                elif command -v xdg-open >/dev/null 2>&1; then
                    ( xdg-open "$HOME/Shared" >/dev/null 2>&1 & )
                fi
                sleep 0.5
                ;;
            samba_shared)
                local share_target="Shared"
                local win_path="\\\\${ham_ip:-25.6.89.170}\\${share_target}"
                local mac_path="smb://${ham_ip:-25.6.89.170}/${share_target}"

                local act
                act=$(printf "1. Copy Windows Path (%s)\n2. Copy Mac/Linux URL (%s)\n3. Open Local Folder in Thunar\n4. Restart Samba Service\n5. Cancel" "$win_path" "$mac_path" | fzf \
                    --prompt="Share [${share_target}] > " \
                    --reverse --height=35% --border=rounded) || true

                case "$act" in
                    *"Copy Windows Path"*)
                        if command -v wl-copy >/dev/null 2>&1; then
                            echo -n "$win_path" | wl-copy
                            echo -e "${GREEN}Copied $win_path to clipboard.${RESET}"
                        else
                            echo -e "Path: ${BOLD}$win_path${RESET}"
                        fi
                        sleep 1
                        ;;
                    *"Copy Mac/Linux URL"*)
                        if command -v wl-copy >/dev/null 2>&1; then
                            echo -n "$mac_path" | wl-copy
                            echo -e "${GREEN}Copied $mac_path to clipboard.${RESET}"
                        else
                            echo -e "Path: ${BOLD}$mac_path${RESET}"
                        fi
                        sleep 1
                        ;;
                    *"Open Local Folder"*)
                        local local_dir="$HOME/Shared"
                        mkdir -p "$local_dir"
                        ( thunar "$local_dir" >/dev/null 2>&1 & )
                        sleep 0.5
                        ;;
                    *"Restart Samba"*)
                        cmd_samba restart
                        echo -e "\n${DIM}Press enter to continue...${RESET}"
                        read -r < /dev/tty || read -r
                        ;;
                esac
                ;;
            cifs_mount)
                local default_ip="${ham_ip:-25.6.89.170}"
                echo -e "${BOLD}${CYAN}=== Mount Remote CIFS Share ===${RESET}"
                read -rp "Target Host IP [default: $default_ip]: " tip < /dev/tty || tip="$default_ip"
                tip="${tip:-$default_ip}"
                read -rp "Share Name [default: Shared]: " sname < /dev/tty || sname="Shared"
                sname="${sname:-Shared}"
                read -rp "Username [default: peng]: " uname < /dev/tty || uname="peng"
                uname="${uname:-peng}"

                cmd_mount "$tip" "$sname" "$uname"
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            cifs_umount)
                cmd_umount
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            cifs_mounts)
                clear 2>/dev/null || true
                echo -e "${BOLD}${CYAN}=== Remote CIFS Mounts ===${RESET}\n"
                get_cifs_mount
                echo -e "\n${DIM}Press enter to continue...${RESET}"
                read -r < /dev/tty || read -r
                ;;
            sep*)
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------

case "${1:-}" in
    status|s|info)
        cmd_status
        ;;
    hamachi)
        shift
        cmd_hamachi "$@"
        ;;
    samba)
        shift
        cmd_samba "$@"
        ;;
    mount)
        shift
        cmd_mount "$@"
        ;;
    umount|unmount)
        cmd_umount
        ;;
    preview)
        shift
        cmd_preview "$@"
        ;;
    help|-h|--help)
        cmd_help
        ;;
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            cmd_interactive
        else
            cmd_status
            echo ""
            cmd_help
        fi
        ;;
    *)
        cmd_help
        ;;
esac
