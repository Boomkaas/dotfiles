#!/usr/bin/env bash
# ==============================================================================
# tui-popup - High-Performance Modal Floating Launcher for Dotfiles TUI Tools
# Launches any TUI tool (s, setting, wifi, bluetooth, audio, clip, task, etc.)
# in a centered, floating Wayland modal window with instant toggle behavior.
# ==============================================================================

set -eo pipefail

export PATH="/run/wrappers/bin:$HOME/.local/bin:/run/current-system/sw/bin:$PATH"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"

TOOL="${1:-setting}"
shift || true

# Resolve canonical script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUI_DIR="$SCRIPT_DIR/tui"
[ -d "$TUI_DIR" ] || TUI_DIR="/home/peng/Code/Dotfiles/nixos/scripts/tui"

# Find tool executable
CMD_PATH=""
if [ -x "$TUI_DIR/$TOOL" ]; then
    CMD_PATH="$TUI_DIR/$TOOL"
elif [ -x "$HOME/.local/bin/$TOOL" ]; then
    CMD_PATH="$HOME/.local/bin/$TOOL"
elif command -v "$TOOL" >/dev/null 2>&1; then
    CMD_PATH="$(command -v "$TOOL")"
else
    # Fallback to master hub
    CMD_PATH="$TUI_DIR/s"
fi

STATE_FILE="/tmp/.tui_overlay_tool"
CURRENT_TOOL=""
[ -f "$STATE_FILE" ] && CURRENT_TOOL=$(cat "$STATE_FILE" 2>/dev/null || true)

# Find any active tui-overlay processes
get_overlay_pids() {
    local pids=()
    local raw_pids
    raw_pids=$(pgrep -x .kitty-wrapped 2>/dev/null || pgrep -x kitty 2>/dev/null || true)
    for p in $raw_pids; do
        if grep -q "tui-overlay" "/proc/$p/cmdline" 2>/dev/null; then
            pids+=("$p")
        fi
    done
    echo "${pids[@]}"
}

RUNNING_PIDS=$(get_overlay_pids)

if [ -n "$RUNNING_PIDS" ]; then
    # If the user requested the SAME tool, toggle it off
    if [ "$CURRENT_TOOL" = "$TOOL" ]; then
        for p in $RUNNING_PIDS; do
            kill "$p" 2>/dev/null || true
        done
        rm -f "$STATE_FILE"
        exit 0
    else
        # Different tool requested: terminate previous modal to switch
        for p in $RUNNING_PIDS; do
            kill "$p" 2>/dev/null || true
        done
        rm -f "$STATE_FILE"
    fi
fi

# Window dimensions: strictly 150x25 cells for optimal TUI layout
WIN_WIDTH="150c"
WIN_HEIGHT="25c"

echo "$TOOL" > "$STATE_FILE"

# Launch floating Kitty modal
nohup kitty \
    --class tui-overlay \
    --app-id tui-overlay \
    --title "Control Center - $TOOL" \
    -o initial_window_width="$WIN_WIDTH" \
    -o initial_window_height="$WIN_HEIGHT" \
    -o remember_window_size=no \
    -o confirm_os_window_close=0 \
    -o placement_strategy=center \
    -o hide_window_decorations=yes \
    "$CMD_PATH" "$@" >/dev/null 2>&1 &

KITTY_PID=$!
(wait "$KITTY_PID" 2>/dev/null; rm -f "$STATE_FILE" 2>/dev/null) &
disown -a 2>/dev/null || true
