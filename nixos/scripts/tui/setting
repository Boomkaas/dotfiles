            echo -e "${BOLD}${CYAN}=== Power Profile ===${RESET}"
            echo -e "  ${BOLD}Current Mode:${RESET} ${GREEN}${BOLD}$profile${RESET}"
            echo -e "  ${BOLD}Profiles:${RESET}     balanced, performance, power-saver"
            echo ""
            echo -e "${BOLD}Action:${RESET} Cycle to next power profile mode"
            ;;
        lock)
            echo -e "${BOLD}${CYAN}=== Lock Screen ===${RESET}"
            echo -e "  ${BOLD}Screen Locker:${RESET} hyprlock / lock.sh"
            echo ""
            echo -e "${BOLD}Action:${RESET} Lock the current session immediately"
            ;;
        power)
            echo -e "${BOLD}${CYAN}=== Power & Session Menu ===${RESET}"
            echo -e "  ${BOLD}Options:${RESET} Suspend, Hibernate, Reboot, Reboot to UEFI Firmware, Shutdown"
            echo ""
            echo -e "${BOLD}Action:${RESET} Open power control options"
            ;;
        process)
            echo -e "${BOLD}${CYAN}=== Task & Process Manager ===${RESET}"
            echo -e "  ${BOLD}Controller:${RESET}  task (Mango Wayland Window & Process Controller)"
            echo ""
            echo -e "${BOLD}Action:${RESET} Inspect windows, kill frozen apps, monitor RAM & CPU"
            ;;
        theme)
            echo -e "${BOLD}${CYAN}=== Themes, Wallpapers & Waybar ===${RESET}"
            echo -e "  ${BOLD}Tool:${RESET}        theme"
            echo ""
            echo -e "${BOLD}Action:${RESET} Switch wallpapers, accent colors, visualizer, Waybar"
            ;;
        config)
            echo -e "${BOLD}${CYAN}=== Open Config Files & Dotfiles ===${RESET}"
            echo -e "  ${BOLD}Tool:${RESET}        conf"
            echo ""
            echo -e "${BOLD}Action:${RESET} Interactive dotfiles selector with syntax preview"
            ;;
        warp)
            local warp
            warp=$(get_warp_status)
            echo -e "${BOLD}${CYAN}=== Cloudflare WARP VPN ===${RESET}"
            echo -e "  ${BOLD}Tunnel State:${RESET} $([ "$warp" = "ON" ] && echo -e "${GREEN}Connected${RESET}" || echo -e "${DIM}Disconnected${RESET}")"
            echo ""
            echo -e "${BOLD}Action:${RESET} Toggle Cloudflare WARP connection"
            ;;
        colorpicker)
            echo -e "${BOLD}${CYAN}=== Screen Color Picker ===${RESET}"
            echo -e "  ${BOLD}Tool:${RESET}         hyprpicker"
            echo ""
            echo -e "${BOLD}Action:${RESET} Pick hex color from screen and copy to clipboard"
