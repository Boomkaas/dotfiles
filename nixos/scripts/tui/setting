            echo -e "${BOLD}${CYAN}=== Clipboard History ===${RESET}"
            echo -e "  ${BOLD}Engine:${RESET}       cliphist + wl-clipboard"
            echo -e "  ${BOLD}History Cache:${RESET} Available"
            echo ""
            echo -e "${BOLD}Action:${RESET} Open interactive clipboard history (clip)"
            ;;
        dnd)
            local dnd
            dnd=$(get_dnd_status)
            echo -e "${BOLD}${CYAN}=== Do Not Disturb & Notifications ===${RESET}"
            echo -e "  ${BOLD}Mode:${RESET}         $([ "$dnd" = "ON" ] && echo -e "${YELLOW}Silent / Muted (ON)${RESET}" || echo -e "${GREEN}Normal Notifications (OFF)${RESET}")"
            echo ""
