# ------------------------------------------------------------------------------
# Interactive TUI Menu (fzf)
# ------------------------------------------------------------------------------

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        cmd_status
        return 0
    fi

    local self_bin="${BASH_SOURCE[0]}"

    while true; do
        clear
        local night idle warp dnd profile wifi_ssid bt_short b_pct bat_info vol_info
        night=$(get_night_status)
        idle=$(get_idle_status)
        warp=$(get_warp_status)
        dnd=$(get_dnd_status)
        profile=$(get_power_profile)
        b_pct=$(get_brightness_pct)
        bat_info=$(get_battery_info)
        vol_info=$(get_volume_info)
        wifi_ssid=$(get_active_wifi_ssid)
        bt_short=$(get_bluetooth_status_short)

        local header_info="Profile: $profile | Awake: $idle | Night: $night | DND: $dnd | Bat: $bat_info"

        local menu=()
        menu+=("󰖩  Wi-Fi & Network ($wifi_ssid)"$'\t'"wifi")
        menu+=("󰂯  Bluetooth Manager ($bt_short)"$'\t'"bluetooth")
        menu+=("  Audio & Volume Mixer ($vol_info)"$'\t'"audio")
        menu+=("󰃠  Display Brightness ($b_pct%)"$'\t'"brightness")
        menu+=("󰒲  Keep Screen Awake ($idle)"$'\t'"awake")
        menu+=("󰃝  Night Light / Eye Care ($night)"$'\t'"night")
        menu+=("󱐋  Power Profile ($profile)"$'\t'"powerprofile")
        menu+=("󰁹  Battery & Power Telemetry"$'\t'"battery")
        menu+=("󰂚  Do Not Disturb ($dnd)"$'\t'"dnd")
        menu+=("󰅌  Clipboard History"$'\t'"clipboard")
        menu+=("󰌾  Lock Screen"$'\t'"lock")
        menu+=("  Power & Session Controls"$'\t'"power")
        menu+=("󰍛  Task & Process Controller"$'\t'"process")
        menu+=("󰏘  Themes, Wallpapers & Waybar"$'\t'"theme")
        menu+=("󱁤  Open Config Files & Dotfiles"$'\t'"config")
        menu+=("󰖟  Cloudflare WARP VPN ($warp)"$'\t'"warp")
        menu+=("󰈊  Color Picker (Screen Eyedropper)"$'\t'"colorpicker")
        menu+=("󰋊  Disk & Storage Manager"$'\t'"disk")
        menu+=("󰚰  Clean System Garbage & Cache"$'\t'"clean")
        menu+=("󰀻  Desktop Application Launcher"$'\t'"app")
        menu+=("⚡  Open Master Tools Hub (s)"$'\t'"hub")

        local res key choice
        res=$(printf "%s\n" "${menu[@]}" | fzf \
            --expect=ctrl-r,ctrl-c \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:52%:wrap \
            --prompt="󰒓 Settings > " \
            --header="[$header_info] (Enter: Open | Ctrl-R: Refresh | Ctrl-C: Clear Notif | Esc: Exit)" \
            --reverse \
            --height=100% \
            --border=rounded \
            --cycle) || break

        [ -z "$res" ] && break
        key=$(echo "$res" | sed -n '1p')
        choice=$(echo "$res" | sed -n '2p')
        [ -z "$choice" ] && break

        if [ "$key" = "ctrl-r" ]; then
            rm -f "/tmp/.setting_power_profile"
            continue
        elif [ "$key" = "ctrl-c" ]; then
            if command -v swaync-client >/dev/null 2>&1; then
                swaync-client -C >/dev/null 2>&1 || true
                notify low notifications "SwayNC" "Cleared all notifications"
            fi
            continue
        fi

        local sel_arg
        sel_arg=$(echo "$choice" | cut -f2)

        case "$sel_arg" in
            wifi)
                if [ -x "$TUI_DIR/wifi" ]; then
                    "$TUI_DIR/wifi"
                elif [ -x "$HOME/.local/bin/wifi" ]; then
                    "$HOME/.local/bin/wifi"
                fi
                ;;
            bluetooth)
                if [ -x "$TUI_DIR/bluetooth" ]; then
                    "$TUI_DIR/bluetooth"
                elif [ -x "$HOME/.local/bin/bluetooth" ]; then
                    "$HOME/.local/bin/bluetooth"
                fi
                ;;
            audio)
                if [ -x "$TUI_DIR/audio" ]; then
                    "$TUI_DIR/audio"
                elif [ -x "$HOME/.local/bin/audio" ]; then
                    "$HOME/.local/bin/audio"
                fi
                ;;
            brightness)
                cmd_brightness_menu
                ;;
            battery)
                cmd_powerprofile_cycle
                ;;
            awake)
                if command -v awake >/dev/null 2>&1; then
                    awake toggle
                elif [ -x "$HOME/.local/bin/idle_inhibit.sh" ]; then
                    "$HOME/.local/bin/idle_inhibit.sh"
                fi
                sleep 0.2
                ;;
            night)
                cmd_nightlight_menu
                ;;
            clipboard)
                local clip_rc=1
                if [ -x "$TUI_DIR/clip" ]; then
                    "$TUI_DIR/clip"
                    clip_rc=$?
                elif [ -x "$HOME/.local/bin/clip" ]; then
                    "$HOME/.local/bin/clip"
                    clip_rc=$?
                fi
                # Automatically close modal window after copying an item
                [ "$clip_rc" -eq 0 ] && exit 0
                ;;
            dnd)
                cmd_dnd_toggle
                sleep 0.2
                ;;
            powerprofile)
                cmd_powerprofile_cycle
                sleep 0.2
                ;;
            lock)
                if [ -x "$HOME/.local/bin/lock.sh" ]; then
                    "$HOME/.local/bin/lock.sh"
                fi
                ;;
            power)
                cmd_power_session_menu
                ;;
            process)
                if [ -x "$TUI_DIR/task" ]; then
                    "$TUI_DIR/task"
                elif [ -x "$HOME/.local/bin/task" ]; then
                    "$HOME/.local/bin/task"
                fi
                ;;
            theme)
                if [ -x "$TUI_DIR/theme" ]; then
                    "$TUI_DIR/theme"
                elif [ -x "$HOME/.local/bin/theme" ]; then
                    "$HOME/.local/bin/theme"
                fi
                ;;
            config)
                if [ -x "$TUI_DIR/conf" ]; then
                    "$TUI_DIR/conf"
                elif [ -x "$HOME/.local/bin/conf" ]; then
                    "$HOME/.local/bin/conf"
                fi
                ;;
            warp)
                if [ -x "$HOME/.local/bin/warp_toggle.sh" ]; then
                    "$HOME/.local/bin/warp_toggle.sh"
                fi
                sleep 0.2
                ;;
            colorpicker)
                local color
                color=$(hyprpicker -a 2>/dev/null || true)
                [ -n "$color" ] && notify normal color-select "Color Picker" "Copied to clipboard: $color"
                sleep 0.3
                ;;
            disk)
                if [ -x "$TUI_DIR/disk" ]; then
                    "$TUI_DIR/disk"
                elif [ -x "$HOME/.local/bin/disk" ]; then
                    "$HOME/.local/bin/disk"
                fi
                ;;
            clean)
                if [ -x "$TUI_DIR/disk" ]; then
                    "$TUI_DIR/disk" clean
                elif [ -x "$HOME/.local/bin/disk" ]; then
                    "$HOME/.local/bin/disk" clean
                fi
                ;;
            app)
                if [ -x "$TUI_DIR/app" ]; then
                    "$TUI_DIR/app"
                elif [ -x "$HOME/.local/bin/app" ]; then
                    "$HOME/.local/bin/app"
                fi
                ;;
            hub)
                if [ -x "$TUI_DIR/s" ]; then
                    "$TUI_DIR/s"
                elif [ -x "$HOME/.local/bin/s" ]; then
                    "$HOME/.local/bin/s"
                fi
                ;;
        esac
    done
}

cmd_help() {
    cat << EOF
${BOLD}setting${RESET} - Terminal System Settings & Controls Manager

${BOLD}USAGE:${RESET}
    setting                         Launch interactive fzf menu with live preview
    setting status | s              Display current system toggles and status
    setting preview <target>        Inspect setting parameter preview
    setting wifi                    Manage Wi-Fi connections
    setting bluetooth | bt          Manage Bluetooth devices
    setting audio | volume          Open Audio & Volume Mixer
    setting brightness              Adjust display brightness
    setting awake | idle            Toggle screen awake / idle inhibitor
    setting nightlight | night      Toggle night light or set temperature
    setting clipboard | clip        Open clipboard history
    setting dnd                     Toggle Do Not Disturb notifications
    setting powerprofile [mode]     Cycle or set power profile (balanced/performance/power-saver)
    setting lock                    Lock screen immediately
    setting power                   Open power & shutdown menu
    setting process | top           Open process manager
    setting theme                   Open theme, wallpaper & Waybar customizer
    setting configs                 Open configuration files selector
    setting warp                    Toggle Cloudflare WARP VPN
    setting colorpicker             Pick color from screen
    setting disk                    Open disk & storage manager
    setting clean                   Clean system garbage and cache
    setting app                     Open desktop application launcher
    setting hub                     Open Master Tools Hub (s)
    setting help | -h               Show this help message

${BOLD}INTERACTIVE HOTKEYS (inside fzf menu):${RESET}
    ${CYAN}Enter${RESET}   Select item / Toggle setting / Open tool
    ${CYAN}Ctrl-R${RESET}  Refresh settings status
    ${CYAN}Ctrl-C${RESET}  Clear all SwayNC notifications
    ${CYAN}Ctrl-M${RESET}  Toggle Master Audio Mute
    ${CYAN}Esc${RESET}     Exit

EOF
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------

case "${1:-}" in
    status|s|info)
        cmd_status
        ;;
    preview)
        shift
        cmd_preview "$@"
        ;;
    wifi)
        shift
        if [ -x "$TUI_DIR/wifi" ]; then
            "$TUI_DIR/wifi" "$@"
        elif [ -x "$HOME/.local/bin/wifi" ]; then
            "$HOME/.local/bin/wifi" "$@"
        fi
        ;;
    bluetooth|bt)
        shift
        if [ -x "$TUI_DIR/bluetooth" ]; then
            "$TUI_DIR/bluetooth" "$@"
        elif [ -x "$HOME/.local/bin/bluetooth" ]; then
            "$HOME/.local/bin/bluetooth" "$@"
        fi
        ;;
    audio|volume)
        shift
        if [ -x "$TUI_DIR/audio" ]; then
            "$TUI_DIR/audio" "$@"
        elif [ -x "$HOME/.local/bin/audio" ]; then
            "$HOME/.local/bin/audio" "$@"
        fi
        ;;
    brightness)
        cmd_brightness_menu
        ;;
    awake|idle)
        if command -v awake >/dev/null 2>&1; then
            awake toggle
        elif [ -x "$HOME/.local/bin/idle_inhibit.sh" ]; then
            "$HOME/.local/bin/idle_inhibit.sh"
        fi
        ;;
    nightlight|night)
        cmd_nightlight_menu
        ;;
    clipboard|clip)
        shift
        if [ -x "$TUI_DIR/clip" ]; then
            "$TUI_DIR/clip" "$@"
        elif [ -x "$HOME/.local/bin/clip" ]; then
            "$HOME/.local/bin/clip" "$@"
        fi
        ;;
    dnd)
        cmd_dnd_toggle
        ;;
    powerprofile|profile)
        shift
        if [ -n "${1:-}" ] && command -v powerprofilesctl >/dev/null 2>&1; then
            powerprofilesctl set "$1"
        else
            cmd_powerprofile_cycle
        fi
        ;;
    lock)
        if [ -x "$HOME/.local/bin/lock.sh" ]; then
            "$HOME/.local/bin/lock.sh"
        fi
        ;;
    power|shutdown)
        cmd_power_session_menu
        ;;
    process|tasks)
        shift
        if [ -x "$TUI_DIR/task" ]; then
            "$TUI_DIR/task" "$@"
        elif [ -x "$HOME/.local/bin/task" ]; then
            "$HOME/.local/bin/task" "$@"
        fi
        ;;
    theme|appearance|gtk)
        shift
        if [ -x "$TUI_DIR/theme" ]; then
            "$TUI_DIR/theme" "$@"
        elif [ -x "$HOME/.local/bin/theme" ]; then
            "$HOME/.local/bin/theme" "$@"
        fi
        ;;
    configs|config)
        shift
        if [ -x "$TUI_DIR/conf" ]; then
            "$TUI_DIR/conf" "$@"
        elif [ -x "$HOME/.local/bin/conf" ]; then
            "$HOME/.local/bin/conf" "$@"
        fi
        ;;
    warp|vpn)
        if [ -x "$HOME/.local/bin/warp_toggle.sh" ]; then
            "$HOME/.local/bin/warp_toggle.sh"
        fi
        ;;
    colorpicker|picker)
        color=$(hyprpicker -a 2>/dev/null || true)
        [ -n "$color" ] && notify normal color-select "Color Picker" "Copied to clipboard: $color"
        ;;
    disk)
        shift
        if [ -x "$TUI_DIR/disk" ]; then
            "$TUI_DIR/disk" "$@"
        elif [ -x "$HOME/.local/bin/disk" ]; then
            "$HOME/.local/bin/disk" "$@"
        fi
        ;;
    clean)
        shift
        if [ -x "$TUI_DIR/disk" ]; then
            "$TUI_DIR/disk" clean "$@"
        elif [ -x "$HOME/.local/bin/disk" ]; then
            "$HOME/.local/bin/disk" clean "$@"
        fi
        ;;
    app|apps)
        shift
        if [ -x "$TUI_DIR/app" ]; then
            "$TUI_DIR/app" "$@"
        elif [ -x "$HOME/.local/bin/app" ]; then
            "$HOME/.local/bin/app" "$@"
        fi
        ;;
    hub)
        shift
        if [ -x "$TUI_DIR/s" ]; then
            "$TUI_DIR/s" "$@"
        elif [ -x "$HOME/.local/bin/s" ]; then
            "$HOME/.local/bin/s" "$@"
        fi
        ;;
    help|-h|--help)
        cmd_help
        ;;
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            cmd_interactive
        else
            cmd_status
            echo ""
            cmd_help
        fi
        ;;
    *)
        cmd_interactive
        ;;
esac
