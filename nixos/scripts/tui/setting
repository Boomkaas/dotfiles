            echo ""
            echo -e "${BOLD}Action:${RESET} Search and launch GUI desktop applications"
            ;;
        hub)
            echo -e "${BOLD}${CYAN}=== Master Tools Hub (s) ===${RESET}"
            echo -e "  ${BOLD}Unified Hub:${RESET}  All 21 dotfiles TUI tools"
