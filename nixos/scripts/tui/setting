#!/usr/bin/env bash
# ==============================================================================
# setting - Terminal System Settings & Controls Manager (CLI & fzf TUI)
# High-performance desktop control center for Wi-Fi, Bluetooth, Audio, Brightness,
# Power, Display, Maintenance, Notifications & Session management.
# ==============================================================================

set -eo pipefail

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

export FZF_DEFAULT_OPTS="--color=border:bright-black,prompt:green,pointer:red,marker:yellow,header:blue,info:yellow,hl:cyan,hl+:bright-red ${FZF_DEFAULT_OPTS:-}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUI_DIR="$SCRIPT_DIR"

notify() {
    local urgency="${1:-normal}"
    local icon="${2:-preferences-system}"
    local title="$3"
    local msg="$4"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -i "$icon" "$title" "$msg" -t 2500
    fi
}

# ------------------------------------------------------------------------------
# High-Speed Hardware & State Getters (Sub-millisecond sysfs & fast queries)
# ------------------------------------------------------------------------------

get_night_status() {
    if pgrep -x "hyprsunset" >/dev/null 2>&1 || pgrep -x "gammastep" >/dev/null 2>&1; then
        echo "ON"
    else
        echo "OFF"
    fi
}

get_idle_status() {
    if command -v awake &>/dev/null && awake status -q 2>/dev/null; then
        echo "ON"
    elif [[ -f "$HOME/.local/state/haku_theme/idle_inhibit" ]] && [[ "$(cat "$HOME/.local/state/haku_theme/idle_inhibit" 2>/dev/null)" == "1" ]]; then
        echo "ON"
    else
        echo "OFF"
    fi
}

get_warp_status() {
    if command -v warp-cli &>/dev/null && warp-cli status 2>/dev/null | grep -q 'Connected'; then
        echo "ON"
    else
        echo "OFF"
    fi
}

get_dnd_status() {
    if command -v swaync-client &>/dev/null && [[ "$(swaync-client --get-dnd 2>/dev/null)" == "true" ]]; then
        echo "ON"
    else
        echo "OFF"
    fi
}

# High-speed cached power profile query
get_power_profile() {
    local cache="/tmp/.setting_power_profile"
    if [ -s "$cache" ]; then
        cat "$cache" 2>/dev/null
        return
    fi

    local p="balanced"
    if command -v powerprofilesctl &>/dev/null; then
        p=$(powerprofilesctl get 2>/dev/null || echo "balanced")
    fi
    echo "$p" > "$cache" 2>/dev/null || true
    echo "$p"
}

get_brightness_pct() {
    local cur max
    cur=$(cat /sys/class/backlight/*/brightness 2>/dev/null | head -n1 || echo "")
    max=$(cat /sys/class/backlight/*/max_brightness 2>/dev/null | head -n1 || echo "")
    if [ -n "$cur" ] && [ -n "$max" ] && [ "$max" -gt 0 ]; then
        echo $(( (cur * 100 + max / 2) / max ))
    else
        echo "100"
    fi
}

get_battery_info() {
    local cap stat
    cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1 || echo "")
    stat=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1 || echo "")
    if [ -n "$cap" ]; then
        echo "${cap}% (${stat:-Unknown})"
    else
        echo "AC Connected (No Battery)"
    fi
}

get_volume_info() {
    local vol_raw vol_val is_muted pct
    vol_raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Volume: 0.50")
    vol_val=$(echo "$vol_raw" | grep -oP '\d+\.\d+' || echo "0.50")
    is_muted=$(echo "$vol_raw" | grep -qi "MUTED" && echo "MUTED" || echo "ACTIVE")
    pct=$(awk -v v="$vol_val" 'BEGIN { printf "%d", (v * 100) + 0.5 }')
    echo "${pct}% [${is_muted}]"
}

get_active_wifi_ssid() {
    local active_ssid
    active_ssid=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}')
    echo "${active_ssid:-Disconnected}"
}

get_bluetooth_status_short() {
    local power conn_count
    power=$(bluetoothctl show 2>/dev/null | grep -qi "Powered: yes" && echo "ON" || echo "OFF")
    if [ "$power" = "OFF" ]; then
        echo "OFF"
    else
        conn_count=$(bluetoothctl devices Connected 2>/dev/null | wc -l)
        if [ "$conn_count" -gt 0 ]; then
            local dev
            dev=$(bluetoothctl devices Connected 2>/dev/null | head -n1 | cut -d' ' -f3-)
            echo "Connected: ${dev:-$conn_count device(s)}"
        else
            echo "ON (0 connected)"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Actions
# ------------------------------------------------------------------------------

cmd_status() {
    echo -e "${BOLD}${CYAN}=== System Settings Status ===${RESET}"
    echo -e "  ${BOLD}Wi-Fi Network:${RESET}        ${GREEN}$(get_active_wifi_ssid)${RESET}"
    echo -e "  ${BOLD}Bluetooth:${RESET}           ${GREEN}$(get_bluetooth_status_short)${RESET}"
    echo -e "  ${BOLD}Audio Output:${RESET}         ${GREEN}$(get_volume_info)${RESET}"
    echo -e "  ${BOLD}Display Brightness:${RESET}   ${GREEN}$(get_brightness_pct)%${RESET}"
    echo -e "  ${BOLD}Battery Level:${RESET}        ${GREEN}$(get_battery_info)${RESET}"
    echo -e "  ${BOLD}Screen Awake Inhibit:${RESET} $([ "$(get_idle_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Night Light:${RESET}          $([ "$(get_night_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Do Not Disturb:${RESET}       $([ "$(get_dnd_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Power Profile:${RESET}        ${GREEN}$(get_power_profile)${RESET}"
    echo -e "  ${BOLD}Cloudflare WARP VPN:${RESET}  $([ "$(get_warp_status)" = "ON" ] && echo -e "${GREEN}Connected${RESET}" || echo -e "${DIM}Disconnected${RESET}")"
}

cmd_dnd_toggle() {
    if command -v swaync-client &>/dev/null; then
        swaync-client -d -sw >/dev/null 2>&1 || true
        local st
        st=$(swaync-client --get-dnd 2>/dev/null || echo "false")
        if [ "$st" = "true" ]; then
            echo -e "${GREEN}Do Not Disturb: Enabled (Silent)${RESET}"
            notify low notifications-disabled "Do Not Disturb" "Notifications muted"
        else
            echo -e "${YELLOW}Do Not Disturb: Disabled (Normal)${RESET}"
            notify normal notifications "Do Not Disturb" "Notifications unmuted"
        fi
    fi
}

cmd_powerprofile_cycle() {
    if command -v powerprofilesctl &>/dev/null; then
        local cur next
        cur=$(get_power_profile)
        case "$cur" in
            balanced) next="performance" ;;
            performance) next="power-saver" ;;
            *) next="balanced" ;;
        esac
        powerprofilesctl set "$next" 2>/dev/null || true
        rm -f "/tmp/.setting_power_profile"
        echo -e "${GREEN}Power profile switched to: ${BOLD}$next${RESET}"
        notify normal preferences-system-power "Power Profile" "Switched to: $next"
    fi
}

cmd_brightness_menu() {
    local cur
    cur=$(get_brightness_pct)
    local opts=(
        "󰃠  Set 100% (Maximum Brightness)"$'\t'"100%"
        "󰃟  Set 80%"$'\t'"80%"
        "󰃞  Set 60%"$'\t'"60%"
        "󰃝  Set 40%"$'\t'"40%"
        "󰃝  Set 20%"$'\t'"20%"
        "󰃝  Set 10% (Minimum Brightness)"$'\t'"10%"
        "󰃠  Increase +10%"$'\t'"+10%"
        "󰃞  Decrease -10%"$'\t'"-10%"
    )

    local res
    res=$(printf "%s\n" "${opts[@]}" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --prompt="󰃠 Brightness ($cur%) > " \
        --header="Select brightness preset (Enter: Apply | Esc: Cancel)" \
        --reverse --height=50% --border=rounded) || return 0

    [ -z "$res" ] && return 0
    local target
    target=$(echo "$res" | cut -f2)

    if command -v brightnessctl >/dev/null 2>&1; then
        brightnessctl set "$target" >/dev/null 2>&1 || true
        notify low display-brightness "Brightness" "Screen brightness adjusted to $(get_brightness_pct)%"
    fi
}

cmd_nightlight_menu() {
    local opts=(
        "󰃝  Toggle Night Light (ON / OFF)"$'\t'"toggle"
        "󰌵  Set 3000K (Warm / Deep Night)"$'\t'"3000"
        "󰌵  Set 4000K (Standard Warm)"$'\t'"4000"
        "󰌵  Set 5000K (Mild Eye Care)"$'\t'"5000"
        "󰌵  Set 6500K (Neutral Daylight / Disable)"$'\t'"6500"
    )

    local res
    res=$(printf "%s\n" "${opts[@]}" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --prompt="󰃝 Night Light > " \
        --header="Select temperature preset (Enter: Apply | Esc: Cancel)" \
        --reverse --height=50% --border=rounded) || return 0

    [ -z "$res" ] && return 0
    local val
    val=$(echo "$res" | cut -f2)

    if [ "$val" = "toggle" ]; then
        if [ -x "$HOME/.local/bin/nightlight_toggle.sh" ]; then
            $HOME/.local/bin/nightlight_toggle.sh
        fi
    elif [ "$val" = "6500" ]; then
        pkill -f gammastep 2>/dev/null || true
        pkill -f hyprsunset 2>/dev/null || true
        notify normal weather-clear "Night Light" "Blue light filter turned OFF"
    else
        pkill -f gammastep 2>/dev/null || true
        pkill -f hyprsunset 2>/dev/null || true
        if [ "$XDG_CURRENT_DESKTOP" = "Hyprland" ] && command -v hyprsunset >/dev/null 2>&1; then
            ( setsid hyprsunset --temperature "$val" & ) >/dev/null 2>&1
        elif command -v gammastep >/dev/null 2>&1; then
            ( setsid gammastep -O "$val" & ) >/dev/null 2>&1
        fi
        notify normal weather-clear-night "Night Light" "Color temperature set to ${val}K"
    fi
}

cmd_power_session_menu() {
    local opts=(
        "󰌾  Lock Screen"$'\t'"lock"
        "󰒲  Suspend to RAM (Sleep)"$'\t'"suspend"
        "󰒲  Hibernate to Disk"$'\t'"hibernate"
        "󰑐  Reboot Computer"$'\t'"reboot"
        "󰒓  Reboot to UEFI / BIOS Firmware"$'\t'"firmware"
        "󰈆  Log Out Desktop Session"$'\t'"logout"
        "  Shut Down PC"$'\t'"shutdown"
    )

    local res
    res=$(printf "%s\n" "${opts[@]}" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --prompt=" Power & Session > " \
        --header="Select session action (Enter: Execute | Esc: Cancel)" \
        --reverse --height=50% --border=rounded) || return 0

    [ -z "$res" ] && return 0
    local act
    act=$(echo "$res" | cut -f2)

    case "$act" in
        lock)
            if [ -x "$HOME/.local/bin/lock.sh" ]; then
                $HOME/.local/bin/lock.sh
            fi
            ;;
        suspend)
            [ -x "$HOME/.local/bin/lock.sh" ] && $HOME/.local/bin/lock.sh &
            systemctl suspend
            ;;
        hibernate)
            [ -x "$HOME/.local/bin/lock.sh" ] && $HOME/.local/bin/lock.sh &
            systemctl hibernate
            ;;
        reboot)
            systemctl reboot
            ;;
        firmware)
            systemctl reboot --firmware-setup
            ;;
        logout)
            loginctl terminate-session "${XDG_SESSION_ID:-self}" 2>/dev/null || pkill -u "$USER"
            ;;
        shutdown)
            systemctl poweroff
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Preview Handler (Ultra-Fast <15ms Response Time)
# ------------------------------------------------------------------------------

cmd_preview() {
    local target="${1:-}"

    if [ -z "$target" ] || [[ "$target" == __* ]] || [[ "$target" == overview ]]; then
        echo -e "${BOLD}${CYAN}=== System Settings Overview ===${RESET}"
        echo ""
        cmd_status
        echo ""
        echo -e "${BOLD}Keyboard Shortcuts in FZF:${RESET}"
        echo -e "  ${CYAN}Enter${RESET}   Select item / Toggle setting / Open tool"
        echo -e "  ${CYAN}Ctrl-R${RESET}  Refresh settings status"
        echo -e "  ${CYAN}Ctrl-C${RESET}  Clear all SwayNC notifications"
        echo -e "  ${CYAN}Esc${RESET}     Exit menu"
        return 0
    fi

    case "$target" in
        wifi)
            local iface active_ssid status ip
            status=$(nmcli -t -f WIFI g 2>/dev/null || echo "enabled")
            active_ssid=$(get_active_wifi_ssid)
            iface=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
            [ -z "$iface" ] && iface="wlan0"

            echo -e "${BOLD}${CYAN}=== Wi-Fi & Network Settings ===${RESET}"
            echo -e "  ${BOLD}Radio State:${RESET}  $([ "$status" = "enabled" ] && echo -e "${GREEN}Enabled (ON)${RESET}" || echo -e "${RED}Disabled (OFF)${RESET}")"
            echo -e "  ${BOLD}Interface:${RESET}    ${iface:---}"
            echo -e "  ${BOLD}Active SSID:${RESET}  ${GREEN}${active_ssid}${RESET}"
            if [ "$active_ssid" != "Disconnected" ]; then
                ip=$(ip -4 addr show dev "$iface" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1 || echo "--")
                echo -e "  ${BOLD}IPv4 Address:${RESET} ${CYAN}${ip}${RESET}"
            fi
            echo ""
            echo -e "${BOLD}Action:${RESET} Launch full interactive Wi-Fi Manager (wifi)"
            ;;
        bluetooth)
            local power conn_count
            power=$(bluetoothctl show 2>/dev/null | grep -qi "Powered: yes" && echo "ON" || echo "OFF")
            conn_count=$(bluetoothctl devices Connected 2>/dev/null | wc -l)
            echo -e "${BOLD}${CYAN}=== Bluetooth Manager ===${RESET}"
            echo -e "  ${BOLD}Controller:${RESET}   $([ "$power" = "ON" ] && echo -e "${GREEN}Powered ON${RESET}" || echo -e "${RED}Powered OFF${RESET}")"
            echo -e "  ${BOLD}Connected:${RESET}    $conn_count device(s)"
            if [ "$conn_count" -gt 0 ]; then
                echo -e "  ${BOLD}Devices:${RESET}"
                bluetoothctl devices Connected 2>/dev/null | while read -r _ mac dname; do
                    echo -e "    • ${GREEN}$dname${RESET} (${DIM}$mac${RESET})"
                done
            fi
            echo ""
            echo -e "${BOLD}Action:${RESET} Launch full interactive Bluetooth Manager (bluetooth)"
            ;;
        audio)
            local vol_info is_muted
            vol_info=$(get_volume_info)
            echo -e "${BOLD}${CYAN}=== Audio & Volume Mixer ===${RESET}"
            echo -e "  ${BOLD}Master Sink:${RESET}  ${GREEN}$vol_info${RESET}"
            echo ""
            echo -e "${BOLD}Action:${RESET} Open interactive PipeWire mixer (audio)"
            ;;
        brightness)
            local b_pct
            b_pct=$(get_brightness_pct)
            echo -e "${BOLD}${CYAN}=== Display Brightness ===${RESET}"
            echo -e "  ${BOLD}Current Level:${RESET} ${GREEN}${BOLD}${b_pct}%${RESET}"
            echo -e "  ${BOLD}Driver/Device:${RESET} intel_backlight / sysfs"
            echo ""
            echo -e "${BOLD}Action:${RESET} Select brightness preset (10% to 100%, +/- 10%)"
            ;;
        battery)
            local b_info prof
            b_info=$(get_battery_info)
            prof=$(get_power_profile)
            echo -e "${BOLD}${CYAN}=== Battery & Power Telemetry ===${RESET}"
            echo -e "  ${BOLD}Battery State:${RESET} ${GREEN}$b_info${RESET}"
            echo -e "  ${BOLD}Power Profile:${RESET} ${CYAN}$prof${RESET}"
            echo ""
            echo -e "${BOLD}Action:${RESET} Inspect power stats or cycle power profile"
            ;;
        awake)
            local idle
            idle=$(get_idle_status)
            echo -e "${BOLD}${CYAN}=== Screen Awake Inhibit ===${RESET}"
            echo -e "  ${BOLD}Awake Mode:${RESET}   $([ "$idle" = "ON" ] && echo -e "${GREEN}${BOLD}ON (Inhibiting Inactivity)${RESET}" || echo -e "${DIM}OFF (Normal Power Saving)${RESET}")"
            echo ""
            echo -e "${BOLD}Description:${RESET}"
            echo -e "  When ON, prevents screen locking, DPMS display turn-off,"
            echo -e "  system suspend, and automated night presence shutdown."
            echo ""
            echo -e "${BOLD}Action:${RESET} Toggle awake mode state"
            ;;
        night)
            local night
            night=$(get_night_status)
            echo -e "${BOLD}${CYAN}=== Night Light / Eye Care ===${RESET}"
            echo -e "  ${BOLD}Filter State:${RESET} $([ "$night" = "ON" ] && echo -e "${GREEN}ON (Warm Color Active)${RESET}" || echo -e "${DIM}OFF (Neutral Color)${RESET}")"
            echo -e "  ${BOLD}Engine:${RESET}       hyprsunset / gammastep"
            echo ""
            echo -e "${BOLD}Action:${RESET} Toggle filter or select warmth (3000K-6500K)"
            ;;
        clipboard)
            local count
