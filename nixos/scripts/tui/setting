            local root_free
            root_free=$(df -h / | awk 'NR==2 {print $4 " free of " $2}')
            echo -e "${BOLD}${CYAN}=== Disk & Storage Manager ===${RESET}"
            echo -e "  ${BOLD}Root (/):${RESET}     $root_free"
            echo ""
            echo -e "${BOLD}Action:${RESET} Open interactive storage inspector (disk)"
            ;;
        clean)
            echo -e "${BOLD}${CYAN}=== Clean System Garbage ===${RESET}"
            echo -e "  ${BOLD}Targets:${RESET}      Nix old generations, user cache, trash"
