#!/usr/bin/env bash
# ==============================================================================
# wifi - Terminal Wi-Fi Manager (CLI & fzf TUI)
# Access, scan, connect, monitor, and manage Wi-Fi connections via terminal.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

export FZF_DEFAULT_OPTS="--color=border:bright-black,prompt:green,pointer:red,marker:yellow,header:blue,info:yellow,hl:cyan,hl+:bright-red ${FZF_DEFAULT_OPTS:-}"

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

get_wifi_iface() {
    nmcli -t -f DEVICE,TYPE dev 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'
}

get_wifi_status() {
    nmcli -t -f WIFI g 2>/dev/null || echo "disabled"
}

get_active_ssid() {
    local s
    s=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}')
    if [ -n "$s" ]; then
        echo "$s"
    else
        nmcli -t -f ACTIVE,SSID dev wifi list --rescan no 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}'
    fi
}

is_saved_ssid() {
    local target="$1"
    nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: -v s="$target" '$1 == s && $2 == "802-11-wireless" { found=1; exit } END { exit !found }'
}

sig_to_icon() {
    local sig="$1"
    if [ "$sig" -ge 80 ]; then echo "󰤨"
    elif [ "$sig" -ge 60 ]; then echo "󰤥"
    elif [ "$sig" -ge 40 ]; then echo "󰤢"
    elif [ "$sig" -ge 20 ]; then echo "󰤟"
    else echo "󰤯"
    fi
}

sec_to_icon() {
    local sec="$1"
    if [ -n "$sec" ] && [ "$sec" != "--" ]; then
        echo "󰌾"
    else
        echo " "
    fi
}

freq_to_band() {
    local freq="$1"
    local f_num
    f_num=$(echo "$freq" | tr -dc '0-9')
    if [ -n "$f_num" ]; then
        if [ "$f_num" -gt 5900 ]; then echo "6 GHz"
        elif [ "$f_num" -gt 4000 ]; then echo "5 GHz"
        elif [ "$f_num" -gt 2000 ]; then echo "2.4 GHz"
        else echo "${f_num}MHz"
        fi
    else
        echo "--"
    fi
}

sig_to_bar() {
    local sig="${1:-0}"
    local width=10
    local filled=$(( (sig * width + 50) / 100 ))
    [ "$filled" -gt "$width" ] && filled="$width"
    [ "$filled" -lt 0 ] && filled=0
    local empty=$(( width - filled ))
    local bar=""
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done

    local color="$GREEN"
    if [ "$sig" -lt 40 ]; then
        color="$RED"
    elif [ "$sig" -lt 70 ]; then
        color="$YELLOW"
    fi
    echo -e "${color}[${bar}]${RESET}"
}

sig_to_dbm() {
    local sig="${1:-0}"
    local dbm=$(( (sig / 2) - 100 ))
    echo "${dbm} dBm"
}

sig_quality_label() {
    local sig="${1:-0}"
    if [ "$sig" -ge 80 ]; then echo "Excellent"
    elif [ "$sig" -ge 65 ]; then echo "Good"
    elif [ "$sig" -ge 45 ]; then echo "Fair"
    elif [ "$sig" -ge 20 ]; then echo "Weak"
    else echo "Very Poor"
    fi
}

# ------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------

cmd_status() {
    local status iface active_ssid
    status=$(get_wifi_status)
    iface=$(get_wifi_iface)
    active_ssid=$(get_active_ssid)

    echo -e "${BOLD}${CYAN}=== Wi-Fi Status ===${RESET}"
    echo -e "  ${BOLD}Radio:${RESET}        $([ "$status" = "enabled" ] && echo -e "${GREEN}Enabled (ON)${RESET}" || echo -e "${RED}Disabled (OFF)${RESET}")"
    echo -e "  ${BOLD}Interface:${RESET}    ${iface:---}"

    if [ -n "$iface" ]; then
        local hw_addr driver
        hw_addr=$(nmcli -t -f GENERAL.HWADDR dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2-)
        driver=$(nmcli -t -f GENERAL.DRIVER dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2-)
        [ -n "$hw_addr" ] && echo -e "  ${BOLD}MAC Address:${RESET}  $hw_addr"
        [ -n "$driver" ]  && echo -e "  ${BOLD}Driver:${RESET}       $driver"
    fi

    if [ -n "$active_ssid" ]; then
        echo -e "  ${BOLD}Status:${RESET}       ${GREEN}Connected${RESET}"
        echo -e "  ${BOLD}Network:${RESET}      ${BOLD}${GREEN}$active_ssid${RESET}"

        local ip_info gw_info dns_info sig_info bssid_info freq_info chan_info rate_info sec_info
        ip_info=$(nmcli -t -f IP4.ADDRESS dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
        gw_info=$(nmcli -t -f IP4.GATEWAY dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
        dns_info=$(nmcli -t -f IP4.DNS dev show "$iface" 2>/dev/null | tr '\n' ' ' | sed 's/IP4.DNS\[[0-9]*\]://g' | xargs)
        
        local active_line
        active_line=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list --rescan no 2>/dev/null | grep '^\*' | head -n 1 || true)
        if [ -n "$active_line" ]; then
            local line_sub="${active_line//\\:/$'\001'}"
            IFS=':' read -r _ _ bssid_info chan_info freq_info rate_info sig_info _ sec_info <<< "$line_sub"
            bssid_info="${bssid_info//$'\001'/:}"
        fi

        [ -n "$sig_info" ] && echo -e "  ${BOLD}Signal:${RESET}       $(sig_to_icon "$sig_info") $(sig_to_bar "$sig_info") $sig_info% ($(sig_to_dbm "$sig_info")) [$(sig_quality_label "$sig_info")]"
        [ -n "$freq_info" ] && echo -e "  ${BOLD}Channel/Band:${RESET} Channel ${chan_info:---} ($(freq_to_band "$freq_info"), $freq_info)"
        [ -n "$rate_info" ] && echo -e "  ${BOLD}Max Bitrate:${RESET}  $rate_info"
        [ -n "$sec_info" ]  && echo -e "  ${BOLD}Security:${RESET}     $sec_info"
        [ -n "$bssid_info" ] && echo -e "  ${BOLD}Access Point:${RESET} $bssid_info"
        [ -n "$ip_info" ] && echo -e "  ${BOLD}IPv4 Address:${RESET} $ip_info"
        [ -n "$gw_info" ] && echo -e "  ${BOLD}Gateway:${RESET}      $gw_info"
        [ -n "$dns_info" ] && echo -e "  ${BOLD}DNS Server:${RESET}   $dns_info"
    else
        echo -e "  ${BOLD}Status:${RESET}       ${YELLOW}Disconnected${RESET}"
    fi
}

cmd_scan() {
    local iface
    iface=$(get_wifi_iface)
    if [ -z "$iface" ]; then
        echo -e "${RED}Error: No Wi-Fi interface found.${RESET}" >&2
        return 1
    fi

    echo -e "${CYAN}Scanning nearby Wi-Fi networks...${RESET}"
    nmcli dev wifi rescan >/dev/null 2>&1 || true

    local raw_list active_ssid
    raw_list=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list 2>/dev/null || true)
    active_ssid=$(get_active_ssid)

    if [ -z "$raw_list" ]; then
        echo -e "${YELLOW}No networks found.${RESET}"
        return 0
    fi

    declare -A SEEN_SIG SEEN_SEC SEEN_BAND SEEN_CHAN SEEN_RATE SEEN_ACT

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local line_sub="${line//\\:/$'\001'}"
        local in_use ssid bssid chan freq rate signal bars security
        IFS=':' read -r in_use ssid bssid chan freq rate signal bars security <<< "$line_sub"

        [ -z "$ssid" ] || [ "$ssid" = "--" ] && continue
        local sig_num
        sig_num=$(echo "$signal" | tr -dc '0-9')
        [ -z "$sig_num" ] && sig_num=0

        local is_act=0
        if [ "$in_use" = "*" ] || [ "$ssid" = "$active_ssid" ]; then
            is_act=1
        fi

        if [ -z "${SEEN_SIG["$ssid"]+x}" ] || [ "$sig_num" -gt "${SEEN_SIG["$ssid"]}" ] || [ "$is_act" -eq 1 ]; then
            SEEN_SIG["$ssid"]="$sig_num"
            SEEN_SEC["$ssid"]="$security"
            SEEN_BAND["$ssid"]="$(freq_to_band "$freq")"
            SEEN_CHAN["$ssid"]="$chan"
            SEEN_RATE["$ssid"]="$rate"
            SEEN_ACT["$ssid"]="$is_act"
        fi
    done <<< "$raw_list"

    echo ""
    printf "${BOLD}%-2s %-2s %-12s %-5s %-4s %-9s %-12s %-12s %s${RESET}\n" "ST" "" "SIGNAL" "QUAL" "CHAN" "BAND" "SECURITY" "MAX RATE" "SSID"
    echo -e "${DIM}------------------------------------------------------------------------------------------------${RESET}"

    local lines=()
    for s in "${!SEEN_SIG[@]}"; do
        local sig="${SEEN_SIG["$s"]}"
        local sec="${SEEN_SEC["$s"]}"
        local band="${SEEN_BAND["$s"]}"
        local chan="${SEEN_CHAN["$s"]}"
        local rate="${SEEN_RATE["$s"]}"
        local is_act="${SEEN_ACT["$s"]}"
        local is_saved=0
        is_saved_ssid "$s" && is_saved=1

        local st_tag="  "
        if [ "$is_act" -eq 1 ]; then
            st_tag="${GREEN}✓ ${RESET}"
        elif [ "$is_saved" -eq 1 ]; then
            st_tag="${YELLOW}★ ${RESET}"
        fi

        local icon
        icon=$(sig_to_icon "$sig")
        local bar
        bar=$(sig_to_bar "$sig")
        local sec_label="${sec:---}"
        [ "$sec_label" = "--" ] && sec_label="Open"

        lines+=("$(printf "%s %s %s %3d%%  %-4s %-9s %-12s %-12s %s" "$st_tag" "$icon" "$bar" "$sig" "$chan" "$band" "$sec_label" "$rate" "$s")")
    done

    printf "%s\n" "${lines[@]}" | sort -k1,1r -k4,4nr
}

cmd_saved() {
    echo -e "${BOLD}${CYAN}=== Saved Wi-Fi Connections ===${RESET}"
    local saved active_ssid
    saved=$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1}')
    active_ssid=$(get_active_ssid)

    if [ -z "$saved" ]; then
        echo -e "${YELLOW}No saved Wi-Fi connections found.${RESET}"
        return 0
    fi

    while IFS= read -r name; do
        [ -z "$name" ] && continue
        if [ "$name" = "$active_ssid" ]; then
            echo -e "  ${GREEN}✓ $name (Active)${RESET}"
        else
            echo -e "  ${YELLOW}★${RESET} $name"
        fi
    done <<< "$saved"
}

cmd_connect() {
    local target_ssid="$1"
    local password="$2"

    if [ -z "$target_ssid" ]; then
        if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
            cmd_interactive
            return 0
        else
            echo -e "${RED}Error: Specify SSID to connect to. Usage: wifi connect <SSID> [password]${RESET}" >&2
            return 1
        fi
    fi

    if is_saved_ssid "$target_ssid"; then
        echo -e "${CYAN}Connecting to saved profile: ${BOLD}$target_ssid${RESET}..."
        if nmcli con up id "$target_ssid"; then
            echo -e "${GREEN}✓ Successfully connected to $target_ssid${RESET}"
            return 0
        else
            echo -e "${RED}Failed to connect to saved profile $target_ssid.${RESET}"
            read -r -p "Do you want to re-enter credentials? [y/N]: " retry
            if [[ ! "$retry" =~ ^[Yy]$ ]]; then
                return 1
            fi
        fi
    fi

    local sec
    sec=$(nmcli -t -f SSID,SECURITY dev wifi list --rescan no 2>/dev/null | awk -F: -v s="$target_ssid" '$1 == s { print $2; exit }')

    if [ -z "$password" ] && [ -n "$sec" ] && [ "$sec" != "--" ]; then
        echo -e "${YELLOW}Network '$target_ssid' is secured ($sec).${RESET}"
        read -rsp "Enter Wi-Fi password: " password
        echo ""
    fi

    echo -e "${CYAN}Connecting to ${BOLD}$target_ssid${RESET}..."
    if [ -n "$password" ]; then
        if nmcli dev wifi connect "$target_ssid" password "$password"; then
            echo -e "${GREEN}✓ Successfully connected to $target_ssid!${RESET}"
        else
            echo -e "${RED}✗ Failed to connect to $target_ssid.${RESET}"
            return 1
        fi
    else
        if nmcli dev wifi connect "$target_ssid"; then
            echo -e "${GREEN}✓ Successfully connected to open network $target_ssid!${RESET}"
        else
            echo -e "${RED}✗ Failed to connect to $target_ssid.${RESET}"
            return 1
        fi
    fi
}

cmd_hidden() {
    local ssid pass
    read -rp "Enter Hidden Network SSID: " ssid
    [ -z "$ssid" ] && return 0
    read -rsp "Enter Password (leave blank if Open): " pass
    echo ""

    echo -e "${CYAN}Connecting to hidden network: ${BOLD}$ssid${RESET}..."
    if [ -n "$pass" ]; then
        nmcli dev wifi connect "$ssid" password "$pass" hidden yes
    else
        nmcli dev wifi connect "$ssid" hidden yes
    fi
}

cmd_disconnect() {
    local active_ssid iface
    active_ssid=$(get_active_ssid)
    iface=$(get_wifi_iface)

    if [ -n "$active_ssid" ]; then
        echo -e "${YELLOW}Disconnecting from $active_ssid...${RESET}"
        nmcli con down id "$active_ssid" >/dev/null 2>&1 || nmcli dev disconnect iface "$iface" >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Disconnected.${RESET}"
    else
        echo -e "${YELLOW}Not currently connected to any Wi-Fi network.${RESET}"
    fi
}

cmd_forget() {
    local target="$1"
    if [ -z "$target" ]; then
        local saved
        saved=$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1}')
        if [ -z "$saved" ]; then
            echo -e "${YELLOW}No saved profiles to forget.${RESET}"
            return 0
        fi
        if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
            target=$(echo "$saved" | fzf --prompt="Select profile to forget: " --height=48% --reverse --border=rounded)
        else
            echo "$saved"
            read -rp "Enter profile name to forget: " target
        fi
    fi

    [ -z "$target" ] && return 0

    if nmcli con delete id "$target"; then
        echo -e "${GREEN}✓ Removed network profile: $target${RESET}"
    else
        echo -e "${RED}✗ Could not remove profile: $target${RESET}"
        return 1
    fi
}

cmd_toggle() {
    local status
    status=$(get_wifi_status)
    if [ "$status" = "enabled" ]; then
        nmcli radio wifi off
        echo -e "${YELLOW}Wi-Fi turned OFF.${RESET}"
    else
        nmcli radio wifi on
        echo -e "${GREEN}Wi-Fi turned ON.${RESET}"
    fi
}

# ------------------------------------------------------------------------------
# Live Monitor Mode (Impala Dashboard Equivalent)
# ------------------------------------------------------------------------------

cmd_monitor() {
    local iface
    iface=$(get_wifi_iface)
    echo -e "${CYAN}Starting live Wi-Fi monitor dashboard (Press 'q' to quit)...${RESET}"
    
    tput civis 2>/dev/null || true
    trap 'tput cnorm 2>/dev/null || true; return 0' EXIT INT TERM

    while true; do
        clear
        local active_ssid status ip_info gw_info
        status=$(get_wifi_status)
        active_ssid=$(get_active_ssid)

        echo -e "${BOLD}${CYAN}╔════════════════════════════════════════════════════════════════════════════════╗${RESET}"
        echo -e "${BOLD}${CYAN}║                     󰤨  LIVE WI-FI MONITOR DASHBOARD                             ║${RESET}"
        echo -e "${BOLD}${CYAN}╚════════════════════════════════════════════════════════════════════════════════╝${RESET}"

        if [ "$status" = "disabled" ]; then
            echo -e "  ${BOLD}Radio:${RESET}     ${RED}OFF (Disabled)${RESET}"
        elif [ -n "$active_ssid" ]; then
            ip_info=$(nmcli -t -f IP4.ADDRESS dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
            gw_info=$(nmcli -t -f IP4.GATEWAY dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
            
            local active_line
            active_line=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list --rescan no 2>/dev/null | grep '^\*' | head -n 1 || true)
            local a_bssid a_chan a_freq a_rate a_sig a_sec
            if [ -n "$active_line" ]; then
                local line_sub="${active_line//\\:/$'\001'}"
                IFS=':' read -r _ _ a_bssid a_chan a_freq a_rate a_sig _ a_sec <<< "$line_sub"
                a_bssid="${a_bssid//$'\001'/:}"
            fi

            local a_sig_num="${a_sig:-0}"
            echo -e "  ${BOLD}Active Network:${RESET} ${GREEN}${BOLD}$active_ssid${RESET}  ${DIM}[BSSID: ${a_bssid:---}]${RESET}"
            echo -e "  ${BOLD}Signal Quality:${RESET} $(sig_to_bar "$a_sig_num") $a_sig_num% ($(sig_to_dbm "$a_sig_num")) [$(sig_quality_label "$a_sig_num")]"
            echo -e "  ${BOLD}Link Speed:${RESET}     ${CYAN}${a_rate:---}${RESET}  |  ${BOLD}Band:${RESET} $(freq_to_band "${a_freq:---}") (Ch: ${a_chan:---})  |  ${BOLD}Security:${RESET} ${a_sec:---}"
            echo -e "  ${BOLD}IP Address:${RESET}     ${ip_info:---}  |  ${BOLD}Gateway:${RESET} ${gw_info:---}"
        else
            echo -e "  ${BOLD}Status:${RESET}    ${YELLOW}Disconnected (Wi-Fi ON)${RESET}"
        fi

        echo ""
        echo -e "${BOLD}${CYAN}Nearby Wi-Fi Networks (Ranked by Signal):${RESET}"
        printf "${BOLD}%-2s %-2s %-12s %-5s %-4s %-9s %-12s %-12s %s${RESET}\n" "ST" "" "SIGNAL" "QUAL" "CHAN" "BAND" "SECURITY" "MAX RATE" "SSID"
        echo -e "${DIM}------------------------------------------------------------------------------------------------${RESET}"

        local raw_list
        raw_list=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list --rescan no 2>/dev/null || true)
        
        declare -A SEEN_MON_SIG SEEN_MON_CHAN SEEN_MON_BAND SEEN_MON_SEC SEEN_MON_RATE SEEN_MON_ACT
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            local line_sub="${line//\\:/$'\001'}"
            local m_in_use m_ssid m_bssid m_chan m_freq m_rate m_sig m_bars m_sec
            IFS=':' read -r m_in_use m_ssid m_bssid m_chan m_freq m_rate m_sig m_bars m_sec <<< "$line_sub"
            [ -z "$m_ssid" ] || [ "$m_ssid" = "--" ] && continue

            local is_act=0
            [ "$m_in_use" = "*" ] || [ "$m_ssid" = "$active_ssid" ] && is_act=1

            local s_num
            s_num=$(echo "$m_sig" | tr -dc '0-9')
            [ -z "$s_num" ] && s_num=0

            if [ -z "${SEEN_MON_SIG["$m_ssid"]+x}" ] || [ "$s_num" -gt "${SEEN_MON_SIG["$m_ssid"]}" ] || [ "$is_act" -eq 1 ]; then
                SEEN_MON_SIG["$m_ssid"]="$s_num"
                SEEN_MON_CHAN["$m_ssid"]="$m_chan"
                SEEN_MON_BAND["$m_ssid"]="$(freq_to_band "$m_freq")"
                SEEN_MON_SEC["$m_ssid"]="$m_sec"
                SEEN_MON_RATE["$m_ssid"]="$m_rate"
                SEEN_MON_ACT["$m_ssid"]="$is_act"
            fi
        done <<< "$raw_list"

        local out_lines=()
        for s in "${!SEEN_MON_SIG[@]}"; do
            local sig="${SEEN_MON_SIG["$s"]}"
            local chan="${SEEN_MON_CHAN["$s"]}"
            local band="${SEEN_MON_BAND["$s"]}"
            local sec="${SEEN_MON_SEC["$s"]}"
            local rate="${SEEN_MON_RATE["$s"]}"
            local is_act="${SEEN_MON_ACT["$s"]}"
            local is_saved=0
            is_saved_ssid "$s" && is_saved=1

            local st_tag="  "
            if [ "$is_act" -eq 1 ]; then st_tag="${GREEN}✓ ${RESET}"
            elif [ "$is_saved" -eq 1 ]; then st_tag="${YELLOW}★ ${RESET}"
            fi

            local icon
            icon=$(sig_to_icon "$sig")
            local bar
            bar=$(sig_to_bar "$sig")
            local sec_lbl="${sec:---}"
            [ "$sec_lbl" = "--" ] && sec_lbl="Open"

            out_lines+=("$(printf "%s %s %s %3d%%  %-4s %-9s %-12s %-12s %s" "$st_tag" "$icon" "$bar" "$sig" "$chan" "$band" "$sec_lbl" "$rate" "$s")")
        done

        if [ ${#out_lines[@]} -gt 0 ]; then
            printf "%s\n" "${out_lines[@]}" | sort -k1,1r -k4,4nr | head -n 14
        else
            echo -e "  ${DIM}No networks detected. Scanning...${RESET}"
        fi

        echo ""
        echo -e "${DIM}Auto-refreshing every 3s | Press 'q' or 'Ctrl-C' to exit | 'r' to rescan immediately${RESET}"
        
        local user_key=""
        read -t 3 -n 1 user_key 2>/dev/null || true
        if [[ "$user_key" == "q" ]] || [[ "$user_key" == "Q" ]]; then
            break
        elif [[ "$user_key" == "r" ]] || [[ "$user_key" == "R" ]]; then
            nmcli dev wifi rescan >/dev/null 2>&1 || true
        fi
    done
    tput cnorm 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Preview Handler (FZF Preview Window & CLI details)
# ------------------------------------------------------------------------------

cmd_preview() {
    local target="${1:-}"

    if [ -z "$target" ] || [[ "$target" == __action_* ]] || [[ "$target" == __divider__ ]] || [[ "$target" == __none__ ]]; then
        echo -e "${BOLD}${CYAN}=== Wi-Fi Overview ===${RESET}"
        echo ""
        cmd_status
        echo ""
        echo -e "${BOLD}Keyboard Shortcuts in FZF:${RESET}"
        echo -e "  ${CYAN}Enter${RESET}   Select / Connect / Manage network"
        echo -e "  ${CYAN}Ctrl-R${RESET}  Rescan available networks"
        echo -e "  ${CYAN}Ctrl-C${RESET}  Quick Connect to highlighted SSID"
        echo -e "  ${CYAN}Ctrl-D${RESET}  Disconnect from active Wi-Fi"
        echo -e "  ${CYAN}Ctrl-S${RESET}  Open Saved Networks Manager"
        echo -e "  ${CYAN}Ctrl-W${RESET}  Toggle Wi-Fi Radio ON / OFF"
        echo -e "  ${CYAN}Ctrl-M${RESET}  Launch Live Monitor Dashboard"
        echo -e "  ${CYAN}Esc${RESET}     Exit menu"
        return 0
    fi

    # Query network information from scan list
    local active_ssid iface
    active_ssid=$(get_active_ssid)
    iface=$(get_wifi_iface)

    local match_line
    match_line=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list --rescan no 2>/dev/null | grep -F ":$target:" | head -n 1 || true)

    local p_in_use p_ssid p_bssid p_chan p_freq p_rate p_sig p_bars p_sec
    if [ -n "$match_line" ]; then
        local line_sub="${match_line//\\:/$'\001'}"
        IFS=':' read -r p_in_use p_ssid p_bssid p_chan p_freq p_rate p_sig p_bars p_sec <<< "$line_sub"
        p_bssid="${p_bssid//$'\001'/:}"
    fi

    local is_act=0
    [ "$target" = "$active_ssid" ] || [ "$p_in_use" = "*" ] && is_act=1

    local is_saved=0
    is_saved_ssid "$target" && is_saved=1

    local sig_num
    sig_num=$(echo "${p_sig:-0}" | tr -dc '0-9')
    [ -z "$sig_num" ] && sig_num=0

    echo -e "${BOLD}${CYAN}=== Wi-Fi Network Details ===${RESET}"
    echo -e "  ${BOLD}SSID:${RESET}         $(sig_to_icon "$sig_num") ${BOLD}$target${RESET} $([ "$is_act" -eq 1 ] && echo -e "${GREEN}(Active / Connected)${RESET}" || ([ "$is_saved" -eq 1 ] && echo -e "${YELLOW}(Saved Profile)${RESET}"))"
    echo -e "  ${BOLD}Signal:${RESET}       $(sig_to_bar "$sig_num") $sig_num% ($(sig_to_dbm "$sig_num")) [$(sig_quality_label "$sig_num")]"
    echo -e "  ${BOLD}Band / Rate:${RESET}  $(freq_to_band "${p_freq:---}") (${p_freq:---}, Ch ${p_chan:---}) • Rate: ${p_rate:---}"
    echo -e "  ${BOLD}Security:${RESET}     $(sec_to_icon "${p_sec:---}") ${p_sec:---} • BSSID: ${p_bssid:---}"

    if [ "$is_saved" -eq 1 ]; then
        local autoconn uuid
        autoconn=$(nmcli -t -f connection.autoconnect con show "$target" 2>/dev/null | cut -d: -f2 || echo "unknown")
        uuid=$(nmcli -t -f connection.uuid con show "$target" 2>/dev/null | cut -d: -f2 || echo "--")
        echo -e "  ${BOLD}Profile:${RESET}      ${GREEN}Saved${RESET} (AutoConnect: $autoconn)"
    else
        echo -e "  ${BOLD}Profile:${RESET}      ${YELLOW}Not saved${RESET} (New network)"
    fi

    if [ "$is_act" -eq 1 ]; then
        local ip4 gw4 dns4 driver
        ip4=$(nmcli -t -f IP4.ADDRESS dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
        gw4=$(nmcli -t -f IP4.GATEWAY dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
        dns4=$(nmcli -t -f IP4.DNS dev show "$iface" 2>/dev/null | tr '\n' ' ' | sed 's/IP4.DNS\[[0-9]*\]://g' | xargs)
        driver=$(nmcli -t -f GENERAL.DRIVER dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2-)

        echo -e "  ${BOLD}Link:${RESET}         ${iface} (${driver:-generic}) • ${GREEN}${ip4:---}${RESET}"
        echo -e "  ${BOLD}Route:${RESET}        GW: ${gw4:---} • DNS: ${dns4:---}"
    fi

    echo ""
    echo -e "${BOLD}Actions:${RESET} Enter: Connect/Manage | Ctrl-C: Connect | Ctrl-D: Disconn | Ctrl-R: Rescan"
}

# ------------------------------------------------------------------------------
# Interactive TUI Menu (fzf)
# ------------------------------------------------------------------------------

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo -e "${YELLOW}fzf not found. Showing status and scanned networks:${RESET}"
        cmd_status
        echo ""
        cmd_scan
        return 0
    fi

    local self_bin="${BASH_SOURCE[0]}"

    while true; do
        clear
        local status iface active_ssid
        status=$(get_wifi_status)
        iface=$(get_wifi_iface)
        active_ssid=$(get_active_ssid)

        local header_info=""
        if [ "$status" = "disabled" ]; then
            header_info="Wi-Fi: DISABLED (OFF)"
        elif [ -n "$active_ssid" ]; then
            local ip_info
            ip_info=$(nmcli -t -f IP4.ADDRESS dev show "$iface" 2>/dev/null | head -n 1 | cut -d: -f2)
            header_info="Connected: $active_ssid (${ip_info:---})"
        else
            header_info="Wi-Fi: ON (Disconnected)"
        fi

        # Fetch scanned networks
        local raw_list
        raw_list=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list --rescan no 2>/dev/null || true)
        if [ -z "$raw_list" ]; then
            nmcli dev wifi rescan >/dev/null 2>&1 || true
            sleep 1
            raw_list=$(nmcli -t -f IN-USE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY dev wifi list --rescan no 2>/dev/null || true)
        fi

        declare -A SEEN_SIG SEEN_SEC SEEN_BAND SEEN_CHAN SEEN_RATE SEEN_ACT

        while IFS= read -r line; do
            [ -z "$line" ] && continue
            local line_sub="${line//\\:/$'\001'}"
            local in_use ssid bssid chan freq rate signal bars security
            IFS=':' read -r in_use ssid bssid chan freq rate signal bars security <<< "$line_sub"

            [ -z "$ssid" ] || [ "$ssid" = "--" ] && continue
            local sig_num
            sig_num=$(echo "$signal" | tr -dc '0-9')
            [ -z "$sig_num" ] && sig_num=0

            local is_act=0
            if [ "$in_use" = "*" ] || [ "$ssid" = "$active_ssid" ]; then
                is_act=1
            fi

            if [ -z "${SEEN_SIG["$ssid"]+x}" ] || [ "$sig_num" -gt "${SEEN_SIG["$ssid"]}" ] || [ "$is_act" -eq 1 ]; then
                SEEN_SIG["$ssid"]="$sig_num"
                SEEN_SEC["$ssid"]="$security"
                SEEN_BAND["$ssid"]="$(freq_to_band "$freq")"
                SEEN_CHAN["$ssid"]="$chan"
                SEEN_RATE["$ssid"]="$rate"
                SEEN_ACT["$ssid"]="$is_act"
            fi
        done <<< "$raw_list"

        # Build menu items (with tab delimiters for preview and hotkey mapping)
        local menu=()
        menu+=("󰑐  Rescan Available Networks"$'\t'"__action_rescan__")
        if [ -n "$active_ssid" ]; then
            menu+=("󰤮  Disconnect from \"$active_ssid\""$'\t'"__action_disconnect__")
        fi
        menu+=("󰢮  Live Wi-Fi Monitor Dashboard"$'\t'"__action_monitor__")
        menu+=("󰛐  Connect to Hidden Network..."$'\t'"__action_hidden__")
        menu+=("★  Saved Networks Manager"$'\t'"__action_saved__")
        if [ "$status" = "enabled" ]; then
            menu+=("󰖪  Turn Wi-Fi OFF"$'\t'"__action_toggle__")
        else
            menu+=("󰖩  Turn Wi-Fi ON"$'\t'"__action_toggle__")
        fi
        menu+=("󰌢  Launch nmtui (NetworkManager TUI)"$'\t'"__action_nmtui__")
        menu+=("─────────────────────────────────────────────────────────────"$'\t'"__divider__")

        # Network list items
        local net_lines=()
        for s in "${!SEEN_SIG[@]}"; do
            local sig="${SEEN_SIG["$s"]}"
            local sec="${SEEN_SEC["$s"]}"
            local band="${SEEN_BAND["$s"]}"
            local chan="${SEEN_CHAN["$s"]}"
            local rate="${SEEN_RATE["$s"]}"
            local is_act="${SEEN_ACT["$s"]}"
            local is_saved=0
            is_saved_ssid "$s" && is_saved=1

            local mark="  "
            if [ "$is_act" -eq 1 ]; then mark="✓ "
            elif [ "$is_saved" -eq 1 ]; then mark="★ "
            fi

            local icon
            icon=$(sig_to_icon "$sig")
            local bar
            bar=$(sig_to_bar "$sig")
            local sec_lbl="${sec:---}"
            [ "$sec_lbl" = "--" ] && sec_lbl="Open"

            local disp
            disp=$(printf "%s%s %s %3d%%  %-7s  %-12s  %s" "$mark" "$icon" "$bar" "$sig" "$band" "$sec_lbl" "$s")
            net_lines+=("${disp}"$'\t'"${s}")
        done

        if [ ${#net_lines[@]} -gt 0 ]; then
            while IFS= read -r sorted_line; do
                [ -n "$sorted_line" ] && menu+=("$sorted_line")
            done < <(printf "%s\n" "${net_lines[@]}" | sort -k1,1r -k4,4nr)
        else
            menu+=("--- No Wi-Fi networks found ---"$'\t'"__none__")
        fi

        local res key choice
        res=$(printf "%s\n" "${menu[@]}" | fzf \
            --expect=ctrl-r,ctrl-c,ctrl-d,ctrl-s,ctrl-w,ctrl-m \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:52%:wrap \
            --prompt="󰖩  Wi-Fi > " \
            --header="[$header_info] (Enter: Select | Ctrl-R: Rescan | Ctrl-C: Connect | Ctrl-D: Discon | Ctrl-W: Radio | Ctrl-M: Monitor)" \
            --reverse \
            --height=100% \
            --border=rounded \
            --cycle) || break

        [ -z "$res" ] && break
        key=$(echo "$res" | sed -n '1p')
        choice=$(echo "$res" | sed -n '2p')
        [ -z "$choice" ] && break

        local sel_arg
        sel_arg=$(echo "$choice" | cut -f2)

        # Handle global hotkeys
        case "$key" in
            ctrl-r)
                echo -e "${CYAN}Rescanning...${RESET}"
                nmcli dev wifi rescan >/dev/null 2>&1 || true
                sleep 1
                continue
                ;;
            ctrl-d)
                cmd_disconnect
                sleep 1
                continue
                ;;
            ctrl-w)
                cmd_toggle
                sleep 0.5
                continue
                ;;
            ctrl-s)
                sel_arg="__action_saved__"
                ;;
            ctrl-m)
                cmd_monitor
                continue
                ;;
            ctrl-c)
                if [ -n "$sel_arg" ] && [[ "$sel_arg" != __* ]]; then
                    cmd_connect "$sel_arg"
                    echo "Press enter to continue..."
                    read -r
                    continue
                fi
                ;;
        esac

        # Handle item selection
        case "$sel_arg" in
            __action_rescan__)
                echo -e "${CYAN}Rescanning...${RESET}"
                nmcli dev wifi rescan >/dev/null 2>&1 || true
                sleep 1
                ;;
            __action_disconnect__)
                cmd_disconnect
                sleep 1
                ;;
            __action_monitor__)
                cmd_monitor
                ;;
            __action_hidden__)
                cmd_hidden
                echo "Press enter to continue..."
                read -r
                ;;
            __action_saved__)
                local saved_sel
                saved_sel=$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1}' | fzf \
                    --prompt="Saved Network > " \
                    --header="Select saved network to manage" \
                    --reverse --height=48% --border=rounded) || true
                if [ -n "$saved_sel" ]; then
                    local act
                    act=$(printf "1. Connect\n2. Forget / Delete\n3. Cancel" | fzf \
                        --prompt="$saved_sel > " \
                        --reverse --height=40% --border=rounded) || true
                    case "$act" in
                        *"Connect"*) cmd_connect "$saved_sel" ;;
                        *"Forget"*) cmd_forget "$saved_sel" ;;
                    esac
                    echo "Press enter to continue..."
                    read -r
                fi
                ;;
            __action_toggle__)
                cmd_toggle
                sleep 0.5
                ;;
            __action_nmtui__)
                nmtui
                ;;
            __divider__|__none__)
                ;;
            *)
                # Network selected
                local sel_ssid="$sel_arg"
                [ -z "$sel_ssid" ] && continue

                if [ "$sel_ssid" = "$active_ssid" ]; then
                    local act
                    act=$(printf "1. Disconnect\n2. Reconnect\n3. Forget Profile\n4. Show Info\n5. Monitor Dashboard\n6. Cancel" | fzf \
                        --prompt="$sel_ssid (Active) > " \
                        --reverse --height=48% --border=rounded) || true
                    case "$act" in
                        *"Disconnect"*) cmd_disconnect ;;
                        *"Reconnect"*) cmd_connect "$sel_ssid" ;;
                        *"Forget"*) cmd_forget "$sel_ssid" ;;
                        *"Show Info"*) cmd_status ;;
                        *"Monitor Dashboard"*) cmd_monitor ;;
                    esac
                    echo "Press enter to continue..."
                    read -r
                else
                    cmd_connect "$sel_ssid"
                    echo "Press enter to continue..."
                    read -r
                fi
                ;;
        esac
    done
}

cmd_help() {
    cat << EOF
${BOLD}wifi${RESET} - Terminal Wi-Fi Connection & Monitoring Manager

${BOLD}USAGE:${RESET}
    wifi                         Launch interactive fzf menu with live preview
    wifi status | s | info       Display detailed connection, IP, signal & hardware info
    wifi list | scan | l         Scan and list nearby Wi-Fi networks with signal bars
    wifi monitor | watch | m     Live continuous Wi-Fi monitor dashboard (like Impala)
    wifi preview <SSID>          Inspect detailed parameters of a network
    wifi connect <SSID> [pass]   Connect to a Wi-Fi network
    wifi disconnect | d          Disconnect from current Wi-Fi
    wifi saved                   List saved Wi-Fi profiles
    wifi forget [SSID]           Delete a saved Wi-Fi profile
    wifi hidden                  Connect to a hidden Wi-Fi network
    wifi on | off | toggle       Turn Wi-Fi radio ON or OFF
    wifi tui                     Open NetworkManager TUI (nmtui)
    wifi help | -h               Show this help message

${BOLD}INTERACTIVE HOTKEYS (inside fzf menu):${RESET}
    ${CYAN}Enter${RESET}   Select / Connect / Manage network
    ${CYAN}Ctrl-R${RESET}  Rescan nearby networks immediately
    ${CYAN}Ctrl-C${RESET}  Quick Connect to highlighted network
    ${CYAN}Ctrl-D${RESET}  Disconnect from active network
    ${CYAN}Ctrl-S${RESET}  Open Saved Networks Manager
    ${CYAN}Ctrl-W${RESET}  Toggle Wi-Fi radio ON / OFF
    ${CYAN}Ctrl-M${RESET}  Open Live Wi-Fi Monitor Dashboard
    ${CYAN}Esc${RESET}     Exit

EOF
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------

case "${1:-}" in
    status|s|info)
        cmd_status
        ;;
    list|scan|l)
        cmd_scan
        ;;
    monitor|watch|m)
        cmd_monitor
        ;;
    preview)
        shift
        cmd_preview "$@"
        ;;
    connect|c)
        shift
        cmd_connect "$@"
        ;;
    disconnect|d|down)
        cmd_disconnect
        ;;
    saved|profiles)
        cmd_saved
        ;;
    forget|delete|rm)
        shift
        cmd_forget "$@"
        ;;
    hidden)
        cmd_hidden
        ;;
    on)
        nmcli radio wifi on
        echo -e "${GREEN}Wi-Fi turned ON.${RESET}"
        ;;
    off)
        nmcli radio wifi off
        echo -e "${YELLOW}Wi-Fi turned OFF.${RESET}"
        ;;
    toggle)
        cmd_toggle
        ;;
    tui)
        nmtui
        ;;
    help|-h|--help)
        cmd_help
        ;;
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            cmd_interactive
        else
            cmd_status
            echo ""
            cmd_help
        fi
        ;;
    *)
        cmd_connect "$@"
        ;;
esac
