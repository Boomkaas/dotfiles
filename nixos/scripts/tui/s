EOF
}

# Resolves command or alias to canonical script path
resolve_tool_script() {
    local query="$1"
    local canonical=""

    while IFS='|' read -r cmd cat icon title aliases desc; do
        [ -z "$cmd" ] && continue
        if [ "$query" = "$cmd" ]; then
            canonical="$cmd"
            break
        fi
        IFS=',' read -ra alias_arr <<< "$aliases"
        for a in "${alias_arr[@]}"; do
            local clean_a
            clean_a="$(echo "$a" | tr -d ' ')"
            if [ "$query" = "$clean_a" ]; then
                canonical="$cmd"
                break 2
            fi
        done
    done < <(get_tool_registry)

    if [ -n "$canonical" ] && [ -f "$TUI_DIR/$canonical" ]; then
        echo "$TUI_DIR/$canonical"
        return 0
    fi
    return 1
}

