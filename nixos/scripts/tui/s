# ------------------------------------------------------------------------------
# Main Dispatch
# ------------------------------------------------------------------------------
case "${1:-}" in
    list|ls) cmd_list ;;
    preview) cmd_preview "$2" ;;
    help|--help|-h) cmd_help ;;
    "")
        if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
            cmd_interactive
        else
            cmd_list
        fi
        ;;
    *)
        # Check if argument is a registered tool or alias
        target_script=$(resolve_tool_script "$1")
        if [ -n "$target_script" ]; then
            shift
            exec "$target_script" "$@"
        else
            echo -e "${RED}✘ Unknown tool or command:${RESET} $1"
            echo -e "${DIM}Run 's list' or 's help' to see all 22 available tools.${RESET}"
            exit 1
        fi
        ;;
esac
