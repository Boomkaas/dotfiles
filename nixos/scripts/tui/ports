#!/usr/bin/env bash
# ==============================================================================
# ports - Live Listening Ports, Sockets & Dev Server Controller (CLI & fzf TUI)
# Scan active TCP/UDP ports, identify listening processes, test endpoints & kill.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

notify() {
    local urgency="${1:-normal}"
    local icon="${2:-network-wired}"
    local title="$3"
    local msg="$4"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -i "$icon" "$title" "$msg" -t 2500
    fi
}

# ------------------------------------------------------------------------------
# Data Parsers
# ------------------------------------------------------------------------------

# Returns: PROTO<TAB>STATE<TAB>PORT<TAB>LOCAL_ADDR<TAB>PID<TAB>PROCESS<TAB>USER
get_sockets() {
    local scope="${1:-listening}"
    local ss_flags="-tulpn"
    [ "$scope" = "all" ] && ss_flags="-tuapn"
    [ "$scope" = "established" ] && ss_flags="-tuan state established"

    # Use ss command
    ss $ss_flags 2>/dev/null | tail -n +2 | while read -r proto state recvq sendq local peer users; do
        [ -z "$local" ] && continue

        # Extract port from local address: e.g. 127.0.0.1:8080 or [::]:22 or *:53
        local port=""
        local ip=""
        if [[ "$local" =~ :([0-9]+)$ ]]; then
            port="${BASH_REMATCH[1]}"
            ip="${local%:${port}}"
        else
            continue
        fi

        local pid="-"
        local pname="-"
        if [ -n "$users" ]; then
            if [[ "$users" =~ \"([^\"]+)\",pid=([0-9]+) ]]; then
                pname="${BASH_REMATCH[1]}"
                pid="${BASH_REMATCH[2]}"
            elif [[ "$users" =~ pid=([0-9]+) ]]; then
                pid="${BASH_REMATCH[1]}"
            fi
        fi

        # If PID is known, find owner user
        local owner="-"
        if [ "$pid" != "-" ] && [ -d "/proc/$pid" ]; then
            owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d '[:space:]')
        elif [ "$pid" = "-" ]; then
            # Guess known system service names based on standard ports
            case "$port" in
                5432) pname="postgresql"; owner="postgres" ;;
                631) pname="cupsd"; owner="root" ;;
                22) pname="sshd"; owner="root" ;;
                53) pname="systemd-resolved"; owner="systemd-resolve" ;;
                67|68) pname="dhcpcd"; owner="root" ;;
                137|138|139|445) pname="samba"; owner="root" ;;
                5353) pname="avahi-daemon"; owner="avahi" ;;
            esac
        fi

        echo -e "${proto}\t${state}\t${port}\t${ip}\t${pid}\t${pname}\t${owner}"
    done
}

# ------------------------------------------------------------------------------
# Actions
# ------------------------------------------------------------------------------

cmd_kill() {
    local pid="$1"
    local sig="${2:-15}"
    [ -z "$pid" ] || [ "$pid" = "-" ] && return 1

    local pname
    pname=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d '[:space:]')
    local sig_name="SIGTERM"
    [ "$sig" = "9" ] && sig_name="SIGKILL"

    echo -e "${YELLOW}Sending ${sig_name} to PID ${pid} (${pname})...${RESET}"
    if kill -"${sig}" "$pid" 2>/dev/null; then
        notify "normal" "process-stop" "Ports Controller" "Sent ${sig_name} to ${pname} (PID: ${pid})"
    elif sudo kill -"${sig}" "$pid" 2>/dev/null; then
        notify "normal" "process-stop" "Ports Controller" "Sent ${sig_name} (as root) to ${pname} (PID: ${pid})"
    else
        notify "critical" "dialog-error" "Ports Controller" "Failed to kill process PID: ${pid}"
    fi
}

cmd_curl_test() {
    local port="$1"
    local ip="${2:-127.0.0.1}"
    [ "$ip" = "*" ] || [ "$ip" = "0.0.0.0" ] || [ "$ip" = "[::]" ] && ip="127.0.0.1"

    clear
    echo -e "${BOLD}${CYAN}Testing HTTP Connection to http://${ip}:${port}...${RESET}\n"
    if command -v curl >/dev/null 2>&1; then
        curl -Iv -m 3 "http://${ip}:${port}" 2>&1 | head -n 35
    else
        echo -e "${RED}curl not found.${RESET}"
    fi
    echo ""
    echo -ne "${BOLD}Press Enter to return...${RESET}"
    read -r
}

cmd_open_browser() {
    local port="$1"
    local ip="${2:-127.0.0.1}"
    [ "$ip" = "*" ] || [ "$ip" = "0.0.0.0" ] || [ "$ip" = "[::]" ] && ip="127.0.0.1"
    local url="http://${ip}:${port}"

    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
        notify "normal" "web-browser" "Port Opened" "Opened $url in browser"
    fi
}

# ------------------------------------------------------------------------------
# Preview Handler
# ------------------------------------------------------------------------------

cmd_preview() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${DIM}Select a listening port or socket to inspect details.${RESET}"
        return 0
    fi

    case "$target" in
        action:toggle_scope)
            cat <<EOF
${BOLD}${CYAN}Socket Scope Filtering${RESET}
Cycle through socket categories:
  • ${BOLD}listening${RESET}   - Listening TCP/UDP servers & daemons
  • ${BOLD}established${RESET} - Active established connections (incoming/outgoing)
  • ${BOLD}all${RESET}         - All sockets and network streams

${DIM}Shortcut:${RESET} Press ${BOLD}TAB${RESET} at any time.
EOF
            return 0
            ;;
    esac

    local proto state port ip pid pname user
    IFS=':' read -r proto state port ip pid pname user <<< "$target"

    echo -e "${BOLD}🌐 Network Socket:${RESET}   ${proto^^} Port ${BOLD}${CYAN}${port}${RESET}"
    echo -e "${BOLD}📍 Bind Address:${RESET}     ${ip}:${port}"
    echo -e "${BOLD}⚡ Socket State:${RESET}     ${state}"
    echo -e "${BOLD}⚙️  Process Name:${RESET}     ${BOLD}${pname}${RESET}"
    echo -e "${BOLD}🆔 Process PID:${RESET}      ${pid}"
    echo -e "${BOLD}👤 Running User:${RESET}     ${user}"
    echo "─────────────────────────────────────────────────────────────────────────────"

    if [ "$pid" != "-" ] && [ -d "/proc/$pid" ]; then
        echo -e "${CYAN}${BOLD}── Process Information ─────────────────────────────────────${RESET}"
        local exe cwd cmdline
        exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null || echo "restricted / system")
        cwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null || echo "unknown")
        cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-150 || echo "-")

        echo -e "${BOLD}Executable:${RESET}  $exe"
        echo -e "${BOLD}Directory:${RESET}   $cwd"
        echo -e "${BOLD}Command:${RESET}     $cmdline"
        echo ""

        echo -e "${MAGENTA}${BOLD}── Resource Usage ──────────────────────────────────────────${RESET}"
        ps -o pid,%cpu,%mem,vsz,rss,etime,stat,comm -p "$pid" 2>/dev/null || echo "Process stats unavailable"
        echo ""
    fi

    # Quick HTTP probe if TCP listening
    if [ "$proto" = "tcp" ] && [ "$state" = "LISTEN" ]; then
        echo -e "${YELLOW}${BOLD}── Quick Local HTTP Response Probe ─────────────────────────${RESET}"
        local probe_ip="$ip"
        [ "$probe_ip" = "*" ] || [ "$probe_ip" = "0.0.0.0" ] || [ "$probe_ip" = "[::]" ] && probe_ip="127.0.0.1"
        local header_resp
        header_resp=$(curl -I -s --max-time 1 "http://${probe_ip}:${port}" 2>/dev/null | head -n 6)
        if [ -n "$header_resp" ]; then
            echo "$header_resp"
        else
            echo -e "${DIM}No HTTP header response (might be raw TCP, binary protocol, or HTTPS)${RESET}"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Contextual Action Menu
# ------------------------------------------------------------------------------

show_action_menu() {
    local target="$1"
    local proto state port ip pid pname user
    IFS=':' read -r proto state port ip pid pname user <<< "$target"

    local acts=()
    acts+=("1. 🌐 Test HTTP Request (curl -I)")
    acts+=("2. 🔗 Open http://${ip}:${port} in Web Browser")
    if [ "$pid" != "-" ]; then
        acts+=("3. 🛑 Gracefully Terminate Process (SIGTERM / 15)")
        acts+=("4. 💀 Force Kill Process (SIGKILL / 9)")
    fi
    acts+=("5. 📋 Copy Port (${port}) to Clipboard")
    acts+=("6. 📋 Copy Local URL (http://${ip}:${port}) to Clipboard")
    acts+=("7. ✘  Cancel")

    local choice
    choice=$(printf "%s\n" "${acts[@]}" | fzf --prompt="Port [$port : $pname] > " --height=35% --reverse --border=rounded) || return 0

    case "$choice" in
        1*) cmd_curl_test "$port" "$ip" ;;
        2*) cmd_open_browser "$port" "$ip" ;;
        3*) cmd_kill "$pid" "15" ;;
        4*) cmd_kill "$pid" "9" ;;
        5*)
            command -v wl-copy >/dev/null 2>&1 && echo -n "$port" | wl-copy && notify "normal" "edit-copy" "Clipboard" "Copied port $port"
            ;;
        6*)
            local uip="$ip"
            [ "$uip" = "*" ] || [ "$uip" = "0.0.0.0" ] || [ "$uip" = "[::]" ] && uip="127.0.0.1"
            command -v wl-copy >/dev/null 2>&1 && echo -n "http://${uip}:${port}" | wl-copy && notify "normal" "edit-copy" "Clipboard" "Copied URL"
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Interactive Dashboard
# ------------------------------------------------------------------------------

cmd_interactive() {
    local self_bin
    self_bin="$(readlink -f "$0")"

    local current_scope="listening"
    local scopes=("listening" "established" "all")

    while true; do
        clear

        local sockets_raw
        sockets_raw=$(get_sockets "$current_scope")

        local sock_count=0
        [ -n "$sockets_raw" ] && sock_count=$(echo "$sockets_raw" | wc -l || echo "0")

        local scope_label
        case "$current_scope" in
            listening) scope_label="${CYAN}Listening Servers (${sock_count})${RESET}" ;;
            established) scope_label="${GREEN}Established (${sock_count})${RESET}" ;;
            all) scope_label="${MAGENTA}All Sockets (${sock_count})${RESET}" ;;
        esac

        local header_info="Scope: $scope_label | Total: $sock_count"

        # Next scope for Tab
        local next_scope="listening"
        for i in "${!scopes[@]}"; do
            if [ "${scopes[$i]}" = "$current_scope" ]; then
                local next_idx=$(( (i + 1) % ${#scopes[@]} ))
                next_scope="${scopes[$next_idx]}"
                break
            fi
        done

        local menu=()
        menu+=("󰌢  [TAB] Switch Scope (Next: ${next_scope})"$'\t'"action:toggle_scope")

        while IFS=$'\t' read -r proto state port ip pid pname user; do
            [ -z "$port" ] && continue

            local icon="󰒓"
            [ "$proto" = "tcp" ] && icon="🌐"
            [ "$proto" = "udp" ] && icon="📡"

            local label
            label=$(printf "%s  %-5s Port %-6s -> %-16s | %-16s (PID: %-6s)" "$icon" "${proto^^}" "$port" "${ip}:${port}" "$pname" "$pid")
            menu+=("${label}"$'\t'"${proto}:${state}:${port}:${ip}:${pid}:${pname}:${user}")
        done <<< "$sockets_raw"

        # Invoke fzf
        local res key choice
        res=$(printf "%s\n" "${menu[@]}" | fzf \
            --expect=ctrl-k,ctrl-x,ctrl-o,ctrl-t,ctrl-r,tab \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:48%:wrap \
            --prompt="Port ($current_scope) > " \
            --header="[$header_info] (Enter: Actions | Ctrl-K: Terminate | Ctrl-X: Force Kill | Ctrl-O: Open Browser | Ctrl-T: Curl | Tab: Filter | Esc: Exit)" \
            --reverse \
            --height=70% \
            --border=rounded \
            --cycle) || break

        [ -z "$res" ] && break
        key=$(echo "$res" | sed -n '1p')
        choice=$(echo "$res" | sed -n '2p')
        [ -z "$choice" ] && break

        local target_payload
        target_payload=$(echo "$choice" | cut -f2)

        # Tab scope switcher
        if [ "$key" = "tab" ] || [ "$target_payload" = "action:toggle_scope" ]; then
            current_scope="$next_scope"
            continue
        fi

        local proto state port ip pid pname user
        IFS=':' read -r proto state port ip pid pname user <<< "$target_payload"

        case "$key" in
            ctrl-k) cmd_kill "$pid" "15"; sleep 0.5; continue ;;
            ctrl-x) cmd_kill "$pid" "9"; sleep 0.5; continue ;;
            ctrl-o) cmd_open_browser "$port" "$ip"; continue ;;
            ctrl-t) cmd_curl_test "$port" "$ip"; continue ;;
            ctrl-r) continue ;;
        esac

        # Enter pressed
        show_action_menu "$target_payload"
    done
}

cmd_help() {
    cat <<EOF
${BOLD}ports${RESET} - Live Listening Ports, Sockets & Dev Server Controller (CLI & fzf TUI)

${BOLD}USAGE:${RESET}
    ports                           Launch interactive fzf ports & sockets dashboard
    ports list [scope]              List active sockets in table format (listening|established|all)
    ports kill <pid> [sig]          Terminate process holding port (default: 15 / SIGTERM)
    ports test <port> [ip]          Perform HTTP curl probe against local port
    ports preview <target>          Internal preview generator for fzf
    ports help                      Show this help message

${BOLD}INTERACTIVE HOTKEYS (inside fzf menu):${RESET}
    ${CYAN}Enter${RESET}       Open contextual action menu (Curl, Browser, Kill, Copy)
    ${CYAN}Ctrl-K${RESET}      Gracefully terminate process (SIGTERM)
    ${CYAN}Ctrl-X${RESET}      Force kill process immediately (SIGKILL)
    ${CYAN}Ctrl-O${RESET}      Open local port in web browser
    ${CYAN}Ctrl-T${RESET}      Test HTTP connection with curl -I
    ${CYAN}Ctrl-R${RESET}      Refresh active socket list
    ${CYAN}Tab${RESET}         Cycle scope filter (listening -> established -> all)
    ${CYAN}Esc / Ctrl-C${RESET} Exit dashboard

EOF
}

# ------------------------------------------------------------------------------
# Main Dispatch
# ------------------------------------------------------------------------------

case "${1:-}" in
    list|ls)
        printf "%-6s %-12s %-8s %-22s %-8s %-18s %s\n" "PROTO" "STATE" "PORT" "LOCAL ADDR" "PID" "PROCESS" "USER"
        echo "────────────────────────────────────────────────────────────────────────────────────────────"
        while IFS=$'\t' read -r proto state port ip pid pname user; do
            [ -z "$port" ] && continue
            printf "%-6s %-12s %-8s %-22s %-8s %-18s %s\n" "${proto^^}" "$state" "$port" "${ip}:${port}" "$pid" "$pname" "$user"
        done < <(get_sockets "${2:-listening}")
        ;;
    kill) cmd_kill "$2" "${3:-15}" ;;
    test|curl) cmd_curl_test "$2" "${3:-127.0.0.1}" ;;
    preview) cmd_preview "$2" ;;
    help|--help|-h) cmd_help ;;
    *)
        if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
            cmd_interactive
        else
            ss -tulpn
        fi
        ;;
esac
