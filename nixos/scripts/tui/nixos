#!/usr/bin/env bash
# ==============================================================================
# nixos - NixOS Generations, Flake & Rollback Manager (CLI & fzf TUI)
# Inspect system generations, closure diffs, rollback, flake inputs & cleanup.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

export FZF_DEFAULT_OPTS="--color=border:bright-black,prompt:green,pointer:red,marker:yellow,header:blue,info:yellow,hl:cyan,hl+:bright-red ${FZF_DEFAULT_OPTS:-}"

PROFILES_DIR="/nix/var/nix/profiles"
DOTFILES_DIR="/home/peng/Code/Dotfiles"
FLAKE_DIR="$DOTFILES_DIR/nixos"

notify() {
    local urgency="${1:-normal}"
    local icon="${2:-nix-snowflake}"
    local title="$3"
    local msg="$4"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -i "$icon" "$title" "$msg" -t 3000
    fi
}

# ------------------------------------------------------------------------------
# Helpers & State Getters
# ------------------------------------------------------------------------------

get_curr_gen() {
    local curr_link
    curr_link=$(readlink "$PROFILES_DIR/system" 2>/dev/null)
    if [[ "$curr_link" =~ system-([0-9]+)-link ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo ""
    fi
}

rel_time() {
    local target_ts="${1:-0}"
    local now_ts
    now_ts=$(date +%s)
    local diff=$(( now_ts - target_ts ))
    if [ "$diff" -lt 60 ]; then
        echo "Just now"
    elif [ "$diff" -lt 3600 ]; then
        echo "$(( diff / 60 ))m ago"
    elif [ "$diff" -lt 86400 ]; then
        echo "$(( diff / 3600 ))h ago"
    else
        local days=$(( diff / 86400 ))
        echo "${days}d ago"
    fi
}

# Returns lines: GEN<TAB>IS_CURR(1/0)<TAB>DATE_STR<TAB>REL_STR<TAB>LINK_PATH
parse_generations() {
    local curr_gen
    curr_gen=$(get_curr_gen)

    local entries=()
    for link in "$PROFILES_DIR"/system-*-link; do
        [ -e "$link" ] || continue
        [[ "$link" =~ system-([0-9]+)-link ]] || continue
        local g_num="${BASH_REMATCH[1]}"
        local ts
        ts=$(stat -c "%Y" "$link" 2>/dev/null || echo 0)
        entries+=("$ts $g_num $link")
    done

    # Sort descending by timestamp
    local sorted
    sorted=$(printf "%s\n" "${entries[@]}" | sort -nr -k1,1)

    while IFS=' ' read -r ts g_num link; do
        [ -z "$g_num" ] && continue
        local is_curr=0
        [ "$g_num" = "$curr_gen" ] && is_curr=1
        local d_str
        d_str=$(date -d "@$ts" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "Unknown")
        local r_str
        r_str=$(rel_time "$ts")
        echo -e "${g_num}\t${is_curr}\t${d_str}\t${r_str}\t${link}"
    done <<< "$sorted"
}

# ------------------------------------------------------------------------------
# Headless CLI Commands
# ------------------------------------------------------------------------------

cmd_list() {
    local curr_gen
    curr_gen=$(get_curr_gen)

    echo -e "${BOLD}${CYAN}=== NixOS System Generations ===${RESET}"
    echo -e "${DIM}Profile directory: $PROFILES_DIR${RESET}\n"

    printf " %-4s %-8s %-18s %-12s %s\n" " " "GEN" "BUILD DATE" "AGE" "NIXOS VERSION"
    echo -e "${DIM}──────────────────────────────────────────────────────────────────${RESET}"

    while IFS=$'\t' read -r g_num is_curr d_str r_str link; do
        [ -z "$g_num" ] && continue
        local mark=" "
        local color="$RESET"
        if [ "$is_curr" -eq 1 ]; then
            mark="*"
            color="${GREEN}${BOLD}"
        fi

        local n_ver="Unknown"
        [ -f "$link/nixos-version" ] && n_ver=$(cat "$link/nixos-version" 2>/dev/null)

        printf " ${color}%-2s  %-6s  %-18s %-12s %s${RESET}\n" "$mark" "Gen $g_num" "$d_str" "$r_str" "$n_ver"
    done < <(parse_generations)
}

cmd_current() {
    local curr_gen
    curr_gen=$(get_curr_gen)
    local link="$PROFILES_DIR/system-${curr_gen}-link"
    local ts d_str r_str n_ver k_ver
    ts=$(stat -c "%Y" "$link" 2>/dev/null || echo 0)
    d_str=$(date -d "@$ts" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "Unknown")
    r_str=$(rel_time "$ts")
    n_ver=$(cat "$link/nixos-version" 2>/dev/null || echo "Unknown")
    k_ver=$(readlink -f "$link/kernel" 2>/dev/null | grep -oP 'linux-\K[^/]+' || echo "Unknown")

    echo -e "${BOLD}${GREEN}Current Active Generation:${RESET} Generation ${BOLD}${curr_gen}${RESET}"
    echo -e "  ${BOLD}Built:${RESET}         $d_str ($r_str)"
    echo -e "  ${BOLD}NixOS Version:${RESET} $n_ver"
    echo -e "  ${BOLD}Kernel:${RESET}        $k_ver"
    echo -e "  ${BOLD}Store Path:${RESET}    $(readlink -f "$link")"
}

cmd_diff() {
    local target1="${1:-}"
    local target2="${2:-}"

    local curr_gen
    curr_gen=$(get_curr_gen)

    if [ -z "$target1" ]; then
        local prev_gen=$(( curr_gen - 1 ))
        echo -e "${CYAN}Comparing Generation $prev_gen -> Generation $curr_gen (Current):${RESET}\n"
        nix store diff-closures "$PROFILES_DIR/system-${prev_gen}-link" "$PROFILES_DIR/system" 2>/dev/null || {
            echo -e "${RED}Could not diff: generation $prev_gen not found.${RESET}" >&2
            return 1
        }
    elif [ -z "$target2" ]; then
        echo -e "${CYAN}Comparing Generation $target1 -> Current (Generation $curr_gen):${RESET}\n"
        nix store diff-closures "$PROFILES_DIR/system-${target1}-link" "$PROFILES_DIR/system" 2>/dev/null || {
            echo -e "${RED}Could not diff generation $target1 against current.${RESET}" >&2
            return 1
        }
    else
        echo -e "${CYAN}Comparing Generation $target1 -> Generation $target2:${RESET}\n"
        nix store diff-closures "$PROFILES_DIR/system-${target1}-link" "$PROFILES_DIR/system-${target2}-link" 2>/dev/null || {
            echo -e "${RED}Could not diff generations $target1 and $target2.${RESET}" >&2
            return 1
        }
    fi
}

cmd_switch() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${RED}Usage: nixos switch <gen_number>${RESET}" >&2
        return 1
    fi

    local link="$PROFILES_DIR/system-${target}-link"
    if [ ! -e "$link" ]; then
        echo -e "${RED}Error: Generation $target not found in $PROFILES_DIR${RESET}" >&2
        return 1
    fi

    echo -e "${YELLOW}Switching to Generation $target...${RESET}"
    if sudo "$link/bin/switch-to-configuration" switch; then
        notify normal "nix-snowflake" "NixOS Switched" "Switched to Generation $target"
        echo -e "${GREEN}Successfully switched to Generation $target.${RESET}"
    else
        echo -e "${RED}Failed to switch to Generation $target.${RESET}" >&2
        return 1
    fi
}

cmd_boot() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${RED}Usage: nixos boot <gen_number>${RESET}" >&2
        return 1
    fi

    local link="$PROFILES_DIR/system-${target}-link"
    if [ ! -e "$link" ]; then
        echo -e "${RED}Error: Generation $target not found in $PROFILES_DIR${RESET}" >&2
        return 1
    fi

    echo -e "${YELLOW}Setting Generation $target as boot default...${RESET}"
    if sudo "$link/bin/switch-to-configuration" boot; then
        notify normal "nix-snowflake" "NixOS Boot Default" "Generation $target set as next boot default"
        echo -e "${GREEN}Generation $target set as boot default for next reboot.${RESET}"
    else
        echo -e "${RED}Failed to set boot default to Generation $target.${RESET}" >&2
        return 1
    fi
}

cmd_rollback() {
    local curr_gen
    curr_gen=$(get_curr_gen)
    local prev_gen=$(( curr_gen - 1 ))

    local link="$PROFILES_DIR/system-${prev_gen}-link"
    if [ ! -e "$link" ]; then
        # Find latest generation before current
        local candidate=""
        while IFS=$'\t' read -r g_num _ _ _ _; do
            if [ "$g_num" -lt "$curr_gen" ]; then
                candidate="$g_num"
                break
            fi
        done < <(parse_generations)
        link="$PROFILES_DIR/system-${candidate}-link"
        prev_gen="$candidate"
    fi

    if [ -z "$prev_gen" ] || [ ! -e "$link" ]; then
        echo -e "${RED}Error: No previous generation found for rollback.${RESET}" >&2
        return 1
    fi

    echo -e "${YELLOW}Rolling back from Generation $curr_gen to Generation $prev_gen...${RESET}"
    if sudo "$link/bin/switch-to-configuration" switch; then
        notify normal "nix-snowflake" "NixOS Rollback Complete" "Rolled back to Generation $prev_gen"
        echo -e "${GREEN}Successfully rolled back to Generation $prev_gen.${RESET}"
    else
        echo -e "${RED}Rollback to Generation $prev_gen failed.${RESET}" >&2
        return 1
    fi
}

cmd_flake_info() {
    echo -e "${BOLD}${CYAN}=== Flake Metadata & Locked Inputs ===${RESET}"
    if [ -d "$FLAKE_DIR" ]; then
        nix flake metadata "$FLAKE_DIR"
    else
        echo -e "${RED}Flake directory not found at $FLAKE_DIR${RESET}" >&2
        return 1
    fi
}

cmd_sync_boot() {
    echo -e "${BOLD}${CYAN}=== Sync Bootloader Entries ===${RESET}"
    echo -e "${YELLOW}Updating bootloader to match current NixOS generations...${RESET}\n"
    if sudo "$PROFILES_DIR/system/bin/switch-to-configuration" boot; then
        notify normal "nix-snowflake" "Bootloader Synced" "Bootloader entries synced with current generations"
        echo -e "\n${GREEN}Bootloader successfully synced with current generations.${RESET}"
    else
        echo -e "\n${RED}Failed to sync bootloader entries.${RESET}" >&2
        return 1
    fi
}

cmd_clean_gc() {
    local keep="${1:-3}"
    echo -e "${BOLD}${CYAN}=== Nix Clean & Garbage Collection ===${RESET}"
    echo -e "${YELLOW}Deleting system generations older than latest +$keep and running nix-store --gc...${RESET}\n"

    sudo nix-env --profile "$PROFILES_DIR/system" --delete-generations "+$keep"
    sudo nix-store --gc

    echo -e "\n${YELLOW}Syncing bootloader entries with remaining generations...${RESET}"
    if sudo "$PROFILES_DIR/system/bin/switch-to-configuration" boot; then
        echo -e "${GREEN}Bootloader entries pruned and updated.${RESET}"
    else
        echo -e "${RED}Warning: Failed to update bootloader entries.${RESET}" >&2
    fi

    notify normal "user-trash" "Nix Cleaned" "Kept latest $keep generations; bootloader updated."
    echo -e "\n${GREEN}NixOS generations cleaned, store garbage collected, and bootloader synced.${RESET}"
}

cmd_optimise() {
    echo -e "${BOLD}${CYAN}=== Nix Store Optimisation ===${RESET}"
    echo -e "${YELLOW}Hardlinking identical store files to save disk space...${RESET}\n"
    nix-store --optimise
    echo -e "\n${GREEN}Nix store deduplicated and optimised successfully.${RESET}"
}

cmd_rebuild() {
    if [ -f "$DOTFILES_DIR/nixos/scripts/nixreb.sh" ]; then
        bash "$DOTFILES_DIR/nixos/scripts/nixreb.sh" "$@"
    else
        sudo nixos-rebuild switch --flake "$FLAKE_DIR#nixos" "$@"
    fi
}

cmd_dry_build() {
    echo -e "${CYAN}Evaluating flake dry-build ($FLAKE_DIR#nixos)...${RESET}"
    nixos-rebuild dry-build --flake "$FLAKE_DIR#nixos"
}

# ------------------------------------------------------------------------------
# Preview Function (for fzf side panel)
# ------------------------------------------------------------------------------

cmd_preview() {
    local target="$1"
    [ -z "$target" ] && return 0

    local type id
    type="${target%%:*}"
    id="${target#*:}"

    case "$type" in
        gen)
            local link="$PROFILES_DIR/system-${id}-link"
            if [ ! -e "$link" ]; then
                echo -e "${RED}Generation $id does not exist.${RESET}"
                return 0
            fi

            local curr_gen
            curr_gen=$(get_curr_gen)
            local is_curr=0
            [ "$id" = "$curr_gen" ] && is_curr=1

            local ts d_str r_str n_ver k_ver real_path
            ts=$(stat -c "%Y" "$link" 2>/dev/null || echo 0)
            d_str=$(date -d "@$ts" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "Unknown")
            r_str=$(rel_time "$ts")
            n_ver=$(cat "$link/nixos-version" 2>/dev/null || echo "Unknown")
            k_ver=$(readlink -f "$link/kernel" 2>/dev/null | grep -oP 'linux-\K[^/]+' || echo "Unknown")
            real_path=$(readlink -f "$link" 2>/dev/null)

            local status_badge="${DIM}Historical Generation${RESET}"
            if [ "$is_curr" -eq 1 ]; then
                status_badge="${GREEN}${BOLD}★ CURRENT ACTIVE GENERATION${RESET}"
            elif [ "$id" -eq "$(( curr_gen - 1 ))" ]; then
                status_badge="${YELLOW}${BOLD}↩ ROLLBACK TARGET (Previous)${RESET}"
            fi

            echo -e "${BOLD}${CYAN}=== NixOS Generation #$id ===${RESET}"
            echo -e "  ${BOLD}Status:${RESET}        $status_badge"
            echo -e "  ${BOLD}Built:${RESET}         $d_str ($r_str)"
            echo -e "  ${BOLD}NixOS Version:${RESET} $n_ver"
            echo -e "  ${BOLD}Kernel:${RESET}        $k_ver"
            echo -e "  ${BOLD}Store Path:${RESET}    ${DIM}$real_path${RESET}"

            local bin_count=0
            [ -d "$link/sw/bin" ] && bin_count=$(ls -1 "$link/sw/bin" 2>/dev/null | wc -l)
            echo -e "  ${BOLD}Binaries in SW:${RESET}$bin_count commands"
            echo ""

            # Closure Diff Section
            if [ "$is_curr" -eq 1 ]; then
                local prev_num=$(( id - 1 ))
                if [ -e "$PROFILES_DIR/system-${prev_num}-link" ]; then
                    echo -e "${BOLD}${CYAN}Package Changes (Gen $prev_num → Gen $id):${RESET}"
                    local diff_output
                    diff_output=$(nix store diff-closures "$PROFILES_DIR/system-${prev_num}-link" "$link" 2>/dev/null | head -n 6)
                    if [ -n "$diff_output" ]; then
                        echo -e "${DIM}$diff_output${RESET}"
                    else
                        echo -e "  ${DIM}No package changes detected.${RESET}"
                    fi
                else
                    echo -e "${DIM}Initial generation or previous link purged.${RESET}"
                fi
            else
                echo -e "${BOLD}${CYAN}Package Diff (Gen $id → Current Gen $curr_gen):${RESET}"
                local diff_output
                diff_output=$(nix store diff-closures "$link" "$PROFILES_DIR/system" 2>/dev/null | head -n 6)
                if [ -n "$diff_output" ]; then
                    echo -e "${DIM}$diff_output${RESET}"
                else
                    echo -e "  ${DIM}Identical to current generation.${RESET}"
                fi
            fi

            echo ""
            echo -e "${BOLD}Actions:${RESET} Enter: Actions | Ctrl-S: Switch | Ctrl-B: Boot Default | Ctrl-D: Diff"
            ;;

        action)
            case "$id" in
                rollback)
                    local curr_gen
                    curr_gen=$(get_curr_gen)
                    local prev_gen=$(( curr_gen - 1 ))
                    echo -e "${BOLD}${CYAN}=== Rollback to Previous Generation ===${RESET}"
                    echo -e "Rolls back running system and bootloader from Gen $curr_gen"
                    echo -e "to Generation $prev_gen."
                    echo ""
                    echo -e "  ${BOLD}Current:${RESET}  Gen $curr_gen"
                    echo -e "  ${BOLD}Rollback:${RESET} Gen $prev_gen"
                    echo -e "  ${BOLD}Command:${RESET}  sudo $PROFILES_DIR/system-$prev_gen-link/bin/switch-to-configuration switch"
                    ;;
                rebuild)
                    echo -e "${BOLD}${CYAN}=== Rebuild NixOS System (nixreb) ===${RESET}"
                    echo -e "Runs the system rebuild script: syncs dotfiles to /etc/nixos"
                    echo -e "and runs 'nixos-rebuild switch --flake /etc/nixos#nixos'."
                    echo ""
                    echo -e "  ${BOLD}Dotfiles:${RESET} $DOTFILES_DIR"
                    echo -e "  ${BOLD}Flake:${RESET}    $FLAKE_DIR#nixos"
                    ;;
                dry_build)
                    echo -e "${BOLD}${CYAN}=== Dry-Run Flake Evaluation ===${RESET}"
                    echo -e "Evaluates the NixOS Flake configuration without modifying"
                    echo -e "the active system, verifying syntax and buildability."
                    echo ""
                    echo -e "  ${BOLD}Command:${RESET} nixos-rebuild dry-build --flake $FLAKE_DIR#nixos"
                    ;;
                flake_info)
                    echo -e "${BOLD}${CYAN}=== Flake Inputs & Lock Metadata ===${RESET}"
                    echo -e "Inspects the locked git revisions, commit dates, and"
                    echo -e "dependency trees for nixpkgs, home-manager, mangowm, noctalia."
                    echo ""
                    echo -e "  ${BOLD}Hotkey:${RESET} ${CYAN}Ctrl-U${RESET}"
                    ;;
                clean_gc)
                    echo -e "${BOLD}${CYAN}=== Clean Old Generations & Garbage Collect ===${RESET}"
                    echo -e "Deletes historical system generations (keeping the 3 latest)"
                    echo -e "and frees disk space via nix-store --gc."
                    echo ""
                    echo -e "  ${BOLD}Hotkey:${RESET} ${CYAN}Ctrl-G${RESET}"
                    ;;
                sync_boot)
                    echo -e "${BOLD}${CYAN}=== Sync Bootloader Entries ===${RESET}"
                    echo -e "Re-installs the bootloader configuration (systemd-boot)"
                    echo -e "to prune deleted generations and sync entries with active profiles."
                    echo ""
                    echo -e "  ${BOLD}Command:${RESET}  sudo $PROFILES_DIR/system/bin/switch-to-configuration boot"
                    ;;
                optimise)
                    echo -e "${BOLD}${CYAN}=== Deduplicate Nix Store ===${RESET}"
                    echo -e "Runs 'nix-store --optimise' to scan for identical files"
                    echo -e "across store paths and replace them with hard links."
                    ;;
            esac
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Interactive TUI Menu (fzf)
# ------------------------------------------------------------------------------

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        cmd_list
        return 0
    fi

    local self_bin="${BASH_SOURCE[0]}"

    while true; do
        clear
        local curr_gen
        curr_gen=$(get_curr_gen)
        local curr_link="$PROFILES_DIR/system-${curr_gen}-link"
        local curr_ts curr_r k_ver
        curr_ts=$(stat -c "%Y" "$curr_link" 2>/dev/null || echo 0)
        curr_r=$(rel_time "$curr_ts")
        k_ver=$(readlink -f "$curr_link/kernel" 2>/dev/null | grep -oP 'linux-\K[^/]+' || echo "Linux")

        local gen_count=0
        local raw_gens
        raw_gens=$(parse_generations)
        [ -n "$raw_gens" ] && gen_count=$(echo "$raw_gens" | grep -c '^[0-9]' || echo "0")

        local header_info="Active: Gen $curr_gen ($curr_r) | Kernel: $k_ver | Total: $gen_count gens"

        local menu=()

        # System Generations
        while IFS=$'\t' read -r g_num is_curr d_str r_str link; do
            [ -z "$g_num" ] && continue
            local def_mark=""
            local tag=""
            if [ "$is_curr" -eq 1 ]; then
                def_mark=" ★"
                tag=" (Current)"
            elif [ "$g_num" -eq "$(( curr_gen - 1 ))" ]; then
                tag=" (Rollback)"
            fi
            menu+=("  Generation ${g_num}${tag} [${r_str}, ${d_str}]${def_mark}"$'\t'"gen:${g_num}")
        done <<< "$raw_gens"

        # System & Flake Actions
        menu+=("  Rollback to Previous Generation"$'\t'"action:rollback")
        menu+=("  Rebuild & Switch System (nixreb)"$'\t'"action:rebuild")
        menu+=("󰑓  Dry-run Flake Rebuild (dry-build)"$'\t'"action:dry_build")
        menu+=("󰘳  Flake Metadata & Inputs Info"$'\t'"action:flake_info")
        menu+=("󰚰  Clean Old Generations & Run GC"$'\t'"action:clean_gc")
        menu+=("󰌢  Sync Bootloader Entries"$'\t'"action:sync_boot")
        menu+=("󱂬  Optimise Nix Store (Deduplicate)"$'\t'"action:optimise")

        local res key choice
        res=$(printf "%s\n" "${menu[@]}" | fzf \
            --expect=ctrl-r,ctrl-d,ctrl-s,ctrl-b,ctrl-u,ctrl-g \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:52%:wrap \
            --prompt="  NixOS > " \
            --header="[$header_info] (Enter: Select | Ctrl-S: Switch | Ctrl-B: Boot | Ctrl-D: Diff | Ctrl-R: Refresh | Esc: Exit)" \
            --reverse \
            --height=100% \
            --border=rounded \
            --cycle) || break

        [ -z "$res" ] && break
        key=$(echo "$res" | sed -n '1p')
        choice=$(echo "$res" | sed -n '2p')
        [ -z "$choice" ] && break

        local sel_arg
        sel_arg=$(echo "$choice" | cut -f2)
        local item_type="${sel_arg%%:*}"
        local item_id="${sel_arg#*:}"

        # Global Hotkey Handlers
        case "$key" in
            ctrl-r)
                continue
                ;;
            ctrl-u)
                clear
                cmd_flake_info
                echo ""
                echo -ne "${BOLD}Press Enter to return to menu...${RESET}"
                read -r
                continue
                ;;
            ctrl-g)
                clear
                cmd_clean_gc 3
                echo ""
                echo -ne "${BOLD}Press Enter to return to menu...${RESET}"
                read -r
                continue
                ;;
            ctrl-d)
                if [ "$item_type" = "gen" ]; then
                    clear
                    cmd_diff "$item_id" | ${PAGER:-less}
                else
                    clear
                    cmd_diff | ${PAGER:-less}
                fi
                continue
                ;;
            ctrl-s)
                if [ "$item_type" = "gen" ]; then
                    clear
                    cmd_switch "$item_id"
                    echo ""
                    echo -ne "${BOLD}Press Enter to return to menu...${RESET}"
                    read -r
                fi
                continue
                ;;
            ctrl-b)
                if [ "$item_type" = "gen" ]; then
                    clear
                    cmd_boot "$item_id"
                    echo ""
                    echo -ne "${BOLD}Press Enter to return to menu...${RESET}"
                    read -r
                fi
                continue
                ;;
        esac

        # Enter pressed: context submenu or action
        case "$item_type" in
            gen)
                local act
                act=$(printf "1. Activate & Switch to this Generation (sudo)\n2. Set as Default for Next Boot (sudo)\n3. Test Generation without changing bootloader (sudo)\n4. View Full Package Diff in Pager\n5. List Installed Commands / Binaries\n6. Delete this Generation (sudo)\n7. Cancel" | fzf \
                    --prompt="Generation [$item_id] > " \
                    --height=48% \
                    --reverse \
                    --border=rounded) || continue
                case "$act" in
                    1*)
                        clear
                        cmd_switch "$item_id"
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    2*)
                        clear
                        cmd_boot "$item_id"
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    3*)
                        clear
                        echo -e "${YELLOW}Testing Generation $item_id temporarily...${RESET}"
                        sudo "$PROFILES_DIR/system-${item_id}-link/bin/switch-to-configuration" test
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    4*)
                        clear
                        cmd_diff "$item_id" | ${PAGER:-less}
                        ;;
                    5*)
                        clear
                        echo -e "${BOLD}${CYAN}Binaries in Generation $item_id:${RESET}"
                        ls -1 "$PROFILES_DIR/system-${item_id}-link/sw/bin" 2>/dev/null | ${PAGER:-less}
                        ;;
                    6*)
                        clear
                        echo -e "${YELLOW}Deleting Generation $item_id...${RESET}"
                        sudo nix-env --profile "$PROFILES_DIR/system" --delete-generations "$item_id"
                        echo -e "${GREEN}Generation $item_id deleted from profiles.${RESET}"
                        echo -e "\n${YELLOW}Syncing bootloader entries...${RESET}"
                        if sudo "$PROFILES_DIR/system/bin/switch-to-configuration" boot; then
                            echo -e "${GREEN}Bootloader entries updated.${RESET}"
                        else
                            echo -e "${RED}Warning: Failed to update bootloader entries.${RESET}" >&2
                        fi
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                esac
                ;;

            action)
                case "$item_id" in
                    rollback)
                        clear
                        cmd_rollback
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    rebuild)
                        clear
                        cmd_rebuild
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    dry_build)
                        clear
                        cmd_dry_build
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    flake_info)
                        clear
                        cmd_flake_info
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    clean_gc)
                        clear
                        cmd_clean_gc 3
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    sync_boot)
                        clear
                        cmd_sync_boot
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                    optimise)
                        clear
                        cmd_optimise
                        echo ""
                        echo -ne "${BOLD}Press Enter to return...${RESET}"
                        read -r
                        ;;
                esac
                ;;
        esac
    done
}

cmd_help() {
    cat <<EOF
${BOLD}nixos${RESET} - NixOS Generations, Flake & Rollback Manager (CLI & fzf TUI)

${BOLD}USAGE:${RESET}
    nixos                           Launch interactive fzf menu with live preview
    nixos list | gens               List all system generations with build dates
    nixos current                   Show active generation and kernel details
    nixos diff [gen1] [gen2]        Show package closure diff between generations
    nixos switch <gen>              Switch and activate specified generation (sudo)
    nixos boot <gen>                Set specified generation as next boot default (sudo)
    nixos rollback                  Rollback system to previous generation (sudo)
    nixos flake                     Display flake metadata and locked input revisions
    nixos dry-build                 Evaluate flake dry-run without building
    nixos rebuild                   Rebuild system from dotfiles (calls nixreb)
    nixos gc [keep]                 Clean old generations (default keep: 3) and run GC
    nixos sync-boot                 Sync bootloader entries with current generations (sudo)
    nixos optimise                  Deduplicate store paths using hard links
    nixos preview <target>          Internal preview generator for fzf
    nixos help                      Show this help message

${BOLD}INTERACTIVE HOTKEYS (inside fzf menu):${RESET}
    ${CYAN}Enter${RESET}       Select generation / open actions submenu
    ${CYAN}Ctrl-S${RESET}      Switch & activate selected generation (sudo)
    ${CYAN}Ctrl-B${RESET}      Set selected generation as next boot default (sudo)
    ${CYAN}Ctrl-D${RESET}      View full package closure diff in pager
    ${CYAN}Ctrl-U${RESET}      Show flake inputs metadata
    ${CYAN}Ctrl-G${RESET}      Clean old generations and garbage collect
    ${CYAN}Ctrl-R${RESET}      Refresh generations list
    ${CYAN}Esc / Ctrl-C${RESET} Exit menu

EOF
}

# ------------------------------------------------------------------------------
# Main Dispatch
# ------------------------------------------------------------------------------

case "${1:-}" in
    list|gens|generations) cmd_list ;;
    current|active) cmd_current ;;
    diff) shift; cmd_diff "$@" ;;
    switch) cmd_switch "$2" ;;
    boot) cmd_boot "$2" ;;
    rollback) cmd_rollback ;;
    flake|metadata) cmd_flake_info ;;
    dry-build|dry) cmd_dry_build ;;
    rebuild) shift; cmd_rebuild "$@" ;;
    gc|clean) cmd_clean_gc "${2:-3}" ;;
    sync-boot|boot-sync) cmd_sync_boot ;;
    optimise|optimize) cmd_optimise ;;
    preview) cmd_preview "$2" ;;
    help|--help|-h) cmd_help ;;
    *)
        if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
            cmd_interactive
        else
            cmd_list
        fi
        ;;
esac
