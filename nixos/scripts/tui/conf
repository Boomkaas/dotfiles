#!/usr/bin/env bash
# ==============================================================================
# conf - Terminal Dotfiles & Config Picker with Syntax Preview (CLI & fzf TUI)
# Browse, preview, diff, and edit configs across NixOS, Wayland, Shells & Apps.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

export FZF_DEFAULT_OPTS="--color=border:bright-black,prompt:green,pointer:red,marker:yellow,header:blue,info:yellow,hl:cyan,hl+:bright-red ${FZF_DEFAULT_OPTS:-}"

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/Code/Dotfiles}"
HAKUSPACE_DIR="${HAKUSPACE_DIR:-$HOME/hakuspace-control}"

notify() {
    local urgency="${1:-normal}"
    local icon="${2:-preferences-system}"
    local title="$3"
    local msg="$4"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -i "$icon" "$title" "$msg" -t 2500
    fi
}

open_in_editor() {
    local target="$1"
    if [ -z "$target" ]; then return 1; fi
    if [ -n "${EDITOR:-}" ]; then
        "$EDITOR" "$target"
    elif command -v zeditor >/dev/null 2>&1; then
        zeditor --wait "$target"
    elif command -v nano >/dev/null 2>&1; then
        nano "$target"
    elif command -v vi >/dev/null 2>&1; then
        vi "$target"
    else
        xdg-open "$target" 2>/dev/null &
    fi
}

open_in_ide() {
    local target="$1"
    if [ -z "$target" ]; then return 1; fi
    if command -v zeditor >/dev/null 2>&1; then
        zeditor "$target" >/dev/null 2>&1 &
        notify "normal" "zed" "Config IDE" "Opened in Zed: $(basename "$target")"
    elif command -v codex >/dev/null 2>&1; then
        codex "$target" >/dev/null 2>&1 &
        notify "normal" "codex" "Config IDE" "Opened in Codex: $(basename "$target")"
    elif command -v code >/dev/null 2>&1; then
        code "$target" >/dev/null 2>&1 &
        notify "normal" "code" "Config IDE" "Opened in VS Code: $(basename "$target")"
    else
        xdg-open "$target" >/dev/null 2>&1 &
        notify "normal" "preferences-system" "Config Manager" "Opened: $(basename "$target")"
    fi
}

open_in_fm() {
    local target="$1"
    local dir="$target"
    [ -f "$target" ] && dir="$(dirname "$target")"
    if [ ! -d "$dir" ]; then return 1; fi

    if command -v yazi >/dev/null 2>&1; then
        yazi "$dir"
    elif command -v thunar >/dev/null 2>&1; then
        thunar "$dir" >/dev/null 2>&1 &
    else
        xdg-open "$dir" >/dev/null 2>&1 &
    fi
}

copy_to_clipboard() {
    local text="$1"
    if command -v wl-copy >/dev/null 2>&1; then
        echo -n "$text" | wl-copy
        notify "normal" "edit-copy" "Clipboard" "Copied to clipboard: $text"
        echo -e "${GREEN}✔ Copied to clipboard:${RESET} $text"
    elif command -v xclip >/dev/null 2>&1; then
        echo -n "$text" | xclip -selection clipboard
        notify "normal" "edit-copy" "Clipboard" "Copied to clipboard: $text"
        echo -e "${GREEN}✔ Copied to clipboard:${RESET} $text"
    else
        echo -e "${YELLOW}Clipboard utility (wl-copy/xclip) not found.${RESET}"
    fi
}

# ------------------------------------------------------------------------------
# Inventory Definition
# ------------------------------------------------------------------------------
