#!/usr/bin/env bash
# ==============================================================================
# tailscale - Tailscale Mesh VPN Controller (CLI & fzf TUI)
# Connect/disconnect this device, inspect the tailnet, toggle subnet routes and
# control the tailscaled daemon. Reads use the unprivileged CLI; changes use sudo.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    YELLOW=$'\033[0;33m'
    CYAN=$'\033[0;36m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    YELLOW=''
    CYAN=''
    RESET=''
fi

# Ensure NixOS setuid wrapper (/run/wrappers/bin/sudo) takes precedence in PATH
export PATH="/run/wrappers/bin:$HOME/.local/bin:/run/current-system/sw/bin:$PATH"

export FZF_DEFAULT_OPTS="--color=border:bright-black,prompt:green,pointer:red,marker:yellow,header:blue,info:yellow,hl:cyan,hl+:bright-red ${FZF_DEFAULT_OPTS:-}"

# ------------------------------------------------------------------------------
# Privilege & Daemon Helpers
# ------------------------------------------------------------------------------

ensure_sudo() {
    [ -d "/run/wrappers/bin" ] && export PATH="/run/wrappers/bin:$PATH"
    if ! sudo -n true 2>/dev/null; then
        echo -e "${YELLOW}${BOLD}[sudo]${RESET} Privilege required to change Tailscale state."
        if [ -c /dev/tty ]; then
            sudo -v < /dev/tty || return 1
        else
            sudo -v || return 1
        fi
    fi
    return 0
}

daemon_active() {
    systemctl is-active --quiet tailscaled 2>/dev/null
}

# Full status JSON from the local daemon; empty when tailscaled is not running
ts_json() {
    daemon_active || return 0
    tailscale status --json 2>/dev/null
}

ts_field() {
    # ts_field <json> <jq filter> — read one value from the cached status JSON
    local json="$1" filter="$2"
    [ -n "$json" ] || return 0
    echo "$json" | jq -r "$filter // empty" 2>/dev/null
}

ts_backend_state() {
    local json="$1"
    if ! daemon_active; then
        echo "DAEMON OFF"
    elif [ -z "$json" ]; then
        echo "UNREACHABLE"
    else
        ts_field "$json" '.BackendState' | tr '[:lower:]' '[:upper:]'
    fi
}

ts_ipv4() {
    ts_field "$1" '[.Self.TailscaleIPs[]? | select(contains("."))] | first'
}

ts_tailnet() {
    ts_field "$1" '.CurrentTailnet.Name'
}

ts_peers_online() {
    ts_field "$1" '[.Peer[]? | select(.Online)] | length'
}

ts_peers_total() {
    ts_field "$1" '[.Peer[]?] | length'
}

# ------------------------------------------------------------------------------
# Actions
# ------------------------------------------------------------------------------

cmd_status() {
    local json state ip4 tailnet
    json=$(ts_json)
    state=$(ts_backend_state "$json")
    ip4=$(ts_ipv4 "$json")
    tailnet=$(ts_tailnet "$json")

    echo -e "${BOLD}Tailscale${RESET}"
    echo -e "  State:    ${CYAN}${state}${RESET}"
    echo -e "  IPv4:     ${ip4:--}"
    echo -e "  Tailnet:  ${tailnet:--}"
    echo -e "  Peers:    $(ts_peers_online "$json") online / $(ts_peers_total "$json") total"
}

cmd_peers() {
    local json
    json=$(ts_json)
    if [ -z "$json" ]; then
        echo -e "${DIM}tailscaled is not running — no peer list available.${RESET}"
        return 0
    fi
    echo "$json" | jq -r '.Peer // {} | to_entries[] | .value | "\(if .Online then "●" else "○" end)  \(.HostName)\t\(.TailscaleIPs[0] // "-")\t\(.OS // "-")"' 2>/dev/null \
        | column -t -s $'\t' 2>/dev/null || echo -e "${DIM}No peers in this tailnet.${RESET}"
}

cmd_up() {
    ensure_sudo || return 1
    daemon_active || sudo systemctl start tailscaled
    # Prints a login URL when the device needs authentication
    sudo tailscale up
}

cmd_down() {
    ensure_sudo || return 1
    sudo tailscale down
}

cmd_logout() {
    echo -e "${YELLOW}Log out removes this device from the tailnet until you log in again.${RESET}"
    read -r -p "Type 'yes' to log out: " answer
    [ "$answer" = "yes" ] || { echo "Cancelled."; return 0; }
    ensure_sudo || return 1
    sudo tailscale logout
}

cmd_routes() {
    local value="$1"
    case "$value" in
        on|off) ;;
        *) echo "usage: tailscale routes on|off" >&2; return 1 ;;
    esac
    ensure_sudo || return 1
    sudo tailscale set --accept-routes="$([ "$value" = on ] && echo true || echo false)"
}

cmd_daemon() {
    local action="$1"
    case "$action" in
        start|stop|restart) ;;
        *) echo "usage: tailscale daemon start|stop|restart" >&2; return 1 ;;
    esac
    ensure_sudo || return 1
    sudo systemctl "$action" tailscaled
}

# ------------------------------------------------------------------------------
# Preview Handler (fzf side panel)
# ------------------------------------------------------------------------------
cmd_preview() {
    local target="$1"
    case "$target" in
        status) cmd_status ;;
        peers)  cmd_peers ;;
        *)
            echo -e "${DIM}Select an action to see what it does.${RESET}"
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Interactive TUI Menu (fzf)
# ------------------------------------------------------------------------------
pause_return() {
    echo ""
    read -r -p "Press Enter to return to the menu..." _
}

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        cmd_status
        echo ""
        cmd_help
        return 0
    fi

    local self_bin="$0"
    [ -x "$self_bin" ] || self_bin="tailscale"

    while true; do
        clear 2>/dev/null || true
        local json state ip4 tailnet
        json=$(ts_json)
        state=$(ts_backend_state "$json")
        ip4=$(ts_ipv4 "$json")
        tailnet=$(ts_tailnet "$json")

        local header_info="State: $state | IPv4: ${ip4:--} | Tailnet: ${tailnet:--}"

        local menu=()

        case "$state" in
            RUNNING)
                menu+=("$(printf "✓ 🔗  Connected as %s\tstatus" "${ip4:--}")")
                menu+=("$(printf "  󰌙  Disconnect this device (tailscale down)\tdown")")
                menu+=("$(printf "  󰑓  Reconnect (tailscale up)\tup")")
                menu+=("$(printf "  󰒍  Accept subnet routes: ON\troutes_on")")
                menu+=("$(printf "  󰒎  Accept subnet routes: OFF\troutes_off")")
                menu+=("$(printf "  󰍛  Switch account / log out of tailnet\tlogout")")
                ;;
            NEEDSLOGIN|STOPPED|NOSTATE)
                menu+=("$(printf "○ 🔗  Not connected (%s)\tstatus" "$state")")
                menu+=("$(printf "  󰌘  Connect this device (tailscale up)\tup")")
                ;;
            *)
                menu+=("$(printf "○ 🔗  Tailscale: %s\tstatus" "$state")")
                ;;
        esac

        menu+=("$(printf "─────────────────────────────────────────\tsep1")")
        menu+=("$(printf "  󰍹  Show status\tstatus")")
        menu+=("$(printf "  󰛳  List peers in tailnet\tpeers")")

        if daemon_active; then
            menu+=("$(printf "  󰌙  Stop tailscaled daemon\tdaemon_stop")")
            menu+=("$(printf "  󰑓  Restart tailscaled daemon\tdaemon_restart")")
        else
            menu+=("$(printf "  󰌘  Start tailscaled daemon\tdaemon_start")")
        fi

        local res key choice
        res=$(printf "%s\n" "${menu[@]}" | fzf \
            --expect=ctrl-r \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:52%:wrap \
            --prompt="🔗  Tailscale > " \
            --header="[$header_info] (Enter: Select | Ctrl-R: Refresh | Esc: Exit)" \
            --reverse \
            --height=100% \
            --border=rounded \
            --cycle) || break

        [ -z "$res" ] && break
        key=$(echo "$res" | sed -n '1p')
        choice=$(echo "$res" | sed -n '2p')
        [ -z "$choice" ] && break

        [ "$key" = "ctrl-r" ] && continue

        local action_key
        action_key=$(echo "$choice" | cut -f2)

        case "$action_key" in
            status)
                cmd_status; pause_return ;;
            peers)
                cmd_peers; pause_return ;;
            up)
                cmd_up; pause_return ;;
            down)
                cmd_down; pause_return ;;
            logout)
                cmd_logout; pause_return ;;
            routes_on)
                cmd_routes on; pause_return ;;
            routes_off)
                cmd_routes off; pause_return ;;
            daemon_start)
                cmd_daemon start; pause_return ;;
            daemon_stop)
                cmd_daemon stop; pause_return ;;
            daemon_restart)
                cmd_daemon restart; pause_return ;;
            sep1)
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# CLI
# ------------------------------------------------------------------------------
cmd_help() {
    cat <<EOF
${BOLD}Tailscale Mesh VPN Controller${RESET}

Usage:
    tailscale                       Launch interactive fzf menu
    tailscale status                Show state, IPv4, tailnet and peer counts
    tailscale peers                 List peers in the tailnet
    tailscale up                    Connect this device (prints login URL if needed)
    tailscale down                  Disconnect this device (daemon keeps running)
    tailscale logout                Log out of the tailnet (asks for confirmation)
    tailscale routes on|off         Accept or ignore subnet routes from peers
    tailscale daemon start|stop|restart
                                    Control the tailscaled systemd service
    tailscale preview <target>      Internal preview generator for fzf
    tailscale help                  Show this help message

Setup: the daemon is enabled in nixos/modules/core/services.nix. Log in once with
'sudo tailscale up' after a rebuild.
EOF
}

case "${1:-}" in
    status)
        cmd_status ;;
    peers)
        cmd_peers ;;
    up)
        cmd_up ;;
    down)
        cmd_down ;;
    logout)
        cmd_logout ;;
    routes)
        cmd_routes "${2:-}" ;;
    daemon)
        cmd_daemon "${2:-}" ;;
    preview)
        cmd_preview "${2:-}" ;;
    help|-h|--help)
        cmd_help ;;
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            cmd_interactive
        else
            cmd_status
        fi
        ;;
    *)
        echo -e "${RED}Unknown command:${RESET} $1" >&2
        cmd_help >&2
        exit 1
        ;;
esac
