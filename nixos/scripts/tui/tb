cmd_status() {
    local active_con active_country
    active_con=$(get_active_con)
    active_country=$(get_active_country)
    local cur_mode
    cur_mode=$(get_mode)

    echo -e "${BOLD}${CYAN}=== TunnelBear VPN Status ===${RESET}"
    if [ -n "$active_con" ]; then
        local flag
        flag=$(country_to_flag "$active_country")
        echo -e "  ${BOLD}Connection:${RESET}     ${GREEN}● Connected${RESET}"
        echo -e "  ${BOLD}Server:${RESET}         $flag ${BOLD}${GREEN}$active_country${RESET} (${DIM}$active_con${RESET})"

        if [ "$cur_mode" = "split" ]; then
            echo -e "  ${BOLD}Routing Mode:${RESET}   ${GREEN}● Split Tunneling${RESET} (Per-App VPN; main internet stays direct)"
        else
            echo -e "  ${BOLD}Routing Mode:${RESET}   ${MAGENTA}● Full System VPN${RESET} (All system traffic routed through VPN)"
        fi

        local ip4_line gw_line
        ip4_line=$(nmcli -t -f IP4.ADDRESS con show "$active_con" 2>/dev/null | head -n 1 | cut -d: -f2)
        gw_line=$(nmcli -t -f IP4.GATEWAY con show "$active_con" 2>/dev/null | head -n 1 | cut -d: -f2)

        [ -n "$ip4_line" ]  && echo -e "  ${BOLD}VPN IPv4:${RESET}       $ip4_line"
        [ -n "$gw_line" ]   && echo -e "  ${BOLD}Gateway:${RESET}        $gw_line"

        if is_proxy_running; then
            local p_pid
            if systemctl --user is-active --quiet tunnelbear-proxy.service 2>/dev/null; then
                p_pid=$(systemctl --user show -p MainPID --value tunnelbear-proxy.service 2>/dev/null)
            else
                p_pid=$(cat "$PROXY_PID_FILE" 2>/dev/null)
            fi
            echo -e "  ${BOLD}Local Proxy:${RESET}    ${GREEN}● Active${RESET} (127.0.0.1:$PROXY_PORT, PID ${p_pid:-systemd})"
        else
            echo -e "  ${BOLD}Local Proxy:${RESET}    ${YELLOW}○ Inactive${RESET}"
        fi

        local app_count=0 app_names=()
        while IFS=$'\t' read -r a_name rest; do
            [ -n "$a_name" ] && app_names+=("$a_name") && ((app_count++)) || true
        done < <(py_apps list 2>/dev/null)
        if [ "$app_count" -gt 0 ]; then
            echo -e "  ${BOLD}Managed Apps:${RESET}   ${CYAN}${app_names[*]}${RESET} (${app_count} app$([ "$app_count" -gt 1 ] && echo "s") configured)"
        else
            echo -e "  ${BOLD}Managed Apps:${RESET}   ${DIM}None (run 'tb app add <name>' to add)${RESET}"
        fi

        # Calculate live session traffic if connected
        if [ -d "/sys/class/net/tun0" ]; then
            local rx tx cur_sess_mb
            rx=$(cat "/sys/class/net/tun0/statistics/rx_bytes" 2>/dev/null || echo 0)
            tx=$(cat "/sys/class/net/tun0/statistics/tx_bytes" 2>/dev/null || echo 0)
            cur_sess_mb=$(( (rx + tx) / (1024 * 1024) ))
            echo -e "  ${BOLD}Session Traffic:${RESET} ${CYAN}${cur_sess_mb} MB${RESET} (${DIM}rx: $((rx / (1024*1024)))MB / tx: $((tx / (1024*1024)))MB${RESET})"
        fi

        local sys_ip
        sys_ip=$(get_public_ip)
        if [ "$cur_mode" = "split" ]; then
            local vpn_ip
            vpn_ip=$(curl -s --max-time 2.5 -x "http://127.0.0.1:$PROXY_PORT" https://ipinfo.io/ip 2>/dev/null || echo "Unknown")
            echo -e "  ${BOLD}System IP:${RESET}      ${WHITE}$sys_ip${RESET} (Direct ISP)"
            echo -e "  ${BOLD}VPN App IP:${RESET}     ${CYAN}$vpn_ip${RESET} ($flag $active_country)"
        else
            echo -e "  ${BOLD}Public IP:${RESET}      ${CYAN}$sys_ip${RESET}"
        fi
    else
        echo -e "  ${BOLD}Connection:${RESET}     ${YELLOW}○ Disconnected${RESET}"
        echo -e "  ${BOLD}Public IP:${RESET}      ${DIM}$(get_public_ip)${RESET}"
    fi

    echo ""
    cmd_account
}

