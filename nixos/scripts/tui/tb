    cat <<EOF
${BOLD}${CYAN}tb${RESET} / ${BOLD}${CYAN}tunnelbear${RESET} — TunnelBear VPN Manager (CLI & fzf TUI)

${BOLD}USAGE:${RESET}
    tb [COMMAND] [ARGS...]
    tunnelbear [COMMAND] [ARGS...]

${BOLD}COMMANDS:${RESET}
    ${CYAN}(none)${RESET}                       Launch interactive fzf menu (sorted by usage)
    ${CYAN}run${RESET} <cmd> [args...]          Run any program/script exclusively through VPN
    ${CYAN}app${RESET} [list|add|remove]        Manage applications configured to use VPN
    ${CYAN}mode${RESET} [split|full]            Toggle Split Tunneling (per-app) vs Full System VPN
    ${CYAN}connect${RESET} <country>           Connect to a server (e.g. 'poland', 'us', 'japan')
    ${CYAN}disconnect${RESET}, ${CYAN}down${RESET}, ${CYAN}off${RESET}        Disconnect active VPN & record transferred data
    ${CYAN}status${RESET}                       Show connection state, routing mode, IPs, and quota
    ${CYAN}account${RESET}, ${CYAN}quota${RESET}, ${CYAN}info${RESET}         Display login status and remaining GB allowance
    ${CYAN}sync${RESET}, ${CYAN}refresh${RESET}                 Sync account quota & details from TunnelBear cloud
    ${CYAN}plan${RESET} [free|unlimited|<GB>]   Change subscription tier or monthly GB limit
    ${CYAN}list${RESET}, ${CYAN}ls${RESET} [--alpha]          List servers ranked by usage (or alphabetical)
    ${CYAN}proxy${RESET} [status|start|stop]    Manage local split-tunnel proxy daemon (127.0.0.1:10808)
    ${CYAN}login${RESET}, ${CYAN}auth${RESET}                    Save TunnelBear account email & password
    ${CYAN}logout${RESET}                       Remove saved credentials & clear profiles
    ${CYAN}update${RESET}                       Re-download latest server profiles from S3
    ${CYAN}help${RESET}, ${CYAN}-h${RESET}, ${CYAN}--help${RESET}             Show this help screen

${BOLD}INTERACTIVE HOTKEYS (inside fzf menu):${RESET}
    ${CYAN}Enter${RESET}   Connect / Select highlighted location or action
    ${CYAN}Ctrl-D${RESET}  Disconnect active VPN immediately
    ${CYAN}Ctrl-S${RESET}  View detailed VPN and proxy status
    ${CYAN}Ctrl-A${RESET}  Display account status & remaining data quota
    ${CYAN}Ctrl-R${RESET}  Refresh / sync live quota from TunnelBear cloud
    ${CYAN}Ctrl-L${RESET}  Log in / save TunnelBear account credentials
    ${CYAN}Ctrl-U${RESET}  Update / download latest server profiles from S3
    ${CYAN}Esc${RESET}     Exit menu

${BOLD}EXAMPLES:${RESET}
    tb status
    tb run claude
    tb run curl https://ipinfo.io/ip
    tb app add claude
    tb app list
    tb mode split
    tb connect poland
    tb disconnect
    tb account
    tb sync
EOF
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------

ACTION="${1:-}"
shift 2>/dev/null || true

case "$ACTION" in
    ""|menu)
        cmd_interactive
        ;;
    run|exec)
        cmd_run "$@"
        ;;
    app|apps)
        cmd_app "$@"
        ;;
    mode)
        cmd_mode "$@"
        ;;
    proxy)
        cmd_proxy "$@"
        ;;
    __proxy_daemon__)
        run_proxy_daemon "$@"
        ;;
    connect|up|on)
        cmd_connect "$*"
        ;;
    disconnect|down|off|stop)
        cmd_disconnect
        ;;
    status)
        cmd_status
        ;;
    account|quota|info)
        cmd_account "$*"
        ;;
    sync|refresh)
        cmd_sync
        ;;
    plan)
        cmd_plan "$*"
        ;;
    list|ls)
        cmd_list "$*"
        ;;
    login|auth)
        cmd_login
        ;;
    logout)
        cmd_logout
        ;;
    update)
        cmd_update
        ;;
    preview)
        cmd_preview "$*"
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        if [ -n "$ACTION" ]; then
            cmd_connect "$ACTION $*"
        else
            cmd_help
        fi
        ;;
esac
