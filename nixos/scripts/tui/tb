py_tracker() {
    python3 -c "
import json, os, sys, glob
from datetime import datetime

CONFIG_DIR = os.path.expanduser('~/.config/tunnelbear')
USAGE_FILE = os.path.join(CONFIG_DIR, 'usage.json')
AUTH_FILE = os.path.join(CONFIG_DIR, 'auth.txt')
OVPN_DIR = os.path.join(CONFIG_DIR, 'ovpn')

def load_data():
    data = {
        'plan': 'free',
        'monthly_quota_bytes': 2 * 1024 * 1024 * 1024, # 2 GB fallback default
        'used_bytes': 0,
        'countries': {}
    }
    if os.path.exists(USAGE_FILE):
        try:
            with open(USAGE_FILE) as f:
                data.update(json.load(f))
        except Exception:
            pass
    return data

def save_data(data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(USAGE_FILE, 'w') as f:
        json.dump(data, f, indent=2)

def sync_live(data, force=False):
    if not os.path.exists(AUTH_FILE):
        return data, False, 'No credentials file found'
    try:
        with open(AUTH_FILE) as f:
            user = f.readline().strip()
            pwd = f.readline().strip()
    except Exception as e:
        return data, False, str(e)
    if not user or not pwd:
        return data, False, 'Empty credentials'

    now_ts = datetime.now().timestamp()
    last_sync_ts = data.get('last_sync_ts', 0)
    if not force and (now_ts - last_sync_ts < 900) and 'remaining_bytes' in data:
        return data, True, 'Cached'

    try:
        import urllib.request, http.cookiejar, uuid
        cj = http.cookiejar.CookieJar()
        opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))

        token_url = 'https://prod-api-dashboard.tunnelbear.com/dashboard/web/v2/token'
        payload = json.dumps({
            'username': user,
            'password': pwd,
            'grant_type': 'password',
            'device': f'browser-{uuid.uuid4()}'
        }).encode('utf-8')

        common_headers = {
            'Content-Type': 'application/json',
            'Origin': 'https://www.tunnelbear.com',
            'Referer': 'https://www.tunnelbear.com/',
            'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0',
            'tunnelbear-app-id': 'com.tunnelbear.web',
            'tunnelbear-app-version': '1.0.0',
            'tunnelbear-platform': 'Firefox',
            'tunnelbear-platform-version': '130.0'
        }

        req = urllib.request.Request(token_url, data=payload, headers=common_headers)
        resp = opener.open(req, timeout=10)
        token_data = json.loads(resp.read().decode())
        token = token_data.get('access_token')
        if not token:
            return data, False, 'Token missing from response'

        csrf_token = resp.headers.get('tb-csrf-token', '')

        cookie_url = 'https://prod-api-dashboard.tunnelbear.com/dashboard/web/v2/tokenCookie'
        cookie_req = urllib.request.Request(cookie_url, data=b'{}', headers={
            'Authorization': f'Bearer {token}',
            **common_headers
        })
        cookie_resp = opener.open(cookie_req, timeout=10)
        if not csrf_token:
            csrf_token = cookie_resp.headers.get('tb-csrf-token', '')

        auth_headers = {
            'Authorization': f'Bearer {token}',
            'Origin': 'https://www.tunnelbear.com',
            'Referer': 'https://www.tunnelbear.com/',
            'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0',
            'tunnelbear-app-id': 'com.tunnelbear.web',
            'tunnelbear-app-version': '1.0.0',
            'tunnelbear-platform': 'Firefox',
            'tunnelbear-platform-version': '130.0'
        }
        if csrf_token:
            auth_headers['TB-CSRF-Token'] = csrf_token

        next_reset = ''
        try:
            acc_url = 'https://prod-api-dashboard.tunnelbear.com/dashboard/web/v2/account'
            acc_req = urllib.request.Request(acc_url, headers=auth_headers)
            acc_resp = opener.open(acc_req, timeout=10)
            acc_data = json.loads(acc_resp.read().decode())
            next_reset = acc_data.get('nextDataReset', '')
        except Exception:
            pass

        user_url = 'https://prod-api-core.tunnelbear.com/core/web/api/getUserDetails'
        user_req = urllib.request.Request(user_url, headers=auth_headers)
        user_resp = opener.open(user_req, timeout=10)
        user_data = json.loads(user_resp.read().decode())

        data_left = int(user_data.get('dataLeft', 0))
        data_cap = int(user_data.get('dataCap', 0))
        bear_type = user_data.get('bearType', 'Little TunnelBear')
        full_ver = str(user_data.get('fullVersion', '0')) == '1'

        data['email'] = user
        data['cloud_verified'] = True
        data['last_sync_ts'] = now_ts
        data['last_sync_str'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        data['bear_type'] = bear_type
        data['full_version'] = full_ver
        data['next_reset'] = next_reset
        if full_ver:
            data['plan'] = 'unlimited'
        elif data_cap > 0:
            data['plan'] = bear_type
            data['monthly_quota_bytes'] = data_cap
            data['remaining_bytes'] = data_left
            data['used_bytes'] = max(0, data_cap - data_left)

        save_data(data)
        return data, True, 'Success'
    except Exception as e:
        return data, False, str(e)

action = sys.argv[1] if len(sys.argv) > 1 else 'status'

if action == 'sync':
    d = load_data()
    d, ok, msg = sync_live(d, force=True)
    out = {'success': ok, 'message': msg}
    if ok:
        out.update({
            'email': d.get('email', ''),
            'bear_type': d.get('bear_type', ''),
            'remaining_bytes': d.get('remaining_bytes', 0),
            'quota_bytes': d.get('monthly_quota_bytes', 0),
            'next_reset': d.get('next_reset', '')
        })
    print(json.dumps(out))

elif action == 'get_quota_info':
    d = load_data()
    user = ''
    if os.path.exists(AUTH_FILE):
        try:
            with open(AUTH_FILE) as f:
                user = f.readline().strip()
        except Exception:
            pass

    force = (len(sys.argv) > 2 and sys.argv[2] == '--force')
    if user:
        d, ok, msg = sync_live(d, force=force)

    plan = d.get('plan', 'free')
    quota_b = d.get('monthly_quota_bytes', 2 * 1024**3)
    cloud_ver = d.get('cloud_verified', False)
    bear_type = d.get('bear_type', '')

    if 'remaining_bytes' in d:
        rem_b = d['remaining_bytes']
        used_b = max(0, quota_b - rem_b)
    else:
        used_b = d.get('used_bytes', 0)
        rem_b = max(0, quota_b - used_b)

    if plan == 'unlimited':
        rem_str = 'Unlimited'
        used_str = f'{used_b / (1024**2):.1f} MB' if used_b < 1024**3 else f'{used_b / (1024**3):.2f} GB'
        pct_left = 100.0
        bar = '[████████████████████] 100% (Unlimited)'
    else:
        rem_gb = rem_b / (1024**3)
        quota_gb = quota_b / (1024**3)
        used_gb = used_b / (1024**3)
        used_mb = used_b / (1024**2)
        pct_left = (rem_b / quota_b) * 100.0 if quota_b > 0 else 0.0

        filled = int((pct_left / 100.0) * 20)
        filled = max(0, min(20, filled))
        empty = 20 - filled
        bar = f'[{\"█\" * filled}{\"░\" * empty}] {pct_left:.1f}% left'
        rem_str = f'{rem_gb:.2f} GB left of {quota_gb:.2f} GB'
        used_str = f'{used_gb:.2f} GB' if used_gb >= 1.0 else f'{used_mb:.1f} MB'

    out = {
        'email': user,
        'logged_in': bool(user),
        'cloud_verified': cloud_ver,
        'bear_type': bear_type,
        'plan': plan,
        'quota_bytes': quota_b,
        'rem_bytes': rem_b,
        'used_bytes': used_b,
        'used_str': used_str,
        'rem_str': rem_str,
        'pct_left': pct_left,
        'bar': bar,
        'next_reset': d.get('next_reset', ''),
        'last_sync': d.get('last_sync_str', '')
    }
    print(json.dumps(out))

elif action == 'record_connect':
    country = sys.argv[2]
    d = load_data()
    c_info = d['countries'].setdefault(country, {'connections': 0, 'bytes': 0, 'last_used': ''})
    c_info['connections'] += 1
    c_info['last_used'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    save_data(d)

elif action == 'record_disconnect':
    country = sys.argv[2]
    session_bytes = int(sys.argv[3]) if len(sys.argv) > 3 else 0
    d = load_data()
    if session_bytes > 0:
        d['used_bytes'] = d.get('used_bytes', 0) + session_bytes
        if 'remaining_bytes' in d:
            d['remaining_bytes'] = max(0, d['remaining_bytes'] - session_bytes)
        c_info = d['countries'].setdefault(country, {'connections': 0, 'bytes': 0, 'last_used': ''})
        c_info['bytes'] = c_info.get('bytes', 0) + session_bytes
        save_data(d)

elif action == 'get_sorted_locations':
    # Returns tab-separated list: country \t conns \t bytes_str \t last_used \t ovpn_path
    d = load_data()
    usage = d.get('countries', {})
    files = glob.glob(os.path.join(OVPN_DIR, 'TunnelBear *.ovpn'))

    items = []
    for f in files:
        bn = os.path.basename(f)[:-5]
        country = bn.replace('TunnelBear ', '')
        u = usage.get(country, {})
        conns = u.get('connections', 0)
        bytes_val = u.get('bytes', 0)
        last_used = u.get('last_used', '')
        items.append((conns, last_used, bytes_val, country, f))

    # Sort: used first (by conns desc, then last_used desc), then unused alphabetically
    sort_mode = sys.argv[2] if len(sys.argv) > 2 else 'usage'
    if sort_mode == 'alpha':
        items.sort(key=lambda x: x[3].lower())
    else:
        items.sort(key=lambda x: (-x[0], -int(bool(x[1])), x[1], x[3].lower() if x[0] == 0 else ''))

    for conns, last_used, bytes_val, country, f in items:
        r_host = '--'
        r_port = '--'
        try:
            with open(f) as fp:
                for line in fp:
                    if line.startswith('remote '):
                        p = line.split()
                        r_host = p[1]
                        r_port = p[2]
                        break
        except Exception:
            pass

        if bytes_val >= 1024**3:
            b_str = f'{bytes_val / (1024**3):.2f} GB'
        elif bytes_val >= 1024**2:
            b_str = f'{bytes_val / (1024**2):.1f} MB'
        else:
            b_str = '0 MB'
        last_str = last_used if last_used else 'never'
        print(f'{country}\t{conns}\t{b_str}\t{last_str}\t{r_host}\t{r_port}\t{f}')

elif action == 'set_plan':
    new_plan = sys.argv[2].lower()
    d = load_data()
    if new_plan in ('unlimited', 'paid'):
        d['plan'] = 'unlimited'
        print('Plan updated to Unlimited')
    elif new_plan == 'free':
        d['plan'] = 'free'
        d['monthly_quota_bytes'] = 2 * 1024**3
        print('Plan updated to Free Tier (2.00 GB/month)')
    else:
        try:
            gb = float(new_plan.replace('gb', '').strip())
            d['plan'] = 'custom'
            d['monthly_quota_bytes'] = int(gb * 1024**3)
            print(f'Plan updated to Custom ({gb:.2f} GB/month)')
        except ValueError:
            print('Error: Invalid plan. Use \"free\", \"unlimited\", or a number of GB (e.g. \"5\")')
            sys.exit(1)
    save_data(d)
" "$@"
}

