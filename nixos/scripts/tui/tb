if action == 'list':
    apps = load_apps()
    for name, info in sorted(apps.items()):
        target = info.get('target', '')
        shim = info.get('shim', '')
        added = info.get('added_at', '')
        exists = os.path.exists(target)
        shim_ok = os.path.exists(shim)
        print(f'{name}\t{target}\t{shim}\t{exists}\t{shim_ok}\t{added}')

elif action == 'add':
    name = sys.argv[2]
    target = sys.argv[3]
    shim = sys.argv[4]
