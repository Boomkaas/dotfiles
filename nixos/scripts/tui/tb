ensure_configs() {
    mkdir -p "$OVPN_DIR"
    local count
    count=$(find "$OVPN_DIR" -maxdepth 1 -name "*.ovpn" 2>/dev/null | wc -l)
    if [ "$count" -lt 5 ]; then
        echo -e "${CYAN}TunnelBear server configurations not found in $OVPN_DIR.${RESET}"
        echo -e "${CYAN}Downloading official TunnelBear OpenVPN profiles...${RESET}"
        cmd_update
    fi
}

get_auth_user() {
    if [ -f "$AUTH_FILE" ]; then
        sed -n '1p' "$AUTH_FILE" | xargs
    fi
}

get_auth_pass() {
    if [ -f "$AUTH_FILE" ]; then
        sed -n '2p' "$AUTH_FILE" | xargs
    fi
}

ensure_auth() {
    local user pass
    user=$(get_auth_user)
    pass=$(get_auth_pass)
    if [ -n "$user" ] && [ -n "$pass" ]; then
        AUTH_USER="$user"
        AUTH_PASS="$pass"
        return 0
    fi

    echo -e "${YELLOW}TunnelBear account credentials required to connect.${RESET}"
    echo -e "${DIM}These will be used to authenticate with TunnelBear OpenVPN servers.${RESET}"
    echo ""
    read -rp "TunnelBear Account Email: " AUTH_USER
    if [ -z "$AUTH_USER" ]; then
        echo -e "${RED}Error: Email cannot be empty.${RESET}" >&2
        return 1
    fi

    read -rsp "TunnelBear Account Password: " AUTH_PASS
    echo ""
    if [ -z "$AUTH_PASS" ]; then
        echo -e "${RED}Error: Password cannot be empty.${RESET}" >&2
        return 1
    fi

    read -rp "Save credentials securely to $AUTH_FILE? [Y/n]: " save_opt
    if [[ ! "$save_opt" =~ ^[Nn]$ ]]; then
        mkdir -p "$CONFIG_DIR"
        printf "%s\n%s\n" "$AUTH_USER" "$AUTH_PASS" > "$AUTH_FILE"
        chmod 600 "$AUTH_FILE"
        echo -e "${GREEN}✓ Credentials saved with permissions 600.${RESET}"
    fi
    return 0
}

# ------------------------------------------------------------------------------
# Split Tunneling, Routing Mode & Proxy Helpers
# ------------------------------------------------------------------------------

get_mode() {
    if [ -f "$MODE_FILE" ]; then
        local m
        m=$(cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ "$m" = "split" ]; then
            echo "split"
            return 0
        fi
    fi
    echo "full"
}

get_tun_dev() {
    local con dev
    con=$(get_active_con)
    if [ -n "$con" ]; then
        dev=$(nmcli -t -f vpn.data con show "$con" 2>/dev/null | grep -o 'dev = [^,]*' | awk '{print $3}')
        if [ -n "$dev" ] && [ -d "/sys/class/net/$dev" ]; then
            echo "$dev"
            return 0
        fi
    fi
    for d in /sys/class/net/tun*; do
        if [ -d "$d" ]; then
            basename "$d"
            return 0
        fi
    done
    echo "tun0"
}

get_tun_ip() {
    local dev
    dev=$(get_tun_dev)
    local ip
    if [ -n "$dev" ] && [ -d "/sys/class/net/$dev" ]; then
        ip=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
        if [ -n "$ip" ]; then
            echo "$ip"
            return 0
        fi
    fi
    return 1
}

is_proxy_running() {
    if systemctl --user is-active --quiet tunnelbear-proxy.service 2>/dev/null; then
        return 0
    fi
    if [ -f "$PROXY_PID_FILE" ]; then
        local pid
        pid=$(cat "$PROXY_PID_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PROXY_PID_FILE"
    fi
    return 1
}

start_proxy() {
    if is_proxy_running; then
        return 0
    fi
    ensure_proxy_script
    if command -v systemd-run >/dev/null 2>&1 && [ -d "/run/user/$UID/systemd" ]; then
        systemd-run --user --unit=tunnelbear-proxy python3 "$PROXY_SCRIPT" >/dev/null 2>&1 || true
    else
        nohup python3 "$PROXY_SCRIPT" >/dev/null 2>&1 &
        local pid=$!
        disown "$pid" 2>/dev/null || true
        echo "$pid" > "$PROXY_PID_FILE"
    fi

    # Wait briefly for proxy to listen on PROXY_PORT
    local i=0
    while [ $i -lt 15 ]; do
        if python3 -c "import socket; s=socket.socket(); s.connect(('127.0.0.1', $PROXY_PORT)); s.close()" 2>/dev/null; then
            return 0
        fi
        sleep 0.1
        ((i++)) || true
    done
    return 0
}

stop_proxy() {
    if systemctl --user is-active --quiet tunnelbear-proxy.service 2>/dev/null; then
        systemctl --user stop tunnelbear-proxy.service 2>/dev/null || true
    fi
    if [ -f "$PROXY_PID_FILE" ]; then
        local pid
        pid=$(cat "$PROXY_PID_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$PROXY_PID_FILE"
    fi
}

ensure_bind_lib() {
    mkdir -p "$CONFIG_DIR"
    cat << 'EOF' > "$BIND_SRC"
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <errno.h>

static int (*real_connect)(int sockfd, const struct sockaddr *addr, socklen_t addrlen) = NULL;

int connect(int sockfd, const struct sockaddr *addr, socklen_t addrlen) {
    if (!real_connect) {
        real_connect = dlsym(RTLD_NEXT, "connect");
        if (!real_connect) {
            errno = EACCES;
            return -1;
        }
    }

    if (addr && addr->sa_family == AF_INET) {
        const struct sockaddr_in *dest_in = (const struct sockaddr_in *)addr;
        uint32_t dest_ip = ntohl(dest_in->sin_addr.s_addr);

        if ((dest_ip >> 24) != 127 && (dest_ip >> 24) != 255) {
            const char *bind_ip_str = getenv("TB_BIND_IP");
            const char *bind_dev_str = getenv("TB_BIND_DEV");
            if (bind_dev_str && *bind_dev_str) {
                setsockopt(sockfd, SOL_SOCKET, 25, bind_dev_str, strlen(bind_dev_str) + 1);
            } else {
                setsockopt(sockfd, SOL_SOCKET, 25, "tun0", 5);
            }
            if (bind_ip_str && *bind_ip_str) {
                struct sockaddr_in bound_addr;
                socklen_t bound_len = sizeof(bound_addr);
                if (getsockname(sockfd, (struct sockaddr *)&bound_addr, &bound_len) == 0) {
                    if (bound_addr.sin_addr.s_addr == INADDR_ANY) {
                        struct sockaddr_in local_addr;
                        memset(&local_addr, 0, sizeof(local_addr));
                        local_addr.sin_family = AF_INET;
                        local_addr.sin_port = 0;
                        if (inet_pton(AF_INET, bind_ip_str, &local_addr.sin_addr) > 0) {
                            bind(sockfd, (struct sockaddr *)&local_addr, sizeof(local_addr));
                        }
                    }
                }
            }
        }
    }

    return real_connect(sockfd, addr, addrlen);
}
EOF
    if command -v gcc >/dev/null 2>&1; then
        gcc -fPIC -shared -O2 "$BIND_SRC" -o "$BIND_LIB" -ldl 2>/dev/null || true
    fi
}

find_real_bin() {
    local target="$1"
    if [ -f "$target" ] && [ -x "$target" ]; then
        echo "$target"
        return 0
    fi
    local shim="$SHIM_DIR/$target"
    local p
    IFS=: read -ra dirs <<< "$PATH"
    for d in "${dirs[@]}"; do
        [ "$d" = "$SHIM_DIR" ] && continue
        if [ -x "$d/$target" ] && [ ! -d "$d/$target" ]; then
            echo "$d/$target"
            return 0
        fi
    done
    return 1
}

py_apps() {
