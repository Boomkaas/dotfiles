ensure_proxy_script() {
    mkdir -p "$CONFIG_DIR"
    cat << 'PYEOF' > "$PROXY_SCRIPT"
import socket, struct, fcntl, select, threading, sys, os, signal
from urllib.parse import urlparse

PORT = int(os.environ.get('TB_PROXY_PORT', 10808))

def get_tun_info():
    for ifname in ['tun0', 'tun1', 'tun2']:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            ip = socket.inet_ntoa(fcntl.ioctl(
                s.fileno(),
                0x8915, # SIOCGIFADDR
                struct.pack('256s', ifname[:15].encode('utf-8'))
            )[20:24])
            return ip, ifname
        except Exception:
            pass
        finally:
            s.close()
    try:
        for iface in os.listdir('/sys/class/net'):
            if iface.startswith('tun'):
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                try:
                    ip = socket.inet_ntoa(fcntl.ioctl(
                        s.fileno(),
                        0x8915,
                        struct.pack('256s', iface[:15].encode('utf-8'))
                    )[20:24])
                    return ip, iface
                except Exception:
                    pass
                finally:
                    s.close()
    except Exception:
        pass
    return None, None

def forward_duplex(sock1, sock2):
    sockets = [sock1, sock2]
    try:
        while sockets:
            rlist, _, _ = select.select(sockets, [], [], 60)
            if not rlist:
                break
            for s in list(rlist):
                if s not in sockets:
                    continue
                other = sock2 if s is sock1 else sock1
                try:
                    data = s.recv(16384)
                except Exception:
                    data = b''
                if not data:
                    try:
                        other.shutdown(socket.SHUT_WR)
                    except Exception:
                        pass
                    if s in sockets:
                        sockets.remove(s)
                else:
                    try:
                        other.sendall(data)
                    except Exception:
                        return
    except Exception:
        pass
    finally:
        try: sock1.close()
        except Exception: pass
        try: sock2.close()
        except Exception: pass

def handle_client(client):
    try:
        client.settimeout(10)
        first = client.recv(1)
        if not first:
            client.close()
            return
        client.settimeout(None)

        tun_ip, tun_dev = get_tun_info()
        if not tun_ip:
            client.close()
            return

        if first == b'\x05':
            # SOCKS5 Handshake
            nmethods = ord(client.recv(1))
            _ = client.recv(nmethods)
            client.sendall(b'\x05\x00') # No auth
            ver, cmd, _, atyp = client.recv(4)
            if atyp == 1:
                target_ip = socket.inet_ntoa(client.recv(4))
            elif atyp == 3:
                domain_len = ord(client.recv(1))
                target_ip = client.recv(domain_len).decode('utf-8', errors='ignore')
            else:
                client.close()
                return
            port_bytes = client.recv(2)
            target_port = int.from_bytes(port_bytes, 'big')

            remote = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            if tun_dev:
                try:
                    remote.setsockopt(socket.SOL_SOCKET, 25, tun_dev.encode('utf-8') + b'\0')
                except Exception:
                    pass
            remote.bind((tun_ip, 0))
            remote.connect((target_ip, target_port))
            client.sendall(b'\x05\x00\x00\x01\x00\x00\x00\x00\x00\x00')
            forward_duplex(client, remote)
        else:
            # HTTP / CONNECT
            line = first
            while not line.endswith(b'\r\n'):
                c = client.recv(1)
                if not c:
                    break
                line += c
            line_str = line.decode('iso-8859-1', errors='ignore')
            parts = line_str.strip().split()
            if not parts:
                client.close()
                return
            method = parts[0].upper()
            if method == 'CONNECT':
                host_port = parts[1].split(':')
                target_host = host_port[0]
                target_port = int(host_port[1]) if len(host_port) > 1 else 443
                while True:
                    hdr = b''
                    while not hdr.endswith(b'\r\n'):
                        c = client.recv(1)
                        if not c: break
                        hdr += c
                    if hdr == b'\r\n' or not hdr:
                        break
                remote = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                if tun_dev:
                    try:
                        remote.setsockopt(socket.SOL_SOCKET, 25, tun_dev.encode('utf-8') + b'\0')
                    except Exception:
                        pass
                remote.bind((tun_ip, 0))
                remote.connect((target_host, target_port))
                client.sendall(b'HTTP/1.1 200 Connection Established\r\n\r\n')
                forward_duplex(client, remote)
            else:
                parsed = urlparse(parts[1])
                target_host = parsed.hostname or parts[1]
                target_port = parsed.port or 80
                remote = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                if tun_dev:
                    try:
                        remote.setsockopt(socket.SOL_SOCKET, 25, tun_dev.encode('utf-8') + b'\0')
                    except Exception:
                        pass
                remote.bind((tun_ip, 0))
                remote.connect((target_host, target_port))
                remote.sendall(line)
                forward_duplex(client, remote)
    except Exception:
        try: client.close()
        except Exception: pass

srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('127.0.0.1', PORT))
srv.listen(100)

def sig_handler(sig, frame):
    try: srv.close()
    except Exception: pass
    sys.exit(0)

signal.signal(signal.SIGTERM, sig_handler)
signal.signal(signal.SIGINT, sig_handler)
try:
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
except Exception:
    pass

while True:
    try:
        c, _ = srv.accept()
        t = threading.Thread(target=handle_client, args=(c,))
        t.daemon = True
        t.start()
    except Exception:
        break
PYEOF
}

run_proxy_daemon() {
    ensure_proxy_script
    exec python3 "$PROXY_SCRIPT"
}

