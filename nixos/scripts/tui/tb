cmd_run() {
    if [ $# -eq 0 ]; then
        echo -e "${RED}Error: No command specified to run through VPN.${RESET}" >&2
        echo -e "${YELLOW}Usage:${RESET} tb run <command> [args...]"
        echo -e "       tb run curl https://ipinfo.io/ip"
        echo -e "       tb run claude"
        return 1
    fi

    # Check if TunnelBear is active
    local active_con
    active_con=$(get_active_con)
    if [ -z "$active_con" ]; then
        # Find last used country or default to Poland
        local last_country
        last_country=$(python3 -c "
import json, os
try:
    d = json.load(open('$USAGE_FILE'))
    items = [(v.get('last_used', ''), k) for k, v in d.get('countries', {}).items() if v.get('last_used')]
    items.sort(reverse=True)
    print(items[0][1] if items else 'Poland')
except Exception:
    print('Poland')
" 2>/dev/null || echo "Poland")

        echo -e "${YELLOW}🐻 TunnelBear VPN is not connected.${RESET}"
        echo -e "${CYAN}Establishing secure tunnel to $last_country (Split Tunneling)...${RESET}"
        mkdir -p "$CONFIG_DIR"
        echo "split" > "$MODE_FILE"
        if ! cmd_connect "$last_country"; then
            echo -e "${RED}Error: Failed to connect to VPN. Aborting command to prevent traffic leakage.${RESET}" >&2
            return 1
        fi
        active_con=$(get_active_con)
    fi

    # Ensure proxy daemon is running
    start_proxy

    # Ensure LD_PRELOAD socket binder library is built
    ensure_bind_lib

    local tun_ip tun_dev
    tun_ip=$(get_tun_ip)
    tun_dev=$(get_tun_dev)
    if [ -z "$tun_ip" ]; then
        echo -e "${RED}Error: Could not determine TunnelBear VPN IP address.${RESET}" >&2
        return 1
    fi

    local cmd="$1"
    shift

    # Resolve real binary path if an app name was given (prevents shim recursion)
    local real_bin
    real_bin=$(find_real_bin "$cmd")
    if [ -n "$real_bin" ]; then
        cmd="$real_bin"
    fi

    # Set proxy and socket binding environment variables
    export HTTP_PROXY="http://127.0.0.1:$PROXY_PORT"
    export HTTPS_PROXY="http://127.0.0.1:$PROXY_PORT"
    export ALL_PROXY="socks5h://127.0.0.1:$PROXY_PORT"
    export http_proxy="http://127.0.0.1:$PROXY_PORT"
    export https_proxy="http://127.0.0.1:$PROXY_PORT"
    export all_proxy="socks5h://127.0.0.1:$PROXY_PORT"
    export TB_BIND_IP="$tun_ip"
    export TB_BIND_DEV="${tun_dev:-tun0}"

    if [ -f "$BIND_LIB" ]; then
        if [ -n "${LD_PRELOAD:-}" ]; then
            export LD_PRELOAD="$BIND_LIB:$LD_PRELOAD"
        else
            export LD_PRELOAD="$BIND_LIB"
        fi
    fi

    exec "$cmd" "$@"
}

cmd_app() {
    local sub="${1:-}"
    shift 2>/dev/null || true

    case "$sub" in
        list|ls|"")
            cmd_app_list
            ;;
        add)
            cmd_app_add "$@"
            ;;
        remove|rm|del|delete)
            cmd_app_remove "$@"
            ;;
        *)
            echo -e "${RED}Unknown app command: '$sub'${RESET}" >&2
            echo -e "${YELLOW}Usage:${RESET} tb app list"
            echo -e "       tb app add <name_or_binary>"
            echo -e "       tb app remove <name>"
            return 1
            ;;
    esac
}

cmd_app_list() {
    echo -e "${BOLD}${CYAN}=== TunnelBear Managed VPN Applications ===${RESET}"
    printf "${BOLD}%-15s %-15s %-38s %s${RESET}\n" "APPLICATION" "STATUS" "TARGET BINARY" "SHIM LOCATION"
    echo -e "${DIM}-----------------------------------------------------------------------------------------${RESET}"

    local count=0
    while IFS=$'\t' read -r name target shim exists shim_ok added; do
        [ -z "$name" ] && continue
        local st
        if [ "$shim_ok" = "True" ] && [ "$exists" = "True" ]; then
            st="${GREEN}● Active${RESET}"
        elif [ "$shim_ok" = "True" ]; then
            st="${YELLOW}▲ Missing Target${RESET}"
        else
            st="${RED}○ Broken Shim${RESET}"
        fi
        printf "%-15s %-24b %-38s %s\n" "$name" "$st" "$target" "$shim"
        ((count++)) || true
    done < <(py_apps list)

    if [ "$count" -eq 0 ]; then
        echo -e "  ${DIM}No applications configured yet.${RESET}"
        echo -e "  Add an app with: ${CYAN}tb app add <name>${RESET} (e.g. ${CYAN}tb app add claude${RESET})"
    fi
    echo ""
    echo -e "${DIM}Commands: ${CYAN}tb app add <name>${DIM} | ${CYAN}tb app remove <name>${DIM} | ${CYAN}tb run <cmd>${RESET}"
}

cmd_app_add() {
    local target_input="${1:-}"
    if [ -z "$target_input" ]; then
        echo -e "${RED}Error: Specify an application name or path to add.${RESET}" >&2
        echo -e "${YELLOW}Usage:${RESET} tb app add <name_or_binary>"
        echo -e "       tb app add claude"
        return 1
    fi

    local real_bin
    real_bin=$(find_real_bin "$target_input")
    if [ -z "$real_bin" ]; then
        echo -e "${RED}Error: Could not find binary '$target_input' in PATH or filesystem.${RESET}" >&2
        return 1
    fi

    local app_name
    app_name=$(basename "$target_input")
    local shim_file="$SHIM_DIR/$app_name"

    mkdir -p "$SHIM_DIR"

    # If an existing file exists at shim_file that was NOT generated by TunnelBear, back it up
    if [ -f "$shim_file" ]; then
        if ! grep -q "Auto-generated by TunnelBear VPN Manager" "$shim_file" 2>/dev/null; then
            mv "$shim_file" "${shim_file}.bak"
            echo -e "${YELLOW}Notice: Backed up existing non-TunnelBear file to ${shim_file}.bak.${RESET}"
        fi
    fi

    local script_path
    script_path="$(readlink -f "${BASH_SOURCE[0]}")"

    cat << EOF > "$shim_file"
#!/usr/bin/env bash
# Auto-generated by TunnelBear VPN Manager (tb app)
# Target binary: $real_bin
exec "$script_path" run "$real_bin" "\$@"
EOF
    chmod +x "$shim_file"

    py_apps add "$app_name" "$real_bin" "$shim_file" >/dev/null 2>&1

    echo -e "${GREEN}✓ Application '${BOLD}$app_name${RESET}${GREEN}' configured to use TunnelBear VPN!${RESET}"
    echo -e "  ${BOLD}Target Binary:${RESET} $real_bin"
    echo -e "  ${BOLD}Shim Script:${RESET}   $shim_file"
    echo ""
    echo -e "${CYAN}Running '${BOLD}$app_name${RESET}${CYAN}' will now automatically route all network traffic through TunnelBear VPN.${RESET}"
    echo -e "${DIM}Test it with: ${CYAN}$app_name --version${RESET}"
}

cmd_app_remove() {
    local app_name="${1:-}"
    if [ -z "$app_name" ]; then
        echo -e "${RED}Error: Specify an application name to remove.${RESET}" >&2
        echo -e "${YELLOW}Usage:${RESET} tb app remove <name>"
        return 1
    fi

    local shim_file
    shim_file=$(py_apps remove "$app_name")

    if [ -z "$shim_file" ]; then
        shim_file="$SHIM_DIR/$app_name"
    fi

    if [ -f "$shim_file" ] && grep -q "Auto-generated by TunnelBear VPN Manager" "$shim_file" 2>/dev/null; then
        rm -f "$shim_file"
        echo -e "${GREEN}✓ Removed shim script: $shim_file${RESET}"
        if [ -f "${shim_file}.bak" ]; then
            mv "${shim_file}.bak" "$shim_file"
            echo -e "${GREEN}✓ Restored original file from ${shim_file}.bak.${RESET}"
        fi
    fi

    echo -e "${GREEN}✓ Removed '$app_name' from TunnelBear VPN management.${RESET}"
}

cmd_mode() {
    local target_mode="${1:-}"
    local cur_mode
    cur_mode=$(get_mode)

    if [ -z "$target_mode" ]; then
        echo -e "${BOLD}${CYAN}=== TunnelBear Routing Mode ===${RESET}"
        if [ "$cur_mode" = "split" ]; then
            echo -e "  ${BOLD}Current Mode:${RESET}   ${GREEN}● Split Tunneling (Per-App Routing)${RESET}"
            echo -e "  ${BOLD}Behavior:${RESET}       Default internet traffic bypasses VPN (uses your direct local ISP)."
            echo -e "                  Only apps executed with '${CYAN}tb run <cmd>${RESET}' or managed via '${CYAN}tb app${RESET}' use VPN."
        else
            echo -e "  ${BOLD}Current Mode:${RESET}   ${MAGENTA}● Full System VPN (All Traffic)${RESET}"
            echo -e "  ${BOLD}Behavior:${RESET}       ALL network traffic on this machine routes through the VPN."
        fi
        echo ""
        echo -e "${DIM}Switch mode: ${CYAN}tb mode split${DIM} (apps only) | ${CYAN}tb mode full${DIM} (all system traffic)${RESET}"
        return 0
    fi

    case "$target_mode" in
        split|app|apps)
            target_mode="split"
            ;;
        full|global|all)
            target_mode="full"
            ;;
        *)
            echo -e "${RED}Error: Invalid mode '$target_mode'. Choose 'split' or 'full'.${RESET}" >&2
            return 1
            ;;
    esac

    mkdir -p "$CONFIG_DIR"
    echo "$target_mode" > "$MODE_FILE"

    local active_con
    active_con=$(get_active_con)
    if [ -n "$active_con" ]; then
        echo -e "${CYAN}Applying $target_mode mode to active connection '$active_con'...${RESET}"
        local country="${active_con#TunnelBear }"
        local ovpn_file
        ovpn_file=$(find_ovpn "$country")
        local rem_host=""
        [ -n "$ovpn_file" ] && rem_host=$(awk '$1=="remote" { print $2; exit }' "$ovpn_file" 2>/dev/null)
        if [ "$target_mode" = "split" ]; then
            nmcli connection modify "$active_con" \
                connection.autoconnect no \
                $([ -n "$rem_host" ] && echo "+vpn.data remote=${rem_host}:443:udp4") \
                ipv4.never-default no \
                ipv4.route-table 51820 \
                ipv4.ignore-auto-dns yes \
                ipv4.routing-rules "priority 1000 from 172.18.0.0/16 table 51820, priority 1001 oif tun0 table 51820" \
                ipv6.method disabled >/dev/null 2>&1
            nmcli connection down id "$active_con" >/dev/null 2>&1 || true
            nmcli connection up id "$active_con" >/dev/null 2>&1 || true
            start_proxy
        else
            nmcli connection modify "$active_con" \
                connection.autoconnect no \
                $([ -n "$rem_host" ] && echo "+vpn.data remote=${rem_host}:443:udp4") \
                ipv4.never-default no \
                ipv4.route-table 0 \
                ipv4.ignore-auto-dns no \
                ipv4.routing-rules "" \
                ipv4.dns-priority -50 \
                ipv6.method disabled >/dev/null 2>&1
            nmcli connection down id "$active_con" >/dev/null 2>&1 || true
            nmcli connection up id "$active_con" >/dev/null 2>&1 || true
            stop_proxy
        fi
    fi

    echo -e "${GREEN}✓ TunnelBear routing mode set to: ${BOLD}$target_mode${RESET}"
    if [ "$target_mode" = "split" ]; then
        echo -e "  Split Tunneling enabled: system internet stays direct; use '${CYAN}tb run <cmd>${RESET}' or '${CYAN}tb app add <name>${RESET}' for VPN."
    else
        echo -e "  Full System VPN enabled: all system internet traffic now routes through VPN."
    fi
}

cmd_proxy() {
    local sub="${1:-status}"
    case "$sub" in
        status)
            if is_proxy_running; then
                local pid tun_ip
                if systemctl --user is-active --quiet tunnelbear-proxy.service 2>/dev/null; then
                    pid=$(systemctl --user show -p MainPID --value tunnelbear-proxy.service 2>/dev/null)
                else
                    pid=$(cat "$PROXY_PID_FILE" 2>/dev/null)
                fi
                tun_ip=$(get_tun_ip)
                echo -e "${GREEN}● Proxy Daemon is running${RESET}"
                echo -e "  ${BOLD}PID:${RESET}          ${pid:-systemd}"
                echo -e "  ${BOLD}Service:${RESET}      tunnelbear-proxy.service"
                echo -e "  ${BOLD}Listen:${RESET}       127.0.0.1:$PROXY_PORT (HTTP CONNECT & SOCKS5)"
                echo -e "  ${BOLD}Bound Tun IP:${RESET} ${tun_ip:-None (VPN disconnected)}"
            else
                echo -e "${YELLOW}○ Proxy Daemon is stopped.${RESET}"
            fi
            ;;
        start)
            start_proxy
            if is_proxy_running; then
                local pid
                if systemctl --user is-active --quiet tunnelbear-proxy.service 2>/dev/null; then
                    pid=$(systemctl --user show -p MainPID --value tunnelbear-proxy.service 2>/dev/null)
                else
                    pid=$(cat "$PROXY_PID_FILE" 2>/dev/null)
                fi
                echo -e "${GREEN}✓ Proxy Daemon started (PID: ${pid:-systemd}, port: $PROXY_PORT).${RESET}"
            else
                echo -e "${RED}✗ Failed to start Proxy Daemon.${RESET}" >&2
                return 1
            fi
            ;;
        stop)
            stop_proxy
            echo -e "${GREEN}✓ Proxy Daemon stopped.${RESET}"
            ;;
        restart)
            stop_proxy
            sleep 0.2
            start_proxy
            echo -e "${GREEN}✓ Proxy Daemon restarted.${RESET}"
            ;;
        *)
            echo -e "${YELLOW}Usage:${RESET} tb proxy [status|start|stop|restart]"
            ;;
    esac
}

cmd_preview() {
    local target="${1:-}"

    if [ -z "$target" ] || [[ "$target" == __action_* ]] || [[ "$target" == __divider__ ]] || [[ "$target" == __none__ ]]; then
        echo -e "${BOLD}${CYAN}=== TunnelBear Overview ===${RESET}"
        echo ""
        cmd_status
        echo ""
        echo -e "${BOLD}Keyboard Shortcuts in FZF:${RESET}"
        echo -e "  ${CYAN}Enter${RESET}   Connect / Select action"
        echo -e "  ${CYAN}Ctrl-D${RESET}  Disconnect active VPN"
        echo -e "  ${CYAN}Ctrl-S${RESET}  View status details"
        echo -e "  ${CYAN}Ctrl-A${RESET}  Account & Data Quota"
        echo -e "  ${CYAN}Ctrl-L${RESET}  Login / manage credentials"
        echo -e "  ${CYAN}Ctrl-U${RESET}  Update server configurations"
        echo -e "  ${CYAN}Esc${RESET}     Exit menu"
        return 0
    fi

    local ovpn_file
    ovpn_file=$(find_ovpn "$target" 2>/dev/null || true)
    if [ -z "$ovpn_file" ] || [ ! -f "$ovpn_file" ]; then
        echo -e "${YELLOW}No profile details found for $target.${RESET}"
        return 0
    fi

    local bname country con_name flag
    bname=$(basename "$ovpn_file" .ovpn)
    country="${bname#TunnelBear }"
    con_name="TunnelBear $country"
    flag=$(country_to_flag "$country")

    local active_con
    active_con=$(get_active_con)
    local is_active=0
    [ "$con_name" = "$active_con" ] && is_active=1

    echo -e "${BOLD}${CYAN}=== TunnelBear Location Details ===${RESET}"
    echo -e "  ${BOLD}Location:${RESET}     $flag ${BOLD}$country${RESET} $([ "$is_active" -eq 1 ] && echo -e "${GREEN}(Active / Connected)${RESET}")"
    echo -e "  ${BOLD}Profile:${RESET}      $con_name"

    # Fetch usage stats for this country
    local usage_str
    usage_str=$(python3 -c "
import json, os
try:
    d = json.load(open('$USAGE_FILE')).get('countries', {}).get('$country', {})
    conns = d.get('connections', 0)
    bytes_val = d.get('bytes', 0)
    last_u = d.get('last_used', 'Never')
    mb = bytes_val / (1024 * 1024)
    print(f'{conns}|{mb:.1f} MB|{last_u}')
except Exception:
    print('0|0 MB|Never')
")
    local u_conns u_mb u_last
    IFS='|' read -r u_conns u_mb u_last <<< "$usage_str"

    if [ "$u_conns" -gt 0 ]; then
        echo -e "  ${BOLD}Usage:${RESET}        ${YELLOW}★ Connected $u_conns time$([ "$u_conns" -gt 1 ] && echo "s") ($u_mb transferred)${RESET}"
        echo -e "  ${BOLD}Last Used:${RESET}    $u_last"
    else
        echo -e "  ${BOLD}Usage:${RESET}        ${DIM}Never connected before${RESET}"
    fi

    local r_host r_port r_proto
    r_host=$(grep -E '^\s*remote\s+' "$ovpn_file" | head -n 1 | awk '{print $2}')
    r_port=$(grep -E '^\s*remote\s+' "$ovpn_file" | head -n 1 | awk '{print $3}')
    r_proto=$(grep -E '^\s*proto\s+' "$ovpn_file" | head -n 1 | awk '{print $2}')
    local cipher
    cipher=$(grep -E '^\s*data-ciphers\s+' "$ovpn_file" | head -n 1 | cut -d' ' -f2-)
    [ -z "$cipher" ] && cipher=$(grep -E '^\s*cipher\s+' "$ovpn_file" | head -n 1 | awk '{print $2}')

    echo -e "  ${BOLD}Remote Host:${RESET}  ${r_host:---}"
    echo -e "  ${BOLD}Port/Proto:${RESET}   ${r_port:---} / ${r_proto:-udp}"
    echo -e "  ${BOLD}Cipher:${RESET}       ${cipher:-AES-256-CBC}"
    echo -e "  ${BOLD}CA Cert:${RESET}      ${GREEN}Embedded (Self-contained)${RESET}"

    echo ""
    echo -e "${BOLD}${CYAN}=== NetworkManager Status ===${RESET}"
    if nmcli connection show "$con_name" >/dev/null 2>&1; then
        echo -e "  ${BOLD}Imported:${RESET}     ${GREEN}Yes${RESET}"
        local vpn_user
        vpn_user=$(nmcli -t -f vpn.user-name con show "$con_name" 2>/dev/null | cut -d: -f2)
        [ -n "$vpn_user" ] && echo -e "  ${BOLD}User:${RESET}         $vpn_user"
    else
        echo -e "  ${BOLD}Imported:${RESET}     ${YELLOW}No (will auto-import on connect)${RESET}"
    fi

    if [ "$is_active" -eq 1 ]; then
        echo ""
        echo -e "${BOLD}${CYAN}=== Active Link ===${RESET}"
        local dev ip4
        dev=$(nmcli -t -f GENERAL.DEVICES con show "$con_name" 2>/dev/null | head -n 1 | cut -d: -f2)
        ip4=$(nmcli -t -f IP4.ADDRESS con show "$con_name" 2>/dev/null | head -n 1 | cut -d: -f2)
        echo -e "  ${BOLD}Device:${RESET}       $dev"
        echo -e "  ${BOLD}IPv4:${RESET}         $ip4"
    fi

    echo ""
    echo -e "${BOLD}Action:${RESET} Press ${CYAN}Enter${RESET} to $([ "$is_active" -eq 1 ] && echo "reconnect" || echo "connect to $country")"
}

# ------------------------------------------------------------------------------
# Interactive Menu (fzf TUI - Sorted by Usage!)
# ------------------------------------------------------------------------------

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        cmd_status
        echo ""
        cmd_list
        return 0
    fi

    ensure_configs
    local self_bin="${BASH_SOURCE[0]}"

    while true; do
        clear
        local active_con active_country header_info
        active_con=$(get_active_con)
        active_country=$(get_active_country)

        local q_info email logged_in rem_str
        q_info=$(py_tracker get_quota_info)
        email=$(python3 -c "import json, sys; d=json.loads(sys.argv[1]); print(d['email'])" "$q_info")
        logged_in=$(python3 -c "import json, sys; d=json.loads(sys.argv[1]); print(d['logged_in'])" "$q_info")
        rem_str=$(python3 -c "import json, sys; d=json.loads(sys.argv[1]); print(d['rem_str'])" "$q_info")

        if [ -n "$active_con" ]; then
            header_info="Connected: $active_country | Quota: $rem_str"
        elif [ "$logged_in" = "True" ]; then
            header_info="Logged In: $email | Quota: $rem_str"
        else
            header_info="Not Logged In | Quota: $rem_str"
        fi

        local cur_mode
        cur_mode=$(get_mode)
        local mode_label="Split Tunnel (Apps Only)"
        [ "$cur_mode" = "full" ] && mode_label="Full System VPN"

        local menu=()
        if [ -n "$active_con" ]; then
            menu+=("󰤮  Disconnect from \"$active_country\""$'\t'"__action_disconnect__")
        fi
        menu+=("󰢮  Detailed VPN Status"$'\t'"__action_status__")
        menu+=("󰌾  Account & Data Quota ($rem_str)"$'\t'"__action_account__")
        menu+=("󰑐  Sync Cloud Quota (TunnelBear API)"$'\t'"__action_sync__")
        menu+=("󰆼  Change Plan / Quota (Free / Unlimited)"$'\t'"__action_plan__")
        menu+=("󰘳  Manage VPN Applications (Per-App Split)"$'\t'"__action_apps__")
        menu+=("󰤨  Switch Routing Mode (Current: $mode_label)"$'\t'"__action_mode__")
        menu+=("󰉉  Update Server Configurations"$'\t'"__action_update__")
        menu+=("─────────────────────────────────────────────────────────────"$'\t'"__divider__")

        # Load countries sorted by usage!
        local loc_lines=()
        while IFS=$'\t' read -r country conns bytes_str last_used f; do
            [ -z "$country" ] && continue
            local con_name
            con_name="TunnelBear $country"

            local mark="  "
            if [ "$con_name" = "$active_con" ]; then
                mark="✓ "
            elif [ "$conns" -gt 0 ]; then
                mark="★ "
            fi

            local flag
            flag=$(country_to_flag "$country")

            local usage_tag=""
            if [ "$conns" -gt 0 ]; then
                usage_tag="[Used: ${conns}x • ${bytes_str}]"
            else
                usage_tag="[Never used]"
            fi

            local disp
            disp=$(printf "%s%s  %-23s %s" "$mark" "$flag" "$country" "$usage_tag")
            loc_lines+=("${disp}"$'\t'"${country}")
        done < <(py_tracker get_sorted_locations "usage")

        if [ ${#loc_lines[@]} -gt 0 ]; then
            for line in "${loc_lines[@]}"; do
                menu+=("$line")
            done
        else
            menu+=("--- No configurations found ---"$'\t'"__none__")
        fi

        local res key choice
        res=$(printf "%s\n" "${menu[@]}" | fzf \
            --expect=ctrl-d,ctrl-s,ctrl-a,ctrl-r,ctrl-l,ctrl-u \
            --delimiter=$'\t' \
            --with-nth=1 \
            --preview="$self_bin preview {2}" \
            --preview-window=right:52%:wrap \
            --prompt="🐻 TunnelBear > " \
            --header="[$header_info] (Enter: Connect | Ctrl-D: Disconnect | Ctrl-R: Sync | Ctrl-A: Account)" \
            --reverse \
            --height=100% \
            --border=rounded \
            --cycle) || break

        [ -z "$res" ] && break
        key=$(echo "$res" | sed -n '1p')
        choice=$(echo "$res" | sed -n '2p')
        [ -z "$choice" ] && break

        local sel_arg
        sel_arg=$(echo "$choice" | cut -f2)

        case "$key" in
            ctrl-d)
                cmd_disconnect
                sleep 1
                continue
                ;;
            ctrl-s)
                clear
                cmd_status
                echo ""
                read -rp "Press Enter to return..."
                continue
                ;;
            ctrl-r)
                clear
                cmd_sync
                echo ""
                read -rp "Press Enter to return..."
                continue
                ;;
            ctrl-a|ctrl-l)
                clear
                cmd_account
                echo ""
                read -rp "Press Enter to return..."
                continue
                ;;
            ctrl-u)
                clear
                cmd_update
                echo ""
                read -rp "Press Enter to return..."
                continue
                ;;
        esac

        case "$sel_arg" in
            __action_disconnect__)
                cmd_disconnect
                sleep 1
                ;;
            __action_status__)
                clear
                cmd_status
                echo ""
                read -rp "Press Enter to return..."
                ;;
            __action_account__)
                clear
                cmd_account
                echo ""
                read -rp "Press Enter to return..."
                ;;
            __action_sync__)
                clear
                cmd_sync
                echo ""
                read -rp "Press Enter to return..."
                ;;
            __action_plan__)
                clear
                cmd_plan
                echo ""
                read -rp "Press Enter to return..."
                ;;
            __action_apps__)
                clear
                echo -e "${BOLD}${CYAN}=== Manage VPN Applications ===${RESET}"
                echo ""
                cmd_app_list
                echo ""
                echo -e "Choose action:"
                echo -e "  ${CYAN}1)${RESET} Add application to VPN (e.g. claude)"
                echo -e "  ${CYAN}2)${RESET} Remove application from VPN"
                echo -e "  ${CYAN}3)${RESET} Return to main menu"
                echo ""
                read -rp "Selection [1-3]: " a_opt
                case "$a_opt" in
                    1)
                        read -rp "Enter program name or path (e.g. claude): " target_app
                        if [ -n "$target_app" ]; then
                            cmd_app_add "$target_app"
                        fi
                        echo ""
                        read -rp "Press Enter to return..."
                        ;;
                    2)
                        read -rp "Enter program name to remove: " target_app
                        if [ -n "$target_app" ]; then
                            cmd_app_remove "$target_app"
                        fi
                        echo ""
                        read -rp "Press Enter to return..."
                        ;;
                    *)
                        ;;
                esac
                ;;
            __action_mode__)
                clear
                echo -e "${BOLD}${CYAN}=== Select TunnelBear Routing Mode ===${RESET}"
                echo ""
                echo -e "  ${CYAN}1)${RESET} ${BOLD}Split Tunneling (Default)${RESET}"
                echo -e "     System internet stays direct (uses local ISP)."
                echo -e "     Only 'tb run <cmd>' and managed apps (e.g. 'claude') route through VPN."
                echo ""
                echo -e "  ${CYAN}2)${RESET} ${BOLD}Full System VPN${RESET}"
                echo -e "     ALL system internet traffic routes through the VPN tunnel."
                echo ""
                read -rp "Selection [1-2]: " m_opt
                case "$m_opt" in
                    1) cmd_mode split ;;
                    2) cmd_mode full ;;
                    *) ;;
                esac
                echo ""
                read -rp "Press Enter to return..."
                ;;
            __action_update__)
                clear
                cmd_update
                echo ""
                read -rp "Press Enter to return..."
                ;;
            __divider__|__none__)
                continue
                ;;
            *)
                cmd_connect "$sel_arg"
                echo ""
                read -rp "Press Enter to continue..."
                ;;
        esac
    done
}

