#!/usr/bin/env bash
# ==============================================================================
# app - Application Launcher & .desktop Browser (CLI & fzf TUI)
# Parse, browse, and launch installed desktop applications with fuzzy search.
# ==============================================================================

set -euo pipefail

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

export FZF_DEFAULT_OPTS="--color=border:bright-black,prompt:green,pointer:red,marker:yellow,header:blue,info:yellow,hl:cyan,hl+:bright-red ${FZF_DEFAULT_OPTS:-}"

# ------------------------------------------------------------------------------
# System Environment Synchronization
# ------------------------------------------------------------------------------

# Sync system session parameters from systemd user environment to ensure
# GUI applications inherit system theme (e.g. dark theme), Wayland, and portal settings.
sync_system_environment() {
    if command -v systemctl >/dev/null 2>&1; then
        while IFS='=' read -r key val; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            case "$key" in
                QT_*|GTK_*|XDG_*|GDK_*|MOZ_*|SDL_*|HYPR*|XCURSOR*|NIXOS_OZONE_WL|WAYLAND_DISPLAY|DISPLAY|DBUS_SESSION_BUS_ADDRESS)
                    export "$key=$val"
                    ;;
            esac
        done < <(systemctl --user show-environment 2>/dev/null || true)
    fi

    # Ensure critical variables are defaulted correctly if unset
    export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}"
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
    export NIXOS_OZONE_WL="${NIXOS_OZONE_WL:-1}"
    export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
    export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri}"
    export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"

    # Ensure full PATH across user profiles and system binaries
    for p in "$HOME/.local/bin" "$HOME/.nix-profile/bin" "/etc/profiles/per-user/${USER:-peng}/bin" "/run/current-system/sw/bin"; do
        if [[ -d "$p" && ":$PATH:" != *":$p:"* ]]; then
            export PATH="$p:$PATH"
        fi
    done
}

# ------------------------------------------------------------------------------
# Application Directory Resolution
# ------------------------------------------------------------------------------

# Dynamically resolve all directories containing .desktop files, including:
# - User desktop entries ($XDG_DATA_HOME/applications)
# - All XDG_DATA_DIRS paths
# - NixOS system and user profiles
# - Flatpak system and user exports
# - Snap and standard Linux directories
get_app_dirs() {
    local -A seen_dirs
    local dirs=()

    # 1. User applications ($XDG_DATA_HOME/applications)
    local user_apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    if [[ -d "$user_apps" && -z "${seen_dirs[$user_apps]:-}" ]]; then
        dirs+=("$user_apps")
        seen_dirs["$user_apps"]=1
    fi

    # 2. Paths from XDG_DATA_DIRS
    local xdg_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    IFS=':' read -ra split_xdg <<< "$xdg_dirs"
    for d in "${split_xdg[@]}"; do
        [[ -z "$d" ]] && continue
        local app_dir="$d/applications"
        if [[ -d "$app_dir" && -z "${seen_dirs[$app_dir]:-}" ]]; then
            dirs+=("$app_dir")
            seen_dirs["$app_dir"]=1
        fi
    done

    # 3. Explicit known profiles and fallback paths
    local extra_dirs=(
        "$HOME/.local/share/flatpak/exports/share/applications"
        "$HOME/.nix-profile/share/applications"
        "$HOME/.local/state/nix/profile/share/applications"
        "/etc/profiles/per-user/${USER:-peng}/share/applications"
        "/var/lib/flatpak/exports/share/applications"
        "/run/current-system/sw/share/applications"
        "/nix/var/nix/profiles/default/share/applications"
        "/var/lib/snapd/desktop/applications"
        "/usr/local/share/applications"
        "/usr/share/applications"
    )

    for d in "${extra_dirs[@]}"; do
        if [[ -d "$d" && -z "${seen_dirs[$d]:-}" ]]; then
            dirs+=("$d")
            seen_dirs["$d"]=1
        fi
    done

    printf "%s\n" "${dirs[@]}"
}

# ------------------------------------------------------------------------------
# Data Parsers
# ------------------------------------------------------------------------------

# Parse a .desktop file and extract key fields from [Desktop Entry]
parse_desktop_file() {
    local file="$1"
    [[ ! -f "$file" ]] && return

    local name="" exec="" comment="" icon="" terminal="false" nodisplay="false" path=""
    local in_desktop_entry=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Trim leading and trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        # Section header check
        if [[ "$line" =~ ^\[Desktop\ Entry\] ]]; then
            in_desktop_entry=true
            continue
        elif [[ "$line" =~ ^\[ ]]; then
            # Reached a subsequent section (e.g. [Desktop Action ...]); stop reading
            break
        fi

        [[ "$in_desktop_entry" != "true" ]] && continue

        case "$line" in
            Name=*)       [[ -z "$name" ]] && name="${line#Name=}" ;;
            Exec=*)       [[ -z "$exec" ]] && exec="${line#Exec=}" ;;
            Comment=*)    [[ -z "$comment" ]] && comment="${line#Comment=}" ;;
            Icon=*)       [[ -z "$icon" ]] && icon="${line#Icon=}" ;;
            Terminal=*)   terminal="${line#Terminal=}" ;;
            NoDisplay=*)  nodisplay="${line#NoDisplay=}" ;;
            Path=*)       [[ -z "$path" ]] && path="${line#Path=}" ;;
        esac
    done < "$file"

    # Skip if NoDisplay=true or no name/exec
    [[ "$nodisplay" == "true" ]] && return
    [[ -z "$name" ]] || [[ -z "$exec" ]] && return

    # Output in format: name|exec|comment|icon|terminal|filepath|path
    echo "$name|$exec|$comment|$icon|$terminal|$file|$path"
}

# Collect all .desktop entries dynamically across all application directories
collect_apps() {
    local -A seen_names
    local -A seen_files

    while IFS= read -r dir; do
        [[ ! -d "$dir" ]] && continue

        while IFS= read -r -d '' desktop_file; do
            [[ -n "${seen_files[$desktop_file]:-}" ]] && continue
            seen_files["$desktop_file"]=1

            local entry
            entry=$(parse_desktop_file "$desktop_file")
            [[ -z "$entry" ]] && continue

            local name="${entry%%|*}"

            # Skip duplicates (first found wins according to XDG priority)
            [[ -n "${seen_names[$name]:-}" ]] && continue
            seen_names["$name"]=1

            echo "$entry"
        done < <(find "$dir" -name "*.desktop" -print0 2>/dev/null)
    done < <(get_app_dirs) | sort -t'|' -k1,1 -f
}

# ------------------------------------------------------------------------------
# Formatting & Display
# ------------------------------------------------------------------------------

# Format app entry for fzf display (tab-delimited for instant file resolution)
format_app_entry() {
    local entry="$1"
    IFS='|' read -r name exec comment icon terminal filepath workdir <<< "$entry"

    local icon_display="󰀻"
    [[ "$terminal" == "true" ]] && icon_display=" "

    local comment_trunc="${comment:0:55}"
    [[ ${#comment} -gt 55 ]] && comment_trunc="${comment_trunc}..."

    printf "%-3s %-38s %-58s\t%s\n" "$icon_display" "$name" "$comment_trunc" "$filepath"
}

# Clean exec command (remove flatpak markers and field codes like %u, %f, etc.)
clean_exec_command() {
    local cmd="$1"
    # Remove Flatpak argument wrappers
    cmd=$(echo "$cmd" | sed -E 's/@@[uU]? %([a-zA-Z]) @@//g')
    cmd=$(echo "$cmd" | sed -E 's/@@//g')
    # Remove quoted field codes like "%u", "%U", "%f", "%F", etc.
    cmd=$(echo "$cmd" | sed -E 's/["'\'']%[a-zA-Z]["'\'']//g')
    # Remove unquoted field codes like %u, %U, %f, %F, %i, %c, %k, etc.
    cmd=$(echo "$cmd" | sed -E 's/%[a-zA-Z]//g')
    # Collapse multiple spaces into one
    cmd=$(echo "$cmd" | sed -E 's/[[:space:]]+/ /g')
    # Trim leading and trailing whitespace
    cmd=$(echo "$cmd" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    echo "$cmd"
}

# ------------------------------------------------------------------------------
# Actions
# ------------------------------------------------------------------------------

# Launch application ensuring full system session environment is passed
launch_app() {
    local exec_cmd="$1"
    local terminal="$2"
    local filepath="${3:-}"
    local workdir="${4:-}"

    # Synchronize system parameters so GUI apps inherit theme, wayland, and portal settings
    sync_system_environment

    exec_cmd=$(clean_exec_command "$exec_cmd")
    [[ -z "$exec_cmd" ]] && return 1

    local cd_prefix=""
    if [[ -n "$workdir" && -d "$workdir" ]]; then
        cd_prefix="cd $(printf '%q' "$workdir") && "
    fi

    # Escape the transient Kitty systemd scope so closing the launcher popup does not kill the spawned app
    if command -v systemd-run >/dev/null 2>&1; then
        local unit_id="app-$(date +%s%N)"
        local workdir_arg=()
        if [[ -n "$workdir" && -d "$workdir" ]]; then
            workdir_arg=(--working-directory="$workdir")
        fi

        if [[ "$terminal" == "true" ]]; then
            systemd-run --user \
                --slice=app.slice \
                --unit="$unit_id" \
                --description="App Terminal - $exec_cmd" \
                "${workdir_arg[@]}" \
                --setenv=PATH="$PATH" \
                --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
                --setenv=DISPLAY="${DISPLAY:-:0}" \
                --setenv=XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri}" \
                --setenv=XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}" \
                --setenv=NIXOS_OZONE_WL="${NIXOS_OZONE_WL:-1}" \
                --setenv=MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}" \
                --setenv=QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}" \
                --setenv=QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}" \
                kitty bash -c "${cd_prefix}${exec_cmd}" >/dev/null 2>&1 || \
                ( setsid kitty bash -c "${cd_prefix}${exec_cmd}" >/dev/null 2>&1 & )
        else
            systemd-run --user \
                --slice=app.slice \
                --unit="$unit_id" \
                --description="App - $exec_cmd" \
                "${workdir_arg[@]}" \
                --setenv=PATH="$PATH" \
                --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
                --setenv=DISPLAY="${DISPLAY:-:0}" \
                --setenv=XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri}" \
                --setenv=XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}" \
                --setenv=NIXOS_OZONE_WL="${NIXOS_OZONE_WL:-1}" \
                --setenv=MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}" \
                --setenv=QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}" \
                --setenv=QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}" \
                bash -c "${cd_prefix}${exec_cmd}" >/dev/null 2>&1 || \
                ( setsid bash -c "${cd_prefix}${exec_cmd}" >/dev/null 2>&1 & )
        fi
    else
        if [[ "$terminal" == "true" ]]; then
            ( setsid kitty bash -c "${cd_prefix}${exec_cmd}" >/dev/null 2>&1 & )
        else
            ( setsid bash -c "${cd_prefix}${exec_cmd}" >/dev/null 2>&1 & )
        fi
    fi
}

# ------------------------------------------------------------------------------
# Preview Handler
# ------------------------------------------------------------------------------

# Preview handler for fzf
cmd_preview() {
    local raw_line="$1"
    [[ -z "$raw_line" ]] && return

    local filepath
    filepath=$(echo "$raw_line" | cut -f2)

    local entry=""
    if [[ -n "$filepath" && -f "$filepath" ]]; then
        entry=$(parse_desktop_file "$filepath")
    fi

    if [[ -z "$entry" ]]; then
        local app_name
        app_name=$(echo "$raw_line" | cut -f1 | awk '{$1=""; print substr($0,2)}' | sed 's/ *$//')
        entry=$(collect_apps | grep "^${app_name}|" | head -1 || true)
    fi

    [[ -z "$entry" ]] && return

    IFS='|' read -r name exec comment icon terminal resolved_path workdir <<< "$entry"

    echo -e "${BOLD}${CYAN}Application:${RESET} $name"
    echo "─────────────────────────────────────────────────────────────────────────────"

    [[ -n "$comment" ]] && echo -e "\n${BOLD}Description:${RESET}\n  $comment"

    echo -e "\n${BOLD}Command:${RESET}\n  ${GREEN}$exec${RESET}"

    [[ "$terminal" == "true" ]] && echo -e "\n${YELLOW}⚠  Terminal Application${RESET}"

    [[ -n "$icon" ]] && echo -e "\n${BOLD}Icon:${RESET} $icon"

    echo -e "\n${BOLD}Source:${RESET}\n  ${DIM}$resolved_path${RESET}"
}

# ------------------------------------------------------------------------------
# Interactive Dashboard
# ------------------------------------------------------------------------------

cmd_interactive() {
    sync_system_environment

    local formatted_list=""
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        formatted_list+="$(format_app_entry "$entry")"$'\n'
    done < <(collect_apps)

    [[ -z "$formatted_list" ]] && {
        echo -e "${RED}No applications found${RESET}"
        return 1
    }

    local self_bin
    self_bin="$(readlink -f "$0")"

    local selection
    selection=$(printf "%s" "$formatted_list" | fzf \
        --ansi \
        --delimiter=$'\t' \
        --with-nth=1 \
        --prompt="󰀻  App > " \
        --header="[Application Launcher] (Enter: Launch | Ctrl-R: Reload | Esc: Exit)" \
        --preview="$self_bin preview {}" \
        --preview-window="right:52%:wrap" \
        --height=100% \
        --border=rounded \
        --reverse \
        --cycle \
        --bind="ctrl-r:reload($self_bin collect)" \
        --bind="ctrl-q:abort" || true)

    [[ -z "$selection" ]] && return 0

    local filepath
    filepath=$(echo "$selection" | cut -f2)

    local entry=""
    if [[ -n "$filepath" && -f "$filepath" ]]; then
        entry=$(parse_desktop_file "$filepath")
    fi

    if [[ -z "$entry" ]]; then
        local app_name
        app_name=$(echo "$selection" | cut -f1 | awk '{$1=""; print substr($0,2)}' | sed 's/ *$//')
        entry=$(collect_apps | grep "^${app_name}|" | head -1 || true)
    fi

    [[ -z "$entry" ]] && return 1

    IFS='|' read -r name exec comment icon terminal resolved_path workdir <<< "$entry"

    echo -e "${GREEN}✓${RESET} Launching ${BOLD}$name${RESET}..."
    launch_app "$exec" "$terminal" "$resolved_path" "${workdir:-}"
}

# ------------------------------------------------------------------------------
# CLI List & Count Modes
# ------------------------------------------------------------------------------

cmd_list() {
    echo -e "${BOLD}Installed Applications:${RESET}\n"

    local count=0
    while IFS='|' read -r name exec comment icon terminal filepath workdir; do
        count=$((count + 1))
        local icon_display="󰀻"
        [[ "$terminal" == "true" ]] && icon_display=" "

        echo -e "${icon_display} ${BOLD}${name}${RESET}"
        [[ -n "$comment" ]] && echo -e "  ${DIM}${comment}${RESET}"
    done < <(collect_apps)

    echo -e "\n${DIM}Total: $count applications${RESET}"
}

cmd_count() {
    collect_apps | wc -l
}

# ------------------------------------------------------------------------------
# Help & Usage
# ------------------------------------------------------------------------------

cmd_help() {
    cat <<EOF
${BOLD}app${RESET} - Application Launcher & .desktop Browser (CLI & fzf TUI)
Parses .desktop files and launches installed GUI applications with fuzzy search.
Automatically detects newly installed apps across all system and user profiles.

${BOLD}USAGE:${RESET}
    app                    Launch interactive fzf application browser
    app list               List all installed applications
    app count              Print count of discovered applications
    app launch <name>      Launch application directly by name or path
    app preview <line>     Internal preview generator for fzf
    app collect            Internal data collector for fzf reload
    app help               Show this help message

${BOLD}INTERACTIVE HOTKEYS (inside fzf menu):${RESET}
    ${CYAN}Enter${RESET}      Launch selected application
    ${CYAN}Ctrl-R${RESET}     Reload application list from .desktop files
    ${CYAN}Esc${RESET}        Cancel and exit

${BOLD}DESKTOP FILE LOCATIONS (Auto-detected):${RESET}
    • \$XDG_DATA_HOME/applications (~/.local/share/applications)
    • All directories configured in \$XDG_DATA_DIRS
    • NixOS system profile (/run/current-system/sw/share/applications)
    • Home-Manager user profile (/etc/profiles/per-user/\$USER/share/applications)
    • Nix user profiles (~/.nix-profile, ~/.local/state/nix/profile)
    • Flatpak system & user exports (/var/lib/flatpak, ~/.local/share/flatpak)
    • Snap & standard Linux directories (/usr/share/applications)

EOF
}

# ------------------------------------------------------------------------------
# Main Dispatch
# ------------------------------------------------------------------------------

case "${1:-interactive}" in
    preview)
        cmd_preview "${2:-}"
        ;;
    collect)
        collect_apps | while IFS= read -r entry; do
            format_app_entry "$entry"
        done
        ;;
    list)
        cmd_list
        ;;
    count)
        cmd_count
        ;;
    launch)
        target="${2:-}"
        [[ -z "$target" ]] && { echo -e "${RED}Usage: app launch <app-name-or-file>${RESET}"; exit 1; }
        entry=""
        if [[ -f "$target" ]]; then
            entry=$(parse_desktop_file "$target")
        else
            entry=$(collect_apps | grep -i "^${target}|" | head -1 || true)
            [[ -z "$entry" ]] && entry=$(collect_apps | grep -i "${target}" | head -1 || true)
        fi
        if [[ -z "$entry" ]]; then
            echo -e "${RED}Application not found: $target${RESET}"
            exit 1
        fi
        IFS='|' read -r name exec comment icon terminal resolved_path workdir <<< "$entry"
        echo -e "${GREEN}✓${RESET} Launching ${BOLD}$name${RESET}..."
        launch_app "$exec" "$terminal" "$resolved_path" "${workdir:-}"
        ;;
    help|-h|--help)
        cmd_help
        ;;
    interactive|"")
        if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
            cmd_interactive
        else
            cmd_list
        fi
        ;;
    *)
        echo -e "${RED}Unknown command: $1${RESET}"
        echo -e "Run ${CYAN}app help${RESET} for usage"
        exit 1
        ;;
esac
