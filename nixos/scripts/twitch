#!/usr/bin/env bash
# twitch — Start/stop the Don't Starve Together Twitch Drops farmer
# (Violentmonkey userscript twitch-drops-claimer.user.js running in Firefox)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USERSCRIPT="$SCRIPT_DIR/twitch-drops-claimer.user.js"
DROPS_URL="https://www.twitch.tv/drops/campaigns"

show_help() {
  cat <<'EOF'
Usage: twitch [COMMAND]   (fish abbr: tdrops)

Commands:
  start (default)    Open a Firefox tab that farms DST drops until all are claimed
  stop               Tell the farming tab to stop (opens a short-lived Twitch tab)
  install            Install/update the userscript in Violentmonkey
  help, -h, --help   Show this help

The farming tab shows a HUD in the bottom-right corner with live drop
progress and a Start/Stop button. You must be logged in to Twitch in Firefox
and have your Klei account linked on twitch.tv/drops/campaigns.
EOF
}

install_userscript() {
  # Violentmonkey intercepts *.user.js URLs served over http, so serve a copy briefly on localhost
  local tmpdir port pid
  tmpdir="$(mktemp -d)"
  cp "$USERSCRIPT" "$tmpdir/"
  port=$(( 20000 + RANDOM % 20000 ))
  python3 -m http.server --bind 127.0.0.1 --directory "$tmpdir" "$port" >/dev/null 2>&1 &
  pid=$!
  # Expand now: the locals are out of scope by the time an EXIT trap would run
  trap "kill $pid 2>/dev/null; rm -rf '$tmpdir'" EXIT
  sleep 0.5
  firefox --new-tab "http://127.0.0.1:$port/$(basename "$USERSCRIPT")" >/dev/null 2>&1 &
  echo "📥 Confirm the install in the Violentmonkey tab, then press Enter here."
  read -r
  echo "✅ Done. Make sure only one 'Twitch Drops Auto-Claimer' script is enabled in Violentmonkey."
}

cmd="${1:-start}"

case "$cmd" in
  start|--start)
    firefox --new-tab "$DROPS_URL#dst-drops" >/dev/null 2>&1 &
    echo "🎮 DST drops farmer started in Firefox — watch the HUD in the bottom-right."
    echo "   (Nothing happens? Run 'twitch install' to install the userscript first.)"
    ;;

  stop|--stop)
    firefox --new-tab "$DROPS_URL#dst-drops-stop" >/dev/null 2>&1 &
    echo "⏹ Stop signal sent to the farming tab."
    ;;

  install|--install)
    install_userscript
    ;;

  help|-h|--help)
    show_help
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    show_help
    exit 1
    ;;
esac
