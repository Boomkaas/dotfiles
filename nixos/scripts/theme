#!/usr/bin/env bash
# ==============================================================================
# theme - Terminal Theme, Wallpaper & Desktop Customizer (CLI & fzf TUI)
# Manage wallpapers, Waybar layouts, accent colors, dockbar, visualizer & pets.
# ==============================================================================

# Colors
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'
    RESET=$'\033[0m'
else
    BOLD=''
    DIM=''
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    WHITE=''
    RESET=''
fi

spawn() { ( setsid "$@" & ) >/dev/null 2>&1; }

# ------------------------------------------------------------------------------
# State Getters
# ------------------------------------------------------------------------------

get_mono_status() {
    local s
    s=$(cat "$HOME/.local/state/haku_theme/monochrome_wallpaper" 2>/dev/null || echo "1")
    [ "$s" = "1" ] && echo "ON" || echo "OFF"
}

get_cava_status() {
    [ -f /tmp/cava-layer.pid ] && echo "ON" || echo "OFF"
}

get_dockbar_status() {
    local s
    s=$(cat "$HOME/.local/state/haku_theme/dockbar_manual_state" 2>/dev/null || echo "0")
    [ "$s" = "1" ] && echo "ON" || echo "OFF"
}

get_desktop_icons_status() {
    local s
    s=$(cat "$HOME/.local/state/haku_theme/desktop_icons_state" 2>/dev/null || echo "0")
    [ "$s" = "1" ] && echo "ON" || echo "OFF"
}

get_pet_status() {
    if pgrep -f bongocat-all >/dev/null 2>&1; then
        echo "ON"
    else
        echo "OFF"
    fi
}

get_lively_status() {
    if pgrep -x mpvpaper >/dev/null 2>&1; then
        echo "ON"
    else
        echo "OFF"
    fi
}

get_accent_color() {
    local col
    col=$(sed -nE 's/^\s*@define-color\s+accent_color\s+(#[0-9a-fA-F]{6})\s*;.*$/\1/p' "$HOME/.local/state/haku_theme/colors.css" 2>/dev/null | head -n1)
    echo "${col:-#cd9c61}"
}

get_waybar_layout() {
    local l
    l=$(cat "$HOME/.local/state/haku_theme/waybar_current_mode" 2>/dev/null || echo "jakoolit-top-sleek")
    echo "$l"
}

get_rofi_theme() {
    local r
    r=$(sed -nE 's/^\s*@theme\s+"([^"]+)".*$/\1/p' "$HOME/.config/rofi/config.rasi" 2>/dev/null | head -n1)
    echo "${r:-horizontal}"
}

# ------------------------------------------------------------------------------
# Actions
# ------------------------------------------------------------------------------

cmd_status() {
    echo -e "${BOLD}${CYAN}=== Theme & Appearance Status ===${RESET}"
    echo -e "  ${BOLD}Accent Color:${RESET}       $(get_accent_color)"
    echo -e "  ${BOLD}Waybar Layout:${RESET}      $(get_waybar_layout)"
    echo -e "  ${BOLD}Rofi Theme:${RESET}         $(get_rofi_theme)"
    echo -e "  ${BOLD}Monochrome Filter:${RESET}  $([ "$(get_mono_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Cava Visualizer:${RESET}    $([ "$(get_cava_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Dockbar:${RESET}            $([ "$(get_dockbar_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Desktop Icons:${RESET}      $([ "$(get_desktop_icons_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Desktop Pet:${RESET}        $([ "$(get_pet_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
    echo -e "  ${BOLD}Lively Video:${RESET}       $([ "$(get_lively_status)" = "ON" ] && echo -e "${GREEN}ON${RESET}" || echo -e "${DIM}OFF${RESET}")"
}

cmd_pet_toggle() {
    if pgrep -f bongocat-all >/dev/null 2>&1; then
        pkill -f bongocat-all
        echo -e "${YELLOW}Desktop Pet hidden.${RESET}"
    else
        spawn pet Dodomon
        echo -e "${GREEN}Desktop Pet spawned!${RESET}"
    fi
}

cmd_open_folder() {
    local target="$1"
    if [ -t 1 ] && command -v yazi >/dev/null 2>&1; then
        yazi "$target"
    else
        spawn thunar "$target"
    fi
}

# ------------------------------------------------------------------------------
# Interactive TUI Menu (fzf)
# ------------------------------------------------------------------------------

cmd_interactive() {
    if ! command -v fzf >/dev/null 2>&1; then
        cmd_status
        return 0
    fi

    while true; do
        clear
        local mono cava dock icons pet lively accent waybar rofi
        mono=$(get_mono_status)
        cava=$(get_cava_status)
        dock=$(get_dockbar_status)
        icons=$(get_desktop_icons_status)
        pet=$(get_pet_status)
        lively=$(get_lively_status)
        accent=$(get_accent_color)
        waybar=$(get_waybar_layout)
        rofi=$(get_rofi_theme)

        local header_info="Accent: $accent | Waybar: $waybar"

        local menu=()
        menu+=("󰏜  Change Wallpaper (Visual Gallery)")
        menu+=("🎲 Randomize Wallpaper Now")
        menu+=("󰄄  Monochrome Wallpaper Toggle ($mono)")
        menu+=("🎲 Randomize Waybar Layout Now")
        menu+=("  Switch Waybar Layout ($waybar)")
        menu+=("  Switch Rofi Theme ($rofi)")
        menu+=("󱜏  Change Lively Video Wallpaper ($lively)")
        menu+=("󱛹  Stop Lively Video Wallpaper")
        menu+=("󰈊  Pick Accent Color from Screen (Eyedropper)")
        menu+=("  Custom Accent Color & Presets ($accent)")
        menu+=("󰏘  GTK Look & Feel (Themes, Icons, Cursors)")
        menu+=("  Change Global Font & Size")
        menu+=("󰝚  Cava Underbar Audio Visualizer ($cava)")
        menu+=("󱂩  Toggle Dockbar ($dock)")
        menu+=("  Desktop Icons ($icons)")
        menu+=("🐾 Desktop Pet Companion ($pet)")
        menu+=("󱁤  Open Wallpapers Folder")
        menu+=("󱁤  Open Lively Videos Folder")

        local choice
        choice=$(printf "%s\n" "${menu[@]}" | fzf \
            --prompt="Theme > " \
            --header="[$header_info] (Enter to select, Esc to exit)" \
            --reverse \
            --height=60% \
            --border=rounded \
            --cycle) || break

        [ -z "$choice" ] && break

        case "$choice" in
            *"Change Wallpaper ("*)
                $HOME/.local/bin/wallpaper_select.sh
                ;;
            *"Randomize Wallpaper"*)
                $HOME/.local/bin/random_wallpaper.sh
                sleep 0.5
                ;;
            *"Monochrome Wallpaper"*)
                $HOME/.local/bin/monochrome_wallpaper_toggle.sh
                sleep 0.5
                ;;
            *"Randomize Waybar Layout"*)
                $HOME/.local/bin/waybar_manager.sh --random
                sleep 0.5
                ;;
            *"Switch Waybar Layout"*)
                $HOME/.local/bin/waybar_manager.sh --select
                ;;
            *"Switch Rofi Theme"*)
                $HOME/.local/bin/rofi_theme_switcher.sh
                ;;
            *"Change Lively Video"*)
                $HOME/.local/bin/wallpaper_video_select.sh
                ;;
            *"Stop Lively Video"*)
                $HOME/.local/bin/wallpaper_video_select.sh --exit
                sleep 0.5
                ;;
            *"Pick Accent Color"*)
                $HOME/.local/bin/accent_color_picker.sh
                sleep 0.5
                ;;
            *"Custom Accent Color"*)
                $HOME/.local/bin/change_theme.sh
                ;;
            *"GTK Look"*)
                if command -v nwg-look >/dev/null 2>&1; then
                    spawn nwg-look
                else
                    $HOME/.local/bin/gtk_theme_menu.sh
                fi
                ;;
            *"Change Global Font"*)
                $HOME/.local/bin/change_theme.sh
                ;;
            *"Cava Underbar"*)
                $HOME/.local/bin/cava_manager.sh
                sleep 0.5
                ;;
            *"Toggle Dockbar"*)
                $HOME/.local/bin/dockbar_manager.sh --toggle
                sleep 0.5
                ;;
            *"Desktop Icons"*)
                $HOME/.local/bin/desktop_icons_manager.sh --toggle
                sleep 0.5
                ;;
            *"Desktop Pet"*)
                cmd_pet_toggle
                sleep 0.5
                ;;
            *"Open Wallpapers Folder"*)
                cmd_open_folder "$HOME/Pictures/Wallpapers"
                ;;
            *"Open Lively Videos Folder"*)
                cmd_open_folder "$HOME/Videos/Wallpapers"
                ;;
        esac
    done
}

cmd_help() {
    cat << EOF
${BOLD}theme${RESET} - Terminal Theme, Wallpaper & Desktop Customizer

${BOLD}USAGE:${RESET}
    theme                           Launch interactive fzf menu
    theme status | s                Show current appearance and widget status
    theme wallpaper [select|random] Select or randomize desktop wallpaper
    theme mono                      Toggle monochrome wallpaper filter
    theme waybar [select|random]    Switch or randomize Waybar bar style
    theme rofi                      Switch Rofi theme
    theme video [select|stop]       Change or stop animated video wallpaper
    theme color [pick|presets]      Pick color from screen or choose preset
    theme font                      Open font & sizing config
    theme cava                      Toggle Cava audio visualizer
    theme dockbar                   Toggle bottom dockbar
    theme icons                     Toggle desktop icons
    theme pet                       Toggle desktop pet companion
    theme gtk                       Open GTK look & feel configuration
    theme help | -h                 Show this help message

EOF
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------

case "${1:-}" in
    status|s|info)
        cmd_status
        ;;
    wallpaper|wall)
        shift
        case "${1:-}" in
            random|rnd) $HOME/.local/bin/random_wallpaper.sh ;;
            *) $HOME/.local/bin/wallpaper_select.sh ;;
        esac
        ;;
    random)
        $HOME/.local/bin/random_wallpaper.sh
        ;;
    mono|monochrome)
        $HOME/.local/bin/monochrome_wallpaper_toggle.sh
        ;;
    waybar)
        shift
        case "${1:-}" in
            random|rnd) $HOME/.local/bin/waybar_manager.sh --random ;;
            *) $HOME/.local/bin/waybar_manager.sh --select ;;
        esac
        ;;
    rofi)
        $HOME/.local/bin/rofi_theme_switcher.sh
        ;;
    video)
        shift
        case "${1:-}" in
            stop|exit|kill) $HOME/.local/bin/wallpaper_video_select.sh --exit ;;
            *) $HOME/.local/bin/wallpaper_video_select.sh ;;
        esac
        ;;
    color|accent)
        shift
        case "${1:-}" in
            pick|eyedropper) $HOME/.local/bin/accent_color_picker.sh ;;
            *) $HOME/.local/bin/change_theme.sh ;;
        esac
        ;;
    font)
        $HOME/.local/bin/change_theme.sh
        ;;
    cava)
        $HOME/.local/bin/cava_manager.sh
        ;;
    dockbar|dock)
        $HOME/.local/bin/dockbar_manager.sh --toggle
        ;;
    icons)
        $HOME/.local/bin/desktop_icons_manager.sh --toggle
        ;;
    pet)
        cmd_pet_toggle
        ;;
    gtk)
        if command -v nwg-look >/dev/null 2>&1; then
            spawn nwg-look
        else
            $HOME/.local/bin/gtk_theme_menu.sh
        fi
        ;;
    help|-h|--help)
        cmd_help
        ;;
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            cmd_interactive
        else
            cmd_status
            echo ""
            cmd_help
        fi
        ;;
    *)
        cmd_interactive
        ;;
esac
