#!/usr/bin/env bash
# ==============================================================================
# nixtest — Peng's NixOS Modular System Test Suite
#
# Usage:
#   nixtest all              Run all 14 modules
#   nixtest modules          List available modules
#   nixtest <module>         Run a single module
#   nixtest <m1> <m2> …      Run multiple specific modules
#
# All tests are READ-ONLY — nothing is modified or restarted.
# ==============================================================================

export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-peng}/bin:$HOME/.local/bin:/run/wrappers/bin:$PATH"

DOTFILES="${DOTFILES_DIR:-/home/peng/Code/Dotfiles}"
NIXOS_DIR="$DOTFILES/nixos"
SCRIPTS_DIR="$NIXOS_DIR/scripts"
CONFIG_DIR="$DOTFILES/config"

# ── Colors ────────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m';  GREEN='\033[0;32m'; YELLOW='\033[1;33m'
  BLUE='\033[0;34m'; CYAN='\033[0;36m';  BOLD='\033[1m'; RESET='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; RESET=''
fi

# ── Counters ──────────────────────────────────────────────────────────────────
PASS=0; FAIL=0; WARN=0
TOTAL_PASS=0; TOTAL_FAIL=0; TOTAL_WARN=0

# ── Primitives ────────────────────────────────────────────────────────────────

_pass() { echo -e "  ${GREEN}✅${RESET} $1"; PASS=$(( PASS + 1 )); }
_fail() { echo -e "  ${RED}❌${RESET} $1"; FAIL=$(( FAIL + 1 )); }
_warn() { echo -e "  ${YELLOW}⚠️ ${RESET} $1"; WARN=$(( WARN + 1 )); }
_info() { echo -e "  ${CYAN}ℹ️ ${RESET} $1"; }

# check DESC CMD [ARGS...] — pass if command exits 0
check() {
  local desc="$1"; shift
  if "$@" &>/dev/null 2>&1; then _pass "$desc"; else _fail "$desc"; fi
}

# check_warn DESC CMD [ARGS...] — warn (not fail) if command exits non-zero
check_warn() {
  local desc="$1"; shift
  if "$@" &>/dev/null 2>&1; then _pass "$desc"; else _warn "$desc"; fi
}

# has FILE PATTERN — pass if grep matches
has() {
  local desc="$1" file="$2" pattern="$3"
  if grep -qP -- "$pattern" "$file" 2>/dev/null; then _pass "$desc"
  else _fail "$desc  ${BOLD}[pattern: $pattern]${RESET}"; fi
}

# hasnt FILE PATTERN — pass if grep does NOT match
hasnt() {
  local desc="$1" file="$2" pattern="$3"
  if ! grep -qP -- "$pattern" "$file" 2>/dev/null; then _pass "$desc"
  else _fail "$desc  ${BOLD}[unwanted: $pattern]${RESET}"; fi
}

# count FILE PATTERN EXPECTED — pass if grep count = expected
count_eq() {
  local desc="$1" file="$2" pattern="$3" expected="$4"
  local n; n=$(grep -cP -- "$pattern" "$file" 2>/dev/null || true)
  if [[ "$n" -eq "$expected" ]]; then _pass "$desc  (×$n)"
  else _fail "$desc  (expected ×$expected, got ×$n)"; fi
}

# svc_active DESC SERVICE [--user]
svc_active() {
  local desc="$1" svc="$2" flag="${3:-}"
  if [[ "$flag" == "--user" ]]; then
    if systemctl --user is-active "$svc" &>/dev/null; then _pass "$desc"
    else _fail "$desc  (systemctl --user is-active $svc)"; fi
  else
    if systemctl is-active "$svc" &>/dev/null; then _pass "$desc"
    else _fail "$desc  (systemctl is-active $svc)"; fi
  fi
}

# file_exists DESC PATH
file_exists() {
  local desc="$1" path="$2"
  if [[ -e "$path" ]]; then _pass "$desc"; else _fail "$desc  ($path)"; fi
}

module_start() {
  echo ""
  echo -e "${BOLD}${BLUE}━━━ ${1} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  PASS=0; FAIL=0; WARN=0
}

module_end() {
  local total=$(( PASS + FAIL ))
  if   [[ $FAIL -eq 0 && $WARN -eq 0 ]]; then
    echo -e "  ${GREEN}${BOLD}► $PASS/$total passed${RESET}"
  elif [[ $FAIL -eq 0 ]]; then
    echo -e "  ${YELLOW}${BOLD}► $PASS/$total passed  ($WARN warning(s))${RESET}"
  else
    echo -e "  ${RED}${BOLD}► $PASS/$total passed  ($FAIL failed, $WARN warning(s))${RESET}"
  fi
  TOTAL_PASS=$(( TOTAL_PASS + PASS ))
  TOTAL_FAIL=$(( TOTAL_FAIL + FAIL ))
  TOTAL_WARN=$(( TOTAL_WARN + WARN ))
}

# ==============================================================================
# MODULE: nix ❄️
# ==============================================================================
mod_nix() {
  module_start "❄️  nix — Flake evaluation & .nix file parsing"

  # Per-file parse check
  local files=(
    "$NIXOS_DIR/modules/core/connections.nix"
    "$NIXOS_DIR/modules/core/services.nix"
    "$NIXOS_DIR/modules/core/system.nix"
    "$NIXOS_DIR/modules/core/audio.nix"
    "$NIXOS_DIR/modules/core/user.nix"
    "$NIXOS_DIR/modules/pkgs.nix"
    "$NIXOS_DIR/system/configuration.nix"
    "$NIXOS_DIR/system/hardware-configuration.nix"
    "$NIXOS_DIR/modules/default.nix"
    "$NIXOS_DIR/flake.nix"
  )
  for f in "${files[@]}"; do
    check "nix-instantiate --parse: $(basename "$f")" \
      nix-instantiate --parse "$f"
  done

  # Full evaluation via dry-build
  _info "nixos-rebuild dry-build (evaluates full system, ~30s)…"
  if nixos-rebuild dry-build --flake "$NIXOS_DIR#nixos" --impure &>/dev/null 2>&1; then
    _pass "nixos-rebuild dry-build: full flake evaluates cleanly"
  else
    _fail "nixos-rebuild dry-build: flake evaluation failed"
  fi

  # Nix settings
  has  "Nix: auto-optimise-store = true"    "$NIXOS_DIR/modules/core/system.nix"   'auto-optimise-store\s*=\s*true'
  has  "Nix: flakes experimental feature"   "$NIXOS_DIR/modules/core/system.nix"   '"flakes"'
  has  "Nix: nix-command experimental feature" "$NIXOS_DIR/modules/core/system.nix" '"nix-command"'
  has  "Nix: nh clean enabled"             "$NIXOS_DIR/system/configuration.nix"   'clean\.enable\s*=\s*true'
  has  "Nix: nh clean keeps ≥3 generations" "$NIXOS_DIR/system/configuration.nix"  '--keep\s+[3-9]'

  module_end
}

# ==============================================================================
# MODULE: security 🔒
# ==============================================================================
mod_security() {
  module_start "🔒  security — PostgreSQL auth, Samba, firewall, polkit"

  # PostgreSQL
  hasnt "PostgreSQL: no trust on Unix socket" \
    "$NIXOS_DIR/modules/core/services.nix" 'local\s+all\s+all\s+trust'
  has   "PostgreSQL: peer auth on Unix socket" \
    "$NIXOS_DIR/modules/core/services.nix" 'local\s+all\s+all\s+peer'
  has   "PostgreSQL: scram-sha-256 on TCP loopback" \
    "$NIXOS_DIR/modules/core/services.nix" 'scram-sha-256'
  hasnt "PostgreSQL: no trust on TCP loopback" \
    "$NIXOS_DIR/modules/core/services.nix" '127\.0\.0\.1.*trust'

  # Firewall
  hasnt "Firewall: port 5432 not exposed publicly" \
    "$NIXOS_DIR/modules/core/connections.nix" '\b5432\b(?!\s*removed|\s*#)'
  has   "Firewall: firewall block enabled" \
    "$NIXOS_DIR/modules/core/connections.nix" 'networking\.firewall'
  has   "Firewall: ham0/hamachi0 in trustedInterfaces" \
    "$NIXOS_DIR/modules/core/connections.nix" 'trustedInterfaces.*ham0'

  # Samba
  hasnt 'Samba: guest ok = yes removed' \
    "$NIXOS_DIR/modules/core/services.nix" '"guest ok"\s*=\s*"yes"'
  has   'Samba: guest ok = no set' \
    "$NIXOS_DIR/modules/core/services.nix" '"guest ok"\s*=\s*"no"'
  has   'Samba: valid users restricted to peng' \
    "$NIXOS_DIR/modules/core/services.nix" '"valid users"'
  has   "Samba: hosts allow restricts access" \
    "$NIXOS_DIR/modules/core/services.nix" 'hosts allow'
  has   "Samba: Shared share configured" \
    "$NIXOS_DIR/modules/core/services.nix" '"Shared"'
  has   "Samba: path set to /home/peng/Shared" \
    "$NIXOS_DIR/modules/core/services.nix" '"/home/peng/Shared"'
  hasnt "Samba: workspace share removed" \
    "$NIXOS_DIR/modules/core/services.nix" '"workspace"'
  hasnt "Samba: Test share removed" \
    "$NIXOS_DIR/modules/core/services.nix" '"Test"'

  # Polkit
  hasnt "Polkit: no blanket YES for all actions (isInGroup check only)" \
    "$NIXOS_DIR/modules/core/system.nix" 'isInGroup\("wheel"\)\s*\)\s*\n\s*return polkit'
  has   "Polkit: scoped to specific action prefixes" \
    "$NIXOS_DIR/modules/core/system.nix" 'var allowed'
  has   "Polkit: udisks2 in allowed list" \
    "$NIXOS_DIR/modules/core/system.nix" 'org\.freedesktop\.udisks2\.'
  has   "Polkit: login1 in allowed list" \
    "$NIXOS_DIR/modules/core/system.nix" 'org\.freedesktop\.login1\.'

  # nix-ld
  has  "nix-ld: enabled (FHS compat for AGY binary)" \
    "$NIXOS_DIR/modules/core/system.nix" 'programs\.nix-ld\.enable\s*=\s*true'

  # Live: failed units
  local sf uf
  sf=$(systemctl list-units --state=failed --no-legend 2>/dev/null | wc -l)
  uf=$(systemctl --user list-units --state=failed --no-legend 2>/dev/null | wc -l)
  [[ $sf -eq 0 ]] && _pass "Live: 0 failed system units" || _fail "Live: $sf failed system unit(s)"
  [[ $uf -eq 0 ]] && _pass "Live: 0 failed user units"   || _fail "Live: $uf failed user unit(s)"

  module_end
}

# ==============================================================================
# MODULE: network 🌐
# ==============================================================================
mod_network() {
  module_start "🌐  network — NetworkManager, TCP sysctl, VM tunables, connectivity"

  has "NetworkManager: enabled" \
    "$NIXOS_DIR/modules/core/connections.nix" 'networking\.networkmanager\.enable\s*=\s*true'
  has "TCP: keepalive_time tuned" \
    "$NIXOS_DIR/modules/core/connections.nix" 'tcp_keepalive_time'
  has "TCP: keepalive_intvl tuned" \
    "$NIXOS_DIR/modules/core/connections.nix" 'tcp_keepalive_intvl'
  has "TCP: retries2 tuned (faster failover)" \
    "$NIXOS_DIR/modules/core/connections.nix" 'tcp_retries2'
  has "VM: swappiness declared in sysctl" \
    "$NIXOS_DIR/modules/core/connections.nix" '"vm\.swappiness"'
  has "VM: vfs_cache_pressure declared in sysctl" \
    "$NIXOS_DIR/modules/core/connections.nix" '"vm\.vfs_cache_pressure"'

  # Live sysctl values
  local swp; swp=$(sysctl -n vm.swappiness 2>/dev/null || echo "99")
  if [[ "$swp" -le 20 ]]; then _pass "Live: vm.swappiness = $swp (≤20 ✓)"
  else _warn "Live: vm.swappiness = $swp (target 10 — run nixreb to apply)"; fi

  local vcp; vcp=$(sysctl -n vm.vfs_cache_pressure 2>/dev/null || echo "200")
  if [[ "$vcp" -le 75 ]]; then _pass "Live: vm.vfs_cache_pressure = $vcp (≤75 ✓)"
  else _warn "Live: vm.vfs_cache_pressure = $vcp (target 50 — run nixreb to apply)"; fi

  local kt; kt=$(sysctl -n net.ipv4.tcp_keepalive_time 2>/dev/null || echo "?")
  _info "Live: tcp_keepalive_time = $kt (target: 60)"

  svc_active "Live: NetworkManager.service running" "NetworkManager"

  check_warn "Live: internet reachable (ping 8.8.8.8)" \
    ping -c 1 -W 2 8.8.8.8

  module_end
}

# ==============================================================================
# MODULE: bluetooth 🔵
# ==============================================================================
mod_bluetooth() {
  module_start "🔵  bluetooth — Config correctness, journal errors, service health"

  # Integer type fix (was "true", caused journal error every boot)
  has   "BT: EnableAdvMonInterleaveScan = \"1\" (integer)" \
    "$NIXOS_DIR/modules/core/connections.nix" 'EnableAdvMonInterleaveScan\s*=\s*"1"'
  hasnt "BT: no string \"true\" for integer field" \
    "$NIXOS_DIR/modules/core/connections.nix" 'EnableAdvMonInterleaveScan\s*=\s*"true"'

  has   "BT: FastConnectable enabled" \
    "$NIXOS_DIR/modules/core/connections.nix" 'FastConnectable'
  has   "BT: Experimental mode enabled (needed for BLE)" \
    "$NIXOS_DIR/modules/core/connections.nix" 'Experimental\s*=\s*"true"'
  has   "BT: powerOnBoot = true" \
    "$NIXOS_DIR/modules/core/connections.nix" 'powerOnBoot\s*=\s*true'
  has   "BT: dual controller mode" \
    "$NIXOS_DIR/modules/core/connections.nix" 'ControllerMode\s*=\s*"dual"'
  has   "BT: unblock-bluetooth service defined" \
    "$NIXOS_DIR/modules/core/connections.nix" 'unblock-bluetooth'

  svc_active "Live: bluetooth.service running" "bluetooth"
  check_warn "Live: blueman-applet process running" \
    pgrep -f blueman-applet

  # Journal: type error count since boot
  local errs; errs=$(journalctl -u bluetooth -b --no-pager -q 2>/dev/null \
    | grep -c "not integer" 2>/dev/null || true)
  if [[ "$errs" -eq 0 ]]; then
    _pass "Live: no 'not integer' bluetooth config error in journal"
  else
    _warn "Live: $errs type error(s) in journal (clears after nixreb)"
  fi

  module_end
}

# ==============================================================================
# MODULE: audio 🔊
# ==============================================================================
mod_audio() {
  module_start "🔊  audio — PipeWire stack, ALSA, JACK, hardware quirks"

  has  "PipeWire: enabled"                    "$NIXOS_DIR/modules/core/audio.nix" 'services\.pipewire\s*='
  has  "PipeWire: ALSA enabled"               "$NIXOS_DIR/modules/core/audio.nix" 'alsa\.enable\s*=\s*true'
  has  "PipeWire: 32-bit ALSA enabled"        "$NIXOS_DIR/modules/core/audio.nix" 'alsa\.support32Bit\s*=\s*true'
  has  "PipeWire: PulseAudio compat enabled"  "$NIXOS_DIR/modules/core/audio.nix" 'pulse\.enable\s*=\s*true'
  has  "PipeWire: JACK support enabled"       "$NIXOS_DIR/modules/core/audio.nix" 'jack\.enable\s*=\s*true'
  has  "PulseAudio standalone: disabled"      "$NIXOS_DIR/modules/core/audio.nix" 'pulseaudio\.enable\s*=\s*false'
  has  "ALC256 mic quirk: alc256-asus-mic"    "$NIXOS_DIR/modules/core/audio.nix" 'alc256-asus-mic'

  svc_active "Live: pipewire.service"       "pipewire"       "--user"
  svc_active "Live: wireplumber.service"    "wireplumber"    "--user"
  svc_active "Live: pipewire-pulse.service" "pipewire-pulse" "--user"

  local sinks; sinks=$(pactl list sinks 2>/dev/null | grep -c "^Sink #" || true)
  if [[ "$sinks" -gt 0 ]]; then _pass "Live: $sinks audio sink(s) detected"
  else _warn "Live: no audio sinks detected via pactl"; fi

  module_end
}

# ==============================================================================
# MODULE: power ⚡
# ==============================================================================
mod_power() {
  module_start "⚡  power — hypridle, idle scripts, battery, logind, kernel sleep"

  # Kernel sleep params
  has "Kernel: mem_sleep_default=deep (S3 suspend)" \
    "$NIXOS_DIR/modules/core/system.nix" 'mem_sleep_default=deep'
  has "Kernel: i915.enable_psr=0 (PSR flicker fix)" \
    "$NIXOS_DIR/modules/core/system.nix" 'i915\.enable_psr=0'

  # logind
  has "logind: powerKey → suspend"        "$NIXOS_DIR/system/configuration.nix" 'powerKey\s*=\s*"suspend"'
  has "logind: lidSwitch → ignore"        "$NIXOS_DIR/system/configuration.nix" 'lidSwitch\s*=\s*"ignore"'
  has "logind: powerKeyLongPress → off"   "$NIXOS_DIR/system/configuration.nix" 'powerKeyLongPress\s*=\s*"poweroff"'

  # hypridle config
  hasnt "hypridle: ignore_dbus_inhibit removed" \
    "$CONFIG_DIR/hypr/hypridle.conf"    '^\s*ignore_dbus_inhibit\s*=\s*true'
  hasnt "hypridle: ignore_systemd_inhibit removed" \
    "$CONFIG_DIR/hypr/hypridle.conf"    '^\s*ignore_systemd_inhibit\s*=\s*true'
  has   "hypridle: battery lock listener (120s)" \
    "$CONFIG_DIR/hypr/hypridle.conf"    'timeout\s*=\s*120'
  has   "hypridle: AC DPMS listener (600s)" \
    "$CONFIG_DIR/hypr/hypridle.conf"    'timeout\s*=\s*600'
  has   "hypridle: battery suspend listener (300s)" \
    "$CONFIG_DIR/hypr/hypridle.conf"    'timeout\s*=\s*300'
  has   "hypridle: AC suspend listener (1200s)" \
    "$CONFIG_DIR/hypr/hypridle.conf"    'timeout\s*=\s*1200'

  # hypridle service: single PATH source
  local orphans; orphans=$(grep -rn 'hypridle\.path\b\|zz-path\.conf' \
    "$NIXOS_DIR/modules/core/services.nix" \
    "$NIXOS_DIR/system/configuration.nix" 2>/dev/null \
    | grep -v '^\s*#\|#.*hypridle' | wc -l || true)
  [[ "$orphans" -eq 0 ]] \
    && _pass "hypridle: PATH in single location (no orphan .path or drop-in)" \
    || _fail "hypridle: $orphans orphan PATH definition(s) found"

  # idle scripts: bash syntax
  check "idle_sleep_poweroff.sh: bash syntax"    bash -n "$SCRIPTS_DIR/idle_sleep_poweroff.sh"
  check "idle_inhibit.sh: bash syntax"           bash -n "$SCRIPTS_DIR/idle_inhibit.sh"
  check "night_presence_check.sh: bash syntax"   bash -n "$SCRIPTS_DIR/night_presence_check.sh"
  check "dpms_handler.sh: bash syntax"           bash -n "$SCRIPTS_DIR/dpms_handler.sh"
  check "lock.sh: bash syntax"                   bash -n "$SCRIPTS_DIR/lock.sh"

  # idle_sleep_poweroff functional dry-runs (safe, no suspend/poweroff triggered)
  check "idle_sleep_poweroff --dry-run --battery: exits 0" \
    "$SCRIPTS_DIR/idle_sleep_poweroff.sh" --dry-run --battery
  check "idle_sleep_poweroff --dry-run --ac: exits 0" \
    "$SCRIPTS_DIR/idle_sleep_poweroff.sh" --dry-run --ac

  # night_presence_check dry-run (auto-press "I am here" button via swaync-client)
  (sleep 0.5 && swaync-client -a 0 >/dev/null 2>&1) &
  check "night_presence_check --dry-run: exits 0" \
    "$SCRIPTS_DIR/night_presence_check.sh" --dry-run

  # Live services
  svc_active "Live: hypridle.service" "hypridle" "--user"
  svc_active "Live: upower.service"   "upower"

  # Live battery
  local bat; bat=$(cat /sys/class/power_supply/BAT0/status   2>/dev/null || echo "Unknown")
  local cap; cap=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "?")
  _info "Live: Battery → $bat at ${cap}%"

  if grep -q "deep" /sys/power/mem_sleep 2>/dev/null; then
    _pass "Live: S3 deep sleep available (/sys/power/mem_sleep)"
  else
    _warn "Live: S3 deep sleep not listed in /sys/power/mem_sleep"
  fi

  module_end
}

# ==============================================================================
# MODULE: display 🖥️
# ==============================================================================
mod_display() {
  module_start "🖥️  display — Waybar, wallpaper daemon, lock screen, DPMS"

  # Waybar manager
  check "waybar_manager.sh: bash syntax" bash -n "$SCRIPTS_DIR/waybar_manager.sh"
  has   "waybar_manager: link_mode() defined"     "$SCRIPTS_DIR/waybar_manager.sh" 'link_mode\(\)'
  has   "waybar_manager: get_waybar_pids() defined" "$SCRIPTS_DIR/waybar_manager.sh" 'get_waybar_pids\(\)'
  has   "waybar_manager: --toggle support"        "$SCRIPTS_DIR/waybar_manager.sh" '"--toggle"'
  has   "waybar_manager: --startup support"       "$SCRIPTS_DIR/waybar_manager.sh" '"--startup"'
  has   "waybar_manager: --cycle support"         "$SCRIPTS_DIR/waybar_manager.sh" '"--cycle"'
  has   "waybar_manager: --select (rofi) support" "$SCRIPTS_DIR/waybar_manager.sh" '"--select"'

  # Waybar themes
  local themes; themes=$(find "$CONFIG_DIR/waybar" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
  if [[ "$themes" -gt 0 ]]; then _pass "Waybar: $themes theme dir(s) in config/waybar/"
  else _warn "Waybar: no theme directories found"; fi

  # lock.sh
  check "lock.sh: bash syntax" bash -n "$SCRIPTS_DIR/lock.sh"
  has "lock.sh: trap EXIT for process resume (leak-proof)" \
    "$SCRIPTS_DIR/lock.sh" 'trap resume_visual_processes EXIT'
  has "lock.sh: duplicate-lock guard"   "$SCRIPTS_DIR/lock.sh" 'pidof hyprlock'
  has "lock.sh: Hyprland WM support"   "$SCRIPTS_DIR/lock.sh" 'Hyprland'
  has "lock.sh: Niri WM support"       "$SCRIPTS_DIR/lock.sh" 'Niri'
  has "lock.sh: MangoWM support"       "$SCRIPTS_DIR/lock.sh" 'Mango'
  has "lock.sh: sysfs fallback"        "$SCRIPTS_DIR/lock.sh" '/sys/class/drm'
  has "lock.sh: tiny-screen config"    "$SCRIPTS_DIR/lock.sh" 'hyprlock_tiny'

  # dpms_handler
  check "dpms_handler.sh: bash syntax" bash -n "$SCRIPTS_DIR/dpms_handler.sh"
  has "dpms_handler: Hyprland handler" "$SCRIPTS_DIR/dpms_handler.sh" 'hyprctl'
  has "dpms_handler: Niri handler"     "$SCRIPTS_DIR/dpms_handler.sh" 'niri msg'
  has "dpms_handler: MangoWM handler"  "$SCRIPTS_DIR/dpms_handler.sh" 'mmsg'

  # screenshot
  check "screenshot.sh: bash syntax" bash -n "$SCRIPTS_DIR/screenshot.sh"

  # swaync JSON
  if python3 -m json.tool "$CONFIG_DIR/swaync/config.json" &>/dev/null; then
    _pass "swaync/config.json: valid JSON"
  else
    _fail "swaync/config.json: invalid JSON"
  fi

  # Live
  svc_active "Live: awww-daemon.service (wallpaper)" "awww-daemon" "--user"

  [[ -n "${WAYLAND_DISPLAY:-}" ]] \
    && _pass "Live: WAYLAND_DISPLAY set ($WAYLAND_DISPLAY)" \
    || _warn "Live: WAYLAND_DISPLAY not set (full display tests require Wayland session)"

  module_end
}

# ==============================================================================
# MODULE: shell 🐟
# ==============================================================================
mod_shell() {
  module_start "🐟  shell — Fish config, zoxide, abbrs, starship, CLI tools"

  # Fish syntax
  check "config.fish: fish -n (syntax valid)" fish -n "$CONFIG_DIR/fish/config.fish"

  # Zoxide: exactly 1 init (no double-init overhead)
  count_eq "Zoxide: exactly 1 init call in config.fish" \
    "$CONFIG_DIR/fish/config.fish" 'zoxide init fish' 1
  has "Zoxide: --cmd cd variant used (smart cd)" \
    "$CONFIG_DIR/fish/config.fish" 'zoxide init fish --cmd cd'

  # No hardcoded-path abbrs for Nix-managed wrappers
  hasnt "fish: no hardcoded path to nixreb.sh (use Nix wrapper)" \
    "$CONFIG_DIR/fish/config.fish" 'scripts/nixreb\.sh'
  hasnt "fish: no hardcoded path to awake script" \
    "$CONFIG_DIR/fish/config.fish" "scripts/awake'"
  hasnt "fish: no hardcoded flatpak gfn abbr (use gfn wrapper)" \
    "$CONFIG_DIR/fish/config.fish" 'geforcenow'
  hasnt "fish: no hardcoded flatpak roblox abbr" \
    "$CONFIG_DIR/fish/config.fish" 'vinegarhq'

  # Abbr sanity: key ones still present
  has "fish: git abbrs present (ga, gc, gp…)" \
    "$CONFIG_DIR/fish/config.fish" "abbr ga "
  has "fish: tmux abbrs present" \
    "$CONFIG_DIR/fish/config.fish" "abbr t 'tmux'"
  has "fish: yazi y wrapper defined" \
    "$CONFIG_DIR/fish/config.fish" 'function y'
  has "fish: Ctrl-o yazi hotkey bound" \
    "$CONFIG_DIR/fish/config.fish" "bind \\\\co"
  has "fish: agy wrapper function defined" \
    "$CONFIG_DIR/fish/config.fish" 'function agy'

  # Key tools available in PATH
  for tool in fish starship zoxide eza fzf rg fd bat tmux yazi nvim git; do
    if command -v "$tool" &>/dev/null; then _pass "PATH: $tool available"
    else _warn "PATH: $tool not found"; fi
  done

  # Starship TOML validity
  if python3 -c "import tomllib; tomllib.load(open('$CONFIG_DIR/starship.toml','rb'))" &>/dev/null 2>&1; then
    _pass "starship.toml: valid TOML"
  else
    _warn "starship.toml: python3 tomllib unavailable for validation"
  fi

  # Fish greeting function
  file_exists "fish_greeting.fish exists" "$CONFIG_DIR/fish/functions/fish_greeting.fish"
  check "fish_greeting.fish: fish -n (syntax)" \
    fish -n "$CONFIG_DIR/fish/functions/fish_greeting.fish"

  module_end
}

# ==============================================================================
# MODULE: scripts 📜
# ==============================================================================
mod_scripts() {
  module_start "📜  scripts — Bash/fish syntax on all 31+ scripts"

  # All .sh files
  while IFS= read -r -d '' f; do
    check "bash -n: $(basename "$f")" bash -n "$f"
  done < <(find "$SCRIPTS_DIR" -name "*.sh" -print0 2>/dev/null)

  # Scripts without extension
  for name in awake bluetooth wifi setting theme epic twitch share audio nixos gens tm project service services task tasks conf configs disk storage repo repos gitui ports port clip clips log logs journal container containers vm pkg pkgs s tunnelbear tb restore-ram ram tui-popup; do
    local f="$SCRIPTS_DIR/$name"
    [[ -f "$f" ]] && check "bash -n: $name" bash -n "$f"
  done

  # TUI scripts (dedicated folder)
  for name in wifi bluetooth setting theme share audio nixos tm service task conf disk repo ports clip log container pkg s tb ram app; do
    local f="$SCRIPTS_DIR/tui/$name"
    [[ -f "$f" ]] && check "bash -n: tui/$name" bash -n "$f"
  done

  # tui-popup: floating modal and toggle features
  has "tui-popup: floating kitty overlay"     "$SCRIPTS_DIR/tui-popup" 'tui-overlay'
  has "tui-popup: toggle state behavior"      "$SCRIPTS_DIR/tui-popup" 'STATE_FILE'

  # tui/setting: controls and latency optimizations
  has "tui/setting: brightness control"       "$SCRIPTS_DIR/tui/setting" 'cmd_brightness_menu'
  has "tui/setting: fast active wifi"         "$SCRIPTS_DIR/tui/setting" 'get_active_wifi_ssid'
  has "tui/setting: power session menu"       "$SCRIPTS_DIR/tui/setting" 'cmd_power_session_menu'

  # tui/s: fast telemetry and in-memory hotkeys
  has "tui/s: fast nixos generation symlink"  "$SCRIPTS_DIR/tui/s" '/nix/var/nix/profiles/system'
  has "tui/s: in-memory hotkeys map"          "$SCRIPTS_DIR/tui/s" 'get_tool_hotkeys'

  # tui/app: launcher and system sync features
  has "tui/app: fzf TUI launcher"             "$SCRIPTS_DIR/tui/app" 'fzf'
  has "tui/app: dynamic app dirs"             "$SCRIPTS_DIR/tui/app" 'get_app_dirs'
  has "tui/app: system environment sync"       "$SCRIPTS_DIR/tui/app" 'sync_system_environment'
  has "tui/s: app tool registered"            "$SCRIPTS_DIR/tui/s" 'app\|desktop'

  # Python script
  check "agy-tokens.py: python3 syntax" \
    python3 -m py_compile "$SCRIPTS_DIR/agy-tokens.py"

  # tui/ram: key safety, TUI and memory features
  has "tui/ram: fzf TUI menu"                 "$SCRIPTS_DIR/tui/ram" 'fzf'
  has "tui/ram: --dry-run mode"               "$SCRIPTS_DIR/tui/ram" 'DRY_RUN'
  has "tui/ram: whitelist protection"         "$SCRIPTS_DIR/tui/ram" 'WHITELIST_COMMS'
  has "tui/ram: memory stats calculation"     "$SCRIPTS_DIR/tui/ram" 'get_ram_used_mb'
  has "tui/s: ram tool registered"            "$SCRIPTS_DIR/tui/s" 'ram\|system'

  # nixreb: cores ≤ hw threads
  local cores hw
  cores=$(grep -oP '(?<=--cores )\d+' "$SCRIPTS_DIR/nixreb.sh" 2>/dev/null || echo "0")
  hw=$(nproc 2>/dev/null || echo "4")
  if [[ "$cores" -le "$hw" && "$cores" -gt 0 ]]; then
    _pass "nixreb.sh: --cores $cores ≤ hw threads ($hw) ✓"
  else
    _fail "nixreb.sh: --cores $cores vs hw threads $hw — mismatch"
  fi

  # nixreb: --impure flag documented
  has "nixreb.sh: set -euo pipefail"   "$SCRIPTS_DIR/nixreb.sh" 'set -euo pipefail'
  has "nixreb.sh: syncs to /etc/nixos" "$SCRIPTS_DIR/nixreb.sh" 'TARGET_DIR="\/etc\/nixos"'
  has "nixreb.sh: rsync command used"  "$SCRIPTS_DIR/nixreb.sh" 'rsync\s+-av'

  # idle_sleep_poweroff: key safety features
  has "idle_sleep_poweroff: flock singleton guard"   "$SCRIPTS_DIR/idle_sleep_poweroff.sh" 'flock -n'
  has "idle_sleep_poweroff: --dry-run mode"          "$SCRIPTS_DIR/idle_sleep_poweroff.sh" 'DRY_RUN'
  has "idle_sleep_poweroff: D-Bus monitor coproc"    "$SCRIPTS_DIR/idle_sleep_poweroff.sh" 'coproc DBUS_MON'
  has "idle_sleep_poweroff: grace period loop"       "$SCRIPTS_DIR/idle_sleep_poweroff.sh" 'GRACE_PERIOD_SECS'

  # night_presence_check: key safety features
  has "night_presence_check: time window guard"      "$SCRIPTS_DIR/night_presence_check.sh" 'CURRENT_HOUR'
  has "night_presence_check: --dry-run mode"         "$SCRIPTS_DIR/night_presence_check.sh" 'DRY_RUN'
  has "night_presence_check: awake mode bypass"      "$SCRIPTS_DIR/night_presence_check.sh" 'idle_inhibit'

  module_end
}

# ==============================================================================
# MODULE: services ⚙️
# ==============================================================================
mod_services() {
  module_start "⚙️  services — systemd units, timers, and service health"

  # System services
  for svc in NetworkManager bluetooth postgresql upower udisks2 samba-wsdd; do
    svc_active "System: $svc" "$svc"
  done

  # User services
  for svc in hypridle awww-daemon pipewire wireplumber pipewire-pulse dbus gvfs-daemon; do
    svc_active "User: $svc" "$svc" "--user"
  done

  # Timers
  local tc; tc=$(systemctl list-timers --all --no-legend 2>/dev/null | wc -l)
  _info "Active timers: $tc"

  for timer in night-presence-check fstrim nh-clean logrotate systemd-tmpfiles-clean; do
    if systemctl list-timers --all 2>/dev/null | grep -q "$timer"; then
      _pass "Timer: $timer"
    else
      _warn "Timer: $timer not found"
    fi
  done

  # Failed units
  local sf uf
  sf=$(systemctl list-units --state=failed --no-legend 2>/dev/null | wc -l)
  uf=$(systemctl --user list-units --state=failed --no-legend 2>/dev/null | wc -l)
  [[ $sf -eq 0 ]] && _pass "System: 0 failed units" || _fail "System: $sf failed unit(s)"
  [[ $uf -eq 0 ]] && _pass "User: 0 failed units"   || _fail "User: $uf failed unit(s)"

  # Night presence check timer config
  has "services.nix: WakeSystem = true on night timer" \
    "$NIXOS_DIR/modules/core/services.nix" 'WakeSystem\s*=\s*true'

  # virtualisation & VPN
  has  "Docker: enabled" "$NIXOS_DIR/modules/core/services.nix" 'docker\.enable\s*=\s*true'
  has  "libvirtd: enabled" "$NIXOS_DIR/modules/core/services.nix" 'libvirtd\.enable\s*=\s*true'
  has  "Hamachi: enabled" "$NIXOS_DIR/modules/core/services.nix" 'services\.logmein-hamachi\.enable\s*=\s*true'
  has  "Haguichi: enabled" "$NIXOS_DIR/modules/core/services.nix" 'programs\.haguichi\.enable\s*=\s*true'

  # libvirtd orphan pool check
  if virsh pool-list --all 2>/dev/null | grep -q "WindowsVM\|pool"; then
    local pool_state; pool_state=$(virsh pool-list --all 2>/dev/null | grep -E "pool|WindowsVM" | awk '{print $2}' | head -1)
    if [[ "$pool_state" == "inactive" ]]; then
      _warn "libvirtd: storage pool is inactive (missing dir?) — run: virsh pool-undefine pool"
    else
      _pass "libvirtd: storage pool state: $pool_state"
    fi
  else
    _pass "libvirtd: no orphan/inactive storage pools detected"
  fi

  module_end
}

# ==============================================================================
# MODULE: storage 💾
# ==============================================================================
mod_storage() {
  module_start "💾  storage — Disk space, Nix store, RAM/swap health"

  # Root filesystem
  local rp; rp=$(df / --output=pcent 2>/dev/null | tail -1 | tr -d ' %')
  if   [[ "$rp" -lt 85 ]]; then _pass "Root /: ${rp}% used (< 85% ✓)"
  elif [[ "$rp" -lt 95 ]]; then _warn "Root /: ${rp}% used (getting full — run: sudo nix-collect-garbage -d)"
  else _fail "Root /: ${rp}% used (critical!)"; fi

  # Boot partition
  local bp; bp=$(df /boot --output=pcent 2>/dev/null | tail -1 | tr -d ' %')
  if [[ "$bp" -lt 80 ]]; then _pass "Boot /boot: ${bp}% used (< 80% ✓)"
  else _warn "Boot /boot: ${bp}% used — clean old generations"; fi

  # Nix store
  local si; si=$(ls /nix/store 2>/dev/null | wc -l)
  _info "Nix store: $si items"

  has "Nix: auto-optimise-store = true (dedup on build)" \
    "$NIXOS_DIR/modules/core/system.nix" 'auto-optimise-store\s*=\s*true'

  has "Nix: systemd-boot configurationLimit = 5 (boot cleanup)" \
    "$NIXOS_DIR/modules/core/system.nix" 'configurationLimit\s*=\s*5'

  # Swap usage
  local st sc su sp
  st=$(grep SwapTotal /proc/meminfo | awk '{print $2}')
  sc=$(grep SwapFree  /proc/meminfo | awk '{print $2}')
  su=$(( st - sc ))
  if [[ "$st" -gt 0 ]]; then
    sp=$(( su * 100 / st ))
    if   [[ $sp -lt 30 ]]; then _pass "Swap: ${sp}% used (${su}K / ${st}K ✓)"
    elif [[ $sp -lt 60 ]]; then _warn "Swap: ${sp}% used — moderate"
    else                        _fail "Swap: ${sp}% used — high, check memory pressure"; fi
  fi

  # RAM available
  local ma; ma=$(( $(grep MemAvailable /proc/meminfo | awk '{print $2}') / 1024 ))
  if   [[ $ma -gt 1024 ]]; then _pass "RAM available: ${ma} MiB (> 1 GiB ✓)"
  elif [[ $ma -gt 256  ]]; then _warn "RAM available: ${ma} MiB (consider closing apps)"
  else                          _fail "RAM available: ${ma} MiB (critically low)"; fi

  # SSD TRIM
  check_warn "SSD: fstrim.timer active (periodic TRIM)" systemctl is-active --quiet fstrim.timer

  # Swap partition defined
  has "Swap: partition defined in hardware-config" \
    "$NIXOS_DIR/system/hardware-configuration.nix" 'swapDevices'

  module_end
}

# ==============================================================================
# MODULE: kernel 🐧
# ==============================================================================
mod_kernel() {
  module_start "🐧  kernel — Boot, CPU, GPU, sysctl, sleep, security"

  _info "Running kernel: $(uname -r)"

  # Boot
  has "Bootloader: systemd-boot enabled" \
    "$NIXOS_DIR/modules/core/system.nix"  'systemd-boot\.enable\s*=\s*true'
  has "Bootloader: EFI writable"         \
    "$NIXOS_DIR/modules/core/system.nix"  'canTouchEfiVariables\s*=\s*true'
  has "Bootloader: configurationLimit = 5" \
    "$NIXOS_DIR/modules/core/system.nix"  'configurationLimit\s*=\s*5'
  has "Kernel: mem_sleep_default=deep"   \
    "$NIXOS_DIR/modules/core/system.nix"  'mem_sleep_default=deep'
  has "Kernel: i915.enable_psr=0"       \
    "$NIXOS_DIR/modules/core/system.nix"  'i915\.enable_psr=0'

  # CPU
  has "CPU: kvm-intel module loaded"     \
    "$NIXOS_DIR/system/hardware-configuration.nix" 'kvm-intel'
  has "CPU: Intel microcode auto-update" \
    "$NIXOS_DIR/system/hardware-configuration.nix" 'intel\.updateMicrocode'

  # GPU
  has "GPU: Intel media-driver (VA-API HEVC/AVC)" \
    "$NIXOS_DIR/modules/core/system.nix"  'intel-media-driver'
  has "GPU: intel-vaapi-driver (legacy)" \
    "$NIXOS_DIR/modules/core/system.nix"  'intel-vaapi-driver'
  has "GPU: libvdpau-va-gl (VDPAU→VA-API bridge)" \
    "$NIXOS_DIR/modules/core/system.nix"  'libvdpau-va-gl'
  has "GPU: hardware.graphics.enable"   \
    "$NIXOS_DIR/modules/core/system.nix"  'hardware\.graphics'

  # Security
  has "Security: rtkit enabled (low-latency audio)" \
    "$NIXOS_DIR/modules/core/system.nix" 'security\.rtkit\.enable\s*=\s*true'
  has "Security: polkit enabled" \
    "$NIXOS_DIR/modules/core/system.nix" 'security\.polkit'

  # /bin/bash symlink script
  has "FHS: activation script creates /bin/bash symlink" \
    "$NIXOS_DIR/modules/core/system.nix" '/bin/bash'

  # NIXOS_OZONE_WL
  has "Env: NIXOS_OZONE_WL=1 (Electron Wayland)" \
    "$NIXOS_DIR/modules/core/system.nix" 'NIXOS_OZONE_WL'
  has "Env: QT_QPA_PLATFORM=wayland" \
    "$NIXOS_DIR/modules/core/system.nix" 'QT_QPA_PLATFORM'

  # Live sysctl checks
  local sw; sw=$(sysctl -n vm.swappiness 2>/dev/null || echo "?")
  local cp; cp=$(sysctl -n vm.vfs_cache_pressure 2>/dev/null || echo "?")
  local kt; kt=$(sysctl -n net.ipv4.tcp_keepalive_time 2>/dev/null || echo "?")
  _info "Live sysctl: vm.swappiness=$sw  vfs_cache_pressure=$cp  tcp_keepalive_time=$kt"

  # S3 deep sleep
  if grep -q "deep" /sys/power/mem_sleep 2>/dev/null; then
    _pass "Live: S3 deep sleep available in /sys/power/mem_sleep"
  else
    _warn "Live: S3 deep sleep not in /sys/power/mem_sleep"
  fi

  # uinput (needed for input remapping)
  has "uinput: enabled" "$NIXOS_DIR/system/configuration.nix" 'hardware\.uinput\.enable\s*=\s*true'

  module_end
}

# ==============================================================================
# MODULE: configs 📄
# ==============================================================================
mod_configs() {
  module_start "📄  configs — JSON, TOML, and key config file validation"

  # JSON configs
  for f in \
    "$CONFIG_DIR/swaync/config.json" \
    "$CONFIG_DIR/pinchtab/config.json"; do
    if [[ -f "$f" ]]; then
      if python3 -m json.tool "$f" &>/dev/null; then
        _pass "JSON valid: ${f#"$DOTFILES/"}"
      else
        _fail "JSON invalid: ${f#"$DOTFILES/"}"
      fi
    else
      _warn "JSON missing: ${f#"$DOTFILES/"}"
    fi
  done

  # Waybar JSON/JSONC theme configs (Waybar natively supports // and /* */ comments)
  local wok=0 wfail=0
  while IFS= read -r -d '' f; do
    if python3 -c '
import sys, re, json
with open(sys.argv[1]) as fp:
    c = fp.read()
c = re.sub(r"//.*", "", c)
c = re.sub(r"/\*.*?\*/", "", c, flags=re.DOTALL)
c = re.sub(r",\s*([\]}])", r"\1", c)
json.loads(c)
' "$f" &>/dev/null; then
      wok=$(( wok + 1 ))
    else
      _fail "Waybar JSONC invalid: $(dirname "$f" | xargs basename)"
      wfail=$(( wfail + 1 ))
    fi
  done < <(find "$CONFIG_DIR/waybar" -name "config" -print0 2>/dev/null)
  [[ $wok -gt 0 && $wfail -eq 0 ]] && _pass "Waybar: $wok theme config(s) valid JSON/JSONC"
  [[ $wfail -gt 0 ]] && _fail "Waybar: $wfail invalid theme config(s)"

  # TOML
  if python3 -c "import tomllib; tomllib.load(open('$CONFIG_DIR/starship.toml','rb'))" &>/dev/null 2>&1; then
    _pass "TOML valid: starship.toml"
  else
    _warn "starship.toml: python3 tomllib unavailable"
  fi

  # Hypr configs
  for f in hypridle.conf hyprlock.conf; do
    file_exists "Config exists: hypr/$f" "$CONFIG_DIR/hypr/$f"
  done

  # Tmux
  file_exists "Config exists: tmux/tmux.conf"  "$CONFIG_DIR/tmux/tmux.conf"
  check       "tmux/cheatsheet.sh: bash syntax" bash -n "$CONFIG_DIR/tmux/cheatsheet.sh"

  # Kitty / Rofi
  file_exists "Config exists: kitty/kitty.conf" "$CONFIG_DIR/kitty/kitty.conf"
  file_exists "Config dir exists: rofi/"         "$CONFIG_DIR/rofi"

  # Yazi
  file_exists "Config dir exists: yazi/"  "$CONFIG_DIR/yazi"

  # mango
  file_exists "Config dir exists: mango/" "$CONFIG_DIR/mango"

  # Neovim
  file_exists "Config exists: nvim/init.lua" "$CONFIG_DIR/nvim/init.lua"
  check       "Neovim config: syntax & startup check" nvim --headless -c "qa!"

  module_end
}

# ==============================================================================
# MODULE: packages 📦
# ==============================================================================
mod_packages() {
  module_start "📦  packages — Duplicates, insecure packages, key tools"

  # Duplicate gtk3 / glib
  count_eq "pkgs.nix: gtk3 declared exactly once" \
    "$NIXOS_DIR/modules/pkgs.nix" '^\s+gtk3$' 1
  count_eq "pkgs.nix: glib declared exactly once" \
    "$NIXOS_DIR/modules/pkgs.nix" '^\s+glib$' 1

  # Fonts: not in pkgs.nix systemPackages
  hasnt "pkgs.nix: nerd-fonts not in systemPackages (lives in fonts.packages)" \
    "$NIXOS_DIR/modules/pkgs.nix" 'nerd-fonts\.jetbrains-mono'
  hasnt "pkgs.nix: font-awesome not in systemPackages" \
    "$NIXOS_DIR/modules/pkgs.nix" '^\s+font-awesome$'

  # Fonts: in system.nix fonts block (canonical)
  has "system.nix: nerd-fonts in fonts.packages" \
    "$NIXOS_DIR/modules/core/system.nix" 'nerd-fonts\.jetbrains-mono'
  has "system.nix: font-awesome in fonts.packages" \
    "$NIXOS_DIR/modules/core/system.nix" 'font-awesome'

  # Insecure packages warning
  if grep -q "permittedInsecurePackages" "$NIXOS_DIR/modules/core/system.nix" 2>/dev/null; then
    local pkg; pkg=$(grep -oP '(?<=")\S+(?=")' "$NIXOS_DIR/modules/core/system.nix" \
      | grep -E "openssl|electron" || echo "see system.nix")
    _warn "Insecure package(s) permitted: $pkg — investigate: nix why-depends .#nixosConfigurations.nixos.config.system.build.toplevel $pkg"
  else
    _pass "No insecure packages permitted in system.nix"
  fi

  # Key packages declared
  for pkg in firefox neovim fish tmux git kitty; do
    if grep -qP "^\s+${pkg}$" "$NIXOS_DIR/modules/pkgs.nix" 2>/dev/null; then
      _pass "Package: $pkg declared in pkgs.nix"
    else
      _warn "Package: $pkg not found by simple grep in pkgs.nix"
    fi
  done
  has "pkgs.nix: libredb-studio declared" \
    "$NIXOS_DIR/modules/pkgs.nix" 'libredb-studio'
  has "pkgs.nix: bruno declared" \
    "$NIXOS_DIR/modules/pkgs.nix" '^\s+bruno$'

  # Unstable packages count
  local uc; uc=$(grep -c 'pkgs_unstable\.' "$NIXOS_DIR/modules/pkgs.nix" \
    "$NIXOS_DIR/system/configuration.nix" 2>/dev/null | awk -F: '{s+=$2} END{print s}')
  _info "Packages from pkgs_unstable: $uc"

  # Fish listed twice in pkgs.nix (once terminal, once Hakuspace)
  local fc; fc=$(grep -cP '^\s+fish$' "$NIXOS_DIR/modules/pkgs.nix" 2>/dev/null || true)
  [[ $fc -le 2 ]] && _pass "pkgs.nix: fish count ×$fc (acceptable)" \
                  || _warn  "pkgs.nix: fish count ×$fc (check for over-duplication)"

  module_end
}

# ==============================================================================
# Module registry and entry point
# ==============================================================================

declare -A MOD_DESC=(
  [nix]="❄️  Flake evaluation & .nix file parsing"
  [security]="🔒  PostgreSQL auth, Samba, firewall, polkit"
  [network]="🌐  NetworkManager, TCP sysctl, VM tunables, connectivity"
  [bluetooth]="🔵  Config correctness, journal errors, service health"
  [audio]="🔊  PipeWire stack, ALSA, JACK, hardware quirks"
  [power]="⚡  hypridle, idle scripts, battery, logind, kernel sleep"
  [display]="🖥️  Waybar, wallpaper, lock screen, DPMS"
  [shell]="🐟  Fish config, zoxide, abbrs, starship, CLI tools"
  [scripts]="📜  Bash/fish syntax on all 31+ scripts"
  [services]="⚙️  systemd units, timers, and service health"
  [storage]="💾  Disk space, Nix store, RAM/swap health"
  [kernel]="🐧  Boot, CPU, GPU, sysctl, sleep, security params"
  [configs]="📄  JSON, TOML, and key config file validation"
  [packages]="📦  Duplicates, insecure packages, key tools"
)
MODULE_ORDER=(nix security network bluetooth audio power display shell scripts services storage kernel configs packages)

_run_mod() {
  case "$1" in
    nix)       mod_nix ;;
    security)  mod_security ;;
    network)   mod_network ;;
    bluetooth) mod_bluetooth ;;
    audio)     mod_audio ;;
    power)     mod_power ;;
    display)   mod_display ;;
    shell)     mod_shell ;;
    scripts)   mod_scripts ;;
    services)  mod_services ;;
    storage)   mod_storage ;;
    kernel)    mod_kernel ;;
    configs)   mod_configs ;;
    packages)  mod_packages ;;
    *)
      echo -e "${RED}Unknown module: $1${RESET}  —  run '${BOLD}nixtest modules${RESET}' to see available modules"
      exit 1
      ;;
  esac
}

_print_summary() {
  local total=$(( TOTAL_PASS + TOTAL_FAIL ))
  echo ""
  echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  if [[ $TOTAL_FAIL -eq 0 && $TOTAL_WARN -eq 0 ]]; then
    echo -e " ${GREEN}${BOLD}✅  $TOTAL_PASS / $total tests passed — system all clear!${RESET}"
  elif [[ $TOTAL_FAIL -eq 0 ]]; then
    echo -e " ${YELLOW}${BOLD}✅  $TOTAL_PASS / $total passed  ($TOTAL_WARN warning(s) — check above)${RESET}"
  else
    echo -e " ${RED}${BOLD}❌  $TOTAL_PASS / $total passed  ($TOTAL_FAIL failed · $TOTAL_WARN warnings)${RESET}"
  fi
  echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  echo ""
  [[ $TOTAL_FAIL -eq 0 ]] && exit 0 || exit 1
}

case "${1:-help}" in
  modules|list)
    echo ""
    echo -e "${BOLD}${CYAN}nixtest — ${#MODULE_ORDER[@]} available modules:${RESET}"
    echo ""
    for m in "${MODULE_ORDER[@]}"; do
      printf "  ${BOLD}%-12s${RESET}  %s\n" "$m" "${MOD_DESC[$m]}"
    done
    echo ""
    echo -e "  ${BOLD}nixtest all${RESET}              — run all modules"
    echo -e "  ${BOLD}nixtest <module>${RESET}          — run one module"
    echo -e "  ${BOLD}nixtest <m1> <m2> …${RESET}      — run multiple modules"
    echo ""
    ;;

  all)
    echo ""
    echo -e "${BOLD}${CYAN}╔═══════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${CYAN}║  nixtest — Running all ${#MODULE_ORDER[@]} modules                       ║${RESET}"
    echo -e "${BOLD}${CYAN}╚═══════════════════════════════════════════════════════╝${RESET}"
    for m in "${MODULE_ORDER[@]}"; do _run_mod "$m"; done
    _print_summary
    ;;

  help|--help|-h)
    echo ""
    echo -e "${BOLD}nixtest${RESET} — Peng's NixOS modular system test suite"
    echo ""
    echo "  nixtest all              Run all ${#MODULE_ORDER[@]} modules (~1–2 min, includes dry-build)"
    echo "  nixtest modules          List all modules with descriptions"
    echo "  nixtest <module>         Run a single module"
    echo "  nixtest <m1> <m2> …      Run specific modules"
    echo ""
    echo -e "  Modules: ${BOLD}${MODULE_ORDER[*]}${RESET}"
    echo ""
    echo "  All tests are read-only — system is never modified."
    echo ""
    ;;

  *)
    echo ""
    echo -e "${BOLD}${CYAN}╔═══════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${CYAN}║  nixtest — Module(s): $*$(printf '%*s' $((45 - ${#*})) '')║${RESET}"
    echo -e "${BOLD}${CYAN}╚═══════════════════════════════════════════════════════╝${RESET}"
    for arg in "$@"; do _run_mod "$arg"; done
    _print_summary
    ;;
esac
