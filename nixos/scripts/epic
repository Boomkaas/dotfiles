#!/usr/bin/env bash
# epic — Open Epic Games Store in native Firefox to claim weekly free games
set -euo pipefail

FREE_GAMES_URL="https://store.epicgames.com/en-US/free-games"

echo "🎮 Launching Epic Games Store in your native Firefox..."

# Opens a new tab in your already-running, logged-in Firefox instance
firefox "$FREE_GAMES_URL" >/dev/null 2>&1 &

# If running Hyprland, focus the Firefox window
if command -v hyprctl >/dev/null 2>&1; then
  sleep 0.4
  hyprctl dispatch focuswindow class:firefox 2>/dev/null || true
fi

echo "✨ Native Firefox opened. The Epic Games Auto-Claimer will handle the rest!"
