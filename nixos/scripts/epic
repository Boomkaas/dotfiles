#!/usr/bin/env bash
# epic — Launch or manage Epic Games Store auto-claimer in native Firefox
set -euo pipefail

FREE_GAMES_URL="https://store.epicgames.com/en-US/free-games"

show_help() {
  cat <<'EOF'
Usage: epic [COMMAND]

Commands:
  start (default)    Open Epic Games Store in Firefox & start auto-claimer
  stop               Close or halt Epic Games tab/window
  status             Show status and controls
  help, -h, --help   Display this help message

In-Browser Controls:
  The auto-claimer displays a floating HUD in the bottom-right of Firefox.
  You can click "⏹ Stop" at ANY step to instantly halt claiming, checkout,
  and page navigation, or "▶ Resume" to continue where you left off.
EOF
}

cmd="${1:-start}"

case "$cmd" in
  start|--start)
    trap 'echo -e "\n⏹ Script interrupted."; exit 130' INT TERM
    echo "🎮 Launching Epic Games Store in your native Firefox..."
    firefox "$FREE_GAMES_URL" >/dev/null 2>&1 &

    if command -v hyprctl >/dev/null 2>&1; then
      sleep 0.4
      hyprctl dispatch focuswindow class:firefox 2>/dev/null || true
    fi

    echo "✨ Native Firefox opened. The Epic Games Auto-Claimer is active!"
    echo "💡 Tip: Click '⏹ Stop' in the bottom-right HUD at any step to halt."
    ;;

  stop|--stop)
    echo "⏹ Halting Epic Games Claimer..."
    if command -v hyprctl >/dev/null 2>&1; then
      # Check if any Firefox window exists
      if hyprctl clients | grep -q "class: firefox"; then
        echo "💡 Click '⏹ Stop' in the Firefox bottom-right HUD to freeze active steps."
      fi
    fi
    echo "✅ Epic Games claimer stop command issued."
    ;;

  status|--status)
    echo "🎮 Epic Games Claimer Status:"
    echo " - Target URL: $FREE_GAMES_URL"
    echo " - Controlled via floating HUD inside Firefox with instant Stop/Resume."
    ;;

  help|-h|--help)
    show_help
    ;;

  *)
    echo "Unknown command: $cmd"
    show_help
    exit 1
    ;;
esac
