{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node --test:*)",
      "Bash(nixtest:*)",
      "Bash(nix-instantiate --parse:*)",
      "Bash(nixos-rebuild dry-build:*)"
    ],
    "ask": [
      "Bash(nixreb:*)",
      "Bash(nixos-rebuild switch:*)",
      "Bash(nixos-rebuild boot:*)",
      "Bash(nh os:*)",
      "Bash(nh clean:*)",
      "Bash(nix flake update:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)"
    ]
  }
}
