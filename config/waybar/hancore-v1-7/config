{
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "top",
    "spacing": 0,
    "height": 0,
    "width": 1440,
    "margin-top": 0,
    "margin-bottom": 0,
    "modules-left": [
        "custom/menu",
        "ext/workspaces",
        "custom/separator"
    ],
    "modules-center": [
        "clock",
        "custom/notification"
    ],
    "modules-right": [
        "group/right2",
        "group/right"
    ],
    "group/right2": {
        "orientation": "inherit",
        "modules": [
            "mpris"
        ]
    },
    "group/right": {
        "orientation": "inherit",
        "modules": [
            "group/tray-expander",
            "network",
            "pulseaudio",
            "memory",
            "cpu",
            "battery"
        ]
    },
    "custom/separator": {
        "format": "|",
        "tooltip": false
    },
    "cpu": {
        "interval": 2,
        "format": "<span size='6pt'>CPU </span>{usage:02}%",
        "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "memory": {
        "interval": 2,
        "format": "<span size='6pt'>MEM </span>{percentage:02}%",
        "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:L%d %B W%V %Y}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#e6e6e6'><b>{}</b></span>",
                "weekdays": "<span color='#e6e6e6'><b>{}</b></span>",
                "today": "<span color='#e6e6e6'><b>{}</b></span>"
            }
        },
        "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
    },
    "network": {
        "format-icons": [
            "\udb82\udd2f",
            "\udb82\udd1f",
            "\udb82\udd22",
            "\udb82\udd25",
            "\udb82\udd28"
        ],
        "format": "{icon}",
        "format-wifi": "<span size='6pt'>NET </span>{essid}",
        "format-ethernet": "<span size='6pt'>NET </span>{bandwidthDownBytes}",
        "format-disconnected": "\udb82\udd2e",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
        "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "omarchy-launch-wifi"
    },
    "battery": {
        "format": "<span size='6pt'>BAT </span>{capacity}%",
        "format-discharging": "<span size='6pt'>BAT </span>{capacity}%",
        "format-charging": "<span size='6pt'>BAT_c </span>{capacity}%",
        "format-plugged": "<span size='6pt'>BAT_p </span>{capacity}%",
        "format-icons": {
            "charging": [
                "\udb82\udc9c",
                "\udb80\udc86",
                "\udb80\udc87",
                "\udb80\udc88",
                "\udb82\udc9d",
                "\udb80\udc89",
                "\udb82\udc9e",
                "\udb80\udc8a",
                "\udb80\udc8b",
                "\udb80\udc85"
            ],
            "default": [
                "\udb80\udc7a",
                "\udb80\udc7b",
                "\udb80\udc7c",
                "\udb80\udc7d",
                "\udb80\udc7e",
                "\udb80\udc7f",
                "\udb80\udc80",
                "\udb80\udc81",
                "\udb80\udc82",
                "\udb80\udc79"
            ]
        },
        "format-full": "<span size='6pt'>BAT_f </span>{capacity}%",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "on-click": "omarchy-menu power",
        "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "\uf294",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\uf294",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "omarchy-launch-bluetooth"
    },
    "pulseaudio": {
        "format": "<span size='6pt'>VOL </span>{volume}%",
        "on-click": "omarchy-launch-audio",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "\ueee8",
        "format-icons": {
            "headphone": "\uf025",
            "headset": "\uf025",
            "default": [
                "\uf026",
                "\uf027",
                "\uf028"
            ]
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "rotate": 0,
        "format": "{icon}",
        "tooltip-format": "\ud83c\udf15 {percent}%",
        "format-icons": [
            "\udb80\udcdc",
            "\udb80\udcdd",
            "\udb80\udcde",
            "\udb80\udcdf",
            "\udb80\udce0"
        ]
    },
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item"
        },
        "modules": [
            "custom/expand-icon",
            "tray",
            "backlight",
            "bluetooth"
        ]
    },
    "custom/expand-icon": {
        "format": "\uf053",
        "tooltip": false
    },
    "tray": {
        "icon-size": 11,
        "spacing": 5
    },
    "mpris": {
        "format": "\uec1b {artist} - {title}",
        "format-paused": "<span color='grey'>{status_icon}  {title}</span>",
        "max-length": 45,
        "player-icons": {
            "default": "\u23f8",
            "mpv": "\ud83c\udfb5"
        },
        "status-icons": {
            "paused": "\udb81\udf5b"
        },
        "ignored-players": [
            "firefox",
            "chromium",
            "brave"
        ]
    },
    "ext/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-direction": "true"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus",
        "tooltip-format": "{title} ({app_id})",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize",
        "all-outputs": true
    },
    "custom/menu": {
        "format": "\udb82\udfaf",
        "tooltip": true,
        "tooltip-format": "Application Menu",
        "on-click": "$HOME/.local/bin/hakumenu.sh"
    },
    "custom/power": {
        "format": "\u23fb",
        "tooltip": true,
        "tooltip-format": "Shutdown Menu",
        "on-click": "$HOME/.local/bin/shutdown.sh"
    },
    "custom/nightlight": {
        "format": "\udb80\udcdb",
        "tooltip": true,
        "tooltip-format": "Toggle Night Light",
        "on-click": "$HOME/.local/bin/nightlight_toggle.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "\udb80\udc9a<span foreground='#e6e6e6'><sup></sup></span>",
            "none": "\udb80\udc9a",
            "dnd-notification": "<span foreground='#e6e6e6'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "\udb80\udc9a<span foreground='#e6e6e6'><sup></sup></span>",
            "inhibited-none": "\udb80\udc9a",
            "dnd-inhibited-notification": "\udb80\udc9b<span foreground='#e6e6e6'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "temperature": {
        "interval": 2,
        "format": "\uf2c9 {temperatureC}\u00b0C",
        "tooltip": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb83\udfaa"
        }
    },
    "layer": "overlay"
}