{
    "reload_style_on_change": true,
    "layer": "overlay",
    "position": "top",
    "mod": "dock",
    "margin-left": 250,
    "margin-right": 250,
    "margin-top": 4,
    "modules-left": [
        "custom/menu",
        "clock",
        "custom/notification",
        "tray",
        "custom/power",
        "idle_inhibitor",
        "backlight",
        "battery",
        "wlr/taskbar",
        "mpris"
    ],
    "modules-center": [
        "ext/workspaces"
    ],
    "modules-right": [
        "memory",
        "cpu",
        "pulseaudio",
        "bluetooth",
        "network",
        "disk"
    ],
    "custom/menu": {
        "format": "\udb82\udfaf",
        "tooltip": true,
        "tooltip-format": "Application Menu",
        "on-click": "$HOME/.local/bin/hakumenu.sh"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "\uf0e7",
            "performance": "\uf0e7",
            "balanced": "\uf24e",
            "power-saver": "\udb83\udf86"
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip-format-activated": "Stay Awake: ON",
        "tooltip-format-deactivated": "Stay Awake: OFF",
        "format-icons": {
            "activated": "\udb81\udee8",
            "deactivated": "\udb81\udee9"
        }
    },
    "tray": {
        "icon-size": 13,
        "spacing": 4
    },
    "mpris": {
        "format": "{dynamic}",
        "format-paused": " {status_icon} {dynamic}",
        "format-disabled": "",
        "interval": 5,
        "dynamic-order": [
            "artist",
            "position",
            "length"
        ],
        "dynamic-importance-order": [
            "position",
            "length",
            "artist"
        ],
        "tooltip-format": "{player} ({status}):\n{artist} - {title}"
    },
    "memory": {
        "format": "MEM {used:0.1f} GiB",
        "tooltip-format": "Used {percentage}%\n{used:0.1f}GB/{total:0.1f}GB",
        "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "cpu": {
        "format": "CPU {usage:02}%",
        "tooltip-format": "CPU: {usage}%",
        "on-click": "omarchy-launch-or-focus-tui btop"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "tooltip-format": "Volume: {volume}%",
        "on-click": "omarchy-launch-audio",
        "on-click-right": "pamixer -t"
    },
    "bluetooth": {
        "format": "BT{num_connections}",
        "format-disabled": "BT",
        "format-off": "BT",
        "format-connected": "BT{num_connections}",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "omarchy-launch-bluetooth"
    },
    "network": {
        "format-icons": [
            "\udb82\udd2f",
            "\udb82\udd1f",
            "\udb82\udd22",
            "\udb82\udd25",
            "\udb82\udd28"
        ],
        "format": "NET",
        "format-wifi": "NET {essid}",
        "format-ethernet": "NET {ifname}",
        "format-disconnected": "NET",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
        "tooltip-format-ethernet": "ETHERNET",
        "tooltip-format-disconnected": "Disconnected"
    },
    "disk": {
        "format": "DISK {percentage_used}%",
        "tooltip-format": "Total ROOT: {used}/{total}",
        "unit": "GB",
        "path": "/",
        "interval": 30
    },
    "custom/weather": {
        "format": "{}\u00b0",
        "interval": 1800,
        "exec": "wttrbar",
        "return-type": "json"
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-discharging": "BAT {capacity}%",
        "format-charging": "BAT {capacity}%",
        "format-plugged": "\uf1e6",
        "format-icons": {
            "charging": [
                "\udb82\udc9c",
                "\udb80\udc86",
                "\udb80\udc87",
                "\udb80\udc88",
                "\udb82\udc9d",
                "\udb80\udc89",
                "\udb82\udc9e",
                "\udb80\udc8a",
                "\udb80\udc8b",
                "\udb80\udc85"
            ],
            "default": [
                "\udb80\udc7a",
                "\udb80\udc7b",
                "\udb80\udc7c",
                "\udb80\udc7d",
                "\udb80\udc7e",
                "\udb80\udc7f",
                "\udb80\udc80",
                "\udb80\udc81",
                "\udb80\udc82",
                "\udb80\udc79"
            ]
        },
        "format-full": "BAT FULL",
        "tooltip-format-discharging": "{power:>1.0f}W\u2193 {capacity}%\n{timeTo}",
        "tooltip-format-charging": "{power:>1.0f}W\u2191 {capacity}%\n{timeTo}",
        "interval": 5,
        "on-click": "omarchy-menu power",
        "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "BL {percent}%",
        "tooltip": true,
        "tooltip-format": "Brightness: \uf111 {percent}%",
        "format-alt": "{icon}",
        "format-alt-click": "click-right",
        "format-icons": [
            "\udb80\udcdc",
            "\udb80\udcdd",
            "\udb80\udcde",
            "\udb80\udcdf",
            "\udb80\udce0"
        ],
        "on-scroll-down": "brightnessctl s 5%-",
        "on-scroll-up": "brightnessctl s +5%"
    },
    "clock": {
        "format": "{:%A %H:%M\u2004%p}",
        "interval": 60,
        "tooltip-format": "<span>{calendar}</span>",
        "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 2,
            "format": {
                "month": "<span color='#f6c177'><b>{}</b></span>",
                "weekdays": "<span color='#c4a7e7'><b>{}</b></span>",
                "today": "<span color='#eb6f92'><b>{}</b></span>"
            }
        }
    },
    "ext/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-direction": "true"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus",
        "tooltip-format": "{title} ({app_id})",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize",
        "all-outputs": true
    },
    "custom/power": {
        "format": "\u23fb",
        "tooltip": true,
        "tooltip-format": "Shutdown Menu",
        "on-click": "$HOME/.local/bin/shutdown.sh"
    },
    "custom/nightlight": {
        "format": "\udb80\udcdb",
        "tooltip": true,
        "tooltip-format": "Toggle Night Light",
        "on-click": "$HOME/.local/bin/nightlight_toggle.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "\udb80\udc9a<span foreground='#e6e6e6'><sup></sup></span>",
            "none": "\udb80\udc9a",
            "dnd-notification": "<span foreground='#e6e6e6'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "\udb80\udc9a<span foreground='#e6e6e6'><sup></sup></span>",
            "inhibited-none": "\udb80\udc9a",
            "dnd-inhibited-notification": "\udb80\udc9b<span foreground='#e6e6e6'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "temperature": {
        "interval": 2,
        "format": "\uf2c9 {temperatureC}\u00b0C",
        "tooltip": true
    }
}