{
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "top",
    "spacing": 0,
    "height": 0,
    "width": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "modules-center": [
        "clock",
        "custom/separator",
        "custom/notification",
        "tray",
        "ext/workspaces",
        "group/center"
    ],
    "group/center": {
        "orientation": "inherit",
        "modules": [
            "mpris",
            "backlight",
            "bluetooth",
            "network",
            "pulseaudio",
            "battery",
            "memory",
            "cpu"
        ]
    },
    "custom/separator": {
        "format": "|",
        "tooltip": false
    },
    "cpu": {
        "interval": 2,
        "format": "<span size='10pt'>\uec19</span> {icon} {usage}%",
        "on-click": "/home/peng/.local/bin/tui-popup task",
        "format-icons": [
            "<span size='8pt'>\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt'>\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#ff79d2'>\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#ff6fbe'>\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#ff66a9'>\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#ff5f94'>\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#ff5b7e'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#fe5968'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#f65a52'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501</span>",
            "<span size='8pt' color='#ec5d3c'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501</span>",
            "<span size='8pt' color='#df6124'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0</span>"
        ]
    },
    "memory": {
        "interval": 2,
        "format": "<span size='9pt'>\ue266</span> {icon} {used:0.1f}G",
        "on-click": "/home/peng/.local/bin/tui-popup ram",
        "format-icons": [
            "<span size='8pt'>\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt'>\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#f7b69a'>\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#ef9875'>\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#e77b50'>\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#df6124'>\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#d35720'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#c64e1c'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501</span>",
            "<span size='8pt' color='#aa4318'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501</span>",
            "<span size='8pt' color='#8e3813'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501</span>",
            "<span size='8pt' color='#722d0f'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0</span>"
        ]
    },
    "clock": {
        "format": "{:%H:%M - %a, %d}",
        "format-alt": "{:L%d %B W%V %Y}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#e6e6e6'><b>{}</b></span>",
                "weekdays": "<span color='#e6e6e6'><b>{}</b></span>",
                "today": "<span color='#e6e6e6'><b>{}</b></span>"
            }
        },
        "on-click-right": "mode"
    },
    "network": {
        "format-icons": [
            "\udb82\udd2f",
            "\udb82\udd1f",
            "\udb82\udd22",
            "\udb82\udd25",
            "\udb82\udd28"
        ],
        "format": "{icon}",
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "\udb80\ude00 {bandwidthDownBytes:=}",
        "format-disconnected": "\udb82\udd2e",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
        "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "/home/peng/.local/bin/tui-popup wifi"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-plugged": "\uf1e6",
        "format-icons": {
            "charging": [
                "\udb82\udc9c <span size='8pt' color='#df6124'>\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb82\udc9c <span size='8pt' color='#df6124'>\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc86 <span size='8pt' color='#dd7006'>\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc87 <span size='8pt' color='#d88000'>\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc88 <span size='8pt' color='#d09000'>\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb82\udc9d <span size='8pt' color='#c5a000'>\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc89 <span size='8pt' color='#b5af00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501</span>",
                "\udb82\udc9e <span size='8pt' color='#a2be00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501</span>",
                "\udb80\udc8a <span size='8pt' color='#8acc00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501</span>",
                "\udb80\udc8b <span size='8pt' color='#68da00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501</span>",
                "\udb80\udc85 <span size='8pt' color='#25e712'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0</span>"
            ],
            "default": [
                "\udb80\udc7a <span size='8pt' color='#df6124'>\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc7a <span size='8pt' color='#df6124'>\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc7b <span size='8pt' color='#dd7006'>\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc7c <span size='8pt' color='#d88000'>\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc7d <span size='8pt' color='#d09000'>\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc7e <span size='8pt' color='#c5a000'>\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc7f <span size='8pt' color='#b5af00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501\u2501</span>",
                "\udb80\udc80 <span size='8pt' color='#a2be00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501\u2501</span>",
                "\udb80\udc81 <span size='8pt' color='#8acc00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501\u2501</span>",
                "\udb80\udc82 <span size='8pt' color='#68da00'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u2501</span>",
                "\udb80\udc79 <span size='8pt' color='#25e712'>\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0\u25a0</span>"
            ]
        },
        "format-full": "\udb80\udc85",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "on-click": "/home/peng/.local/bin/tui-popup setting",
        "on-click-right": "notify-send -u low 'Battery Status' \"$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || cat /sys/class/power_supply/BAT1/status 2>/dev/null || echo Normal): $(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || cat /sys/class/power_supply/BAT1/capacity 2>/dev/null || echo 100)%\"",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "\uf294 {status} {num_connections}",
        "format-off": "\udb80\udcb2 OFF",
        "format-disabled": "\udb80\udcb2 {status}",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "/home/peng/.local/bin/tui-popup bluetooth"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "on-click": "/home/peng/.local/bin/tui-popup audio",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "\ueee8",
        "format-icons": {
            "headphone": "\uf025",
            "headset": "\uf025",
            "default": [
                "\uf026",
                "\uf027",
                "\uf028"
            ]
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "rotate": 0,
        "format": "{icon} {percent}%",
        "tooltip-format": "\ud83c\udf15 {percent}%",
        "format-icons": [
            "\udb80\udcdc",
            "\udb80\udcdd",
            "\udb80\udcde",
            "\udb80\udcdf",
            "\udb80\udce0"
        ]
    },
    "tray": {
        "icon-size": 12,
        "spacing": 5
    },
    "mpris": {
        "format": "<span size='9pt'>\uec1b</span>",
        "format-paused": "<span size='9pt'>{status_icon}</span>",
        "max-length": 5,
        "player-icons": {
            "default": "\u23f8",
            "mpv": "\ud83c\udfb5"
        },
        "status-icons": {
            "paused": "\udb81\udf5b"
        },
        "ignored-players": [
            "firefox",
            "chromium",
            "brave"
        ]
    },
    "ext/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-direction": "true"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus",
        "tooltip-format": "{title} ({app_id})",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize",
        "all-outputs": true
    },
    "custom/menu": {
        "format": "\udb82\udfaf",
        "tooltip": true,
        "tooltip-format": "Application Menu",
        "on-click": "/home/peng/.local/bin/tui-popup s"
    },
    "custom/power": {
        "format": "\u23fb",
        "tooltip": true,
        "tooltip-format": "Shutdown Menu",
        "on-click": "$HOME/.local/bin/shutdown.sh"
    },
    "custom/nightlight": {
        "format": "\udb80\udcdb",
        "tooltip": true,
        "tooltip-format": "Toggle Night Light",
        "on-click": "$HOME/.local/bin/nightlight_toggle.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "\udb80\udc9a<span foreground='#e6e6e6'><sup></sup></span>",
            "none": "\udb80\udc9a",
            "dnd-notification": "<span foreground='#e6e6e6'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "\udb80\udc9a<span foreground='#e6e6e6'><sup></sup></span>",
            "inhibited-none": "\udb80\udc9a",
            "dnd-inhibited-notification": "\udb80\udc9b<span foreground='#e6e6e6'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "temperature": {
        "interval": 2,
        "format": "\uf2c9 {temperatureC}\u00b0C",
        "tooltip": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb83\udfaa"
        }
    },
    "layer": "top"
}