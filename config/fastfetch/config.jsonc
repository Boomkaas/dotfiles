{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // White/gray NixOS logo
  "logo": {
    "type": "auto",
    "color": {
      "1": "white",
      "2": "light_black",
      "3": "white",
      "4": "light_black",
      "5": "white",
      "6": "light_black"
    }
  },

  "display": {
    "color": "white"
  },

  // Every built-in module except Monitor (duplicate of Display) and
  // Command/Custom (need arguments to be useful).
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "chassis",
    "board",
    "bios",
    "bootmgr",
    "kernel",
    "initsystem",
    "uptime",
    "datetime",
    "loadavg",
    "processes",
    "users",
    "packages",
    "shell",
    "editor",
    "terminal",
    "terminalfont",
    "terminalsize",
    "terminaltheme",
    "wm",
    "wmtheme",
    "de",
    "lm",
    "theme",
    "icons",
    "font",
    "cursor",
    "wallpaper",
    "display",
    "brightness",
    "gpu",
    "opengl",
    "opencl",
    "vulkan",
    "cpu",
    "cpuusage",
    "cpucache",
    "memory",
    "swap",
    "disk",
    "physicaldisk",
    "physicalmemory",
    "diskio",
    "btrfs",
    "zpool",
    "sound",
    "media",
    "player",
    "camera",
    "keyboard",
    "mouse",
    "gamepad",
    "bluetooth",
    "bluetoothradio",
    "battery",
    "poweradapter",
    "tpm",
    "locale",
    "dns",
    "localip",
    "wifi",
    "netio",
    "publicip",
    "weather",
    "colors",
    "break",
    "version"
  ]
}
