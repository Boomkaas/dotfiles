{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "control-center-margin-top": 20,
    "control-center-margin-bottom": 20,
    "control-center-margin-right": 20,
    "control-center-margin-left": 20,
    "notification-icon-size": 56,
    "notification-body-image-height": 200,
    "notification-body-image-width": 200,

    "timeout": 4,
    "timeout-low": 2,
    "timeout-critical": 0,

    "fit-to-screen": true,
    "control-center-width": 420,
    "notification-window-width": 500,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 250,

    "hide-on-clear": false,
    "hide-on-action": true,
    
    "widgets": [
        "title",
        "buttons-grid",
        "volume",
        "backlight",
        "mpris",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Control Center",
            "clear-all-button": true,
            "button-text": "Clear All"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "volume": {
            "label": "󰕾",
            "show-per-app": false
        },
        "backlight": {
            "label": "󰃠",
            "device": "auto",
            "sub-cs": "backlight"
        },
        "mpris": {
            "image-size": 75,
            "image-radius": 12
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰖩 WiFi",
                    "type": "toggle",
                    "active": true,
                    "command": "nmcli radio wifi on",
                    "command-off": "nmcli radio wifi off",
                    "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = \"enabled\" ] && echo true || echo false'"
                },
                {
                    "label": "󰂯 Bluetooth",
                    "type": "toggle",
                    "active": true,
                    "command": "bluetoothctl power on",
                    "command-off": "bluetoothctl power off",
                    "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
                },
                {
                    "label": "󰖔 Night Light",
                    "type": "toggle",
                    "active": false,
                    "command": "/home/peng/.local/bin/nightlight_toggle.sh",
                    "command-off": "/home/peng/.local/bin/nightlight_toggle.sh",
                    "update-command": "sh -c '/home/peng/.local/bin/nightlight_toggle.sh --check >/dev/null 2>&1 && echo true || echo false'"
                },
                {
                    "label": "󰍃 Lock",
                    "command": "/home/peng/.local/bin/lock.sh"
                }
            ]
        },
        "notifications": {
        }
    }
}