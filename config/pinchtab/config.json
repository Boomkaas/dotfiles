{
  "$schema": "https://raw.githubusercontent.com/pinchtab/pinchtab/main/schema/config.json",
  "configVersion": "0.8.0",
  "server": {
    "token": "83d008f2ab0b714a508d942a8118de40"
  },
  "browsers": {
    "default": "ghost-chrome"
  },
  "browser": {
    "extraFlags": "--disable-gpu"
  },
  "instanceDefaults": {
    "mode": "headless",
    "blockImages": true,
    "blockMedia": true,
    "blockAds": true,
    "noAnimations": true,
    "maxTabs": 3
  },
  "security": {
    "allowedDomains": ["*"],
    "idpi": {
      "strictMode": false
    }
  }
}
